---
/**
 * 메인 첫 화면의 전체 품목 시세 (84개). 모두 사진 카드로 보여 주고 분류 탭으로 나눠 본다.
 * 글자만 줄줄이 늘어놓으면 어르신이 보기 힘들다 (사용자 지적 2026-10-19). 서버에서 모두 그린다.
 */
import { ITEMS, REGIONS, buildAnalysis, getItemStatus, getPriceAsOfDate } from '@/data/prices'
import { SEARCH_NAME_KO } from '@/data/prices'
import PriceBoard from '@/components/PriceBoard'
import kamisItems from '@/data/kamis-items.json'

type Props = { isEn?: boolean; prefix?: string }
const { isEn = false, prefix = '' } = Astro.props

const today = getPriceAsOfDate()

// KAMIS 부류 코드 첫 자리. 김장철을 앞두고 채소를 먼저 둔다.
const CATS = isEn
	? [
			['200', 'Vegetables'],
			['100', 'Grains and beans'],
			['300', 'Special crops'],
			['400', 'Fruit']
		]
	: [
			['200', '채소'],
			['100', '쌀·콩·감자'],
			['300', '깨·땅콩·버섯'],
			['400', '과일']
		]
const catOf = (id: string) =>
	((kamisItems as Record<string, { codes: string[] }>)[id]?.codes[0] ?? '').split('-')[0]

// 분류 안에서는 지금 조사되는 품목 먼저, 이름순
const surveyed = (id: string) => {
	const item = ITEMS.find((i) => i.id === id)!
	return !getItemStatus(item, today).stale && buildAnalysis(item, REGIONS[0], today).current != null
}
const nameOf = (id: string) => {
	const item = ITEMS.find((i) => i.id === id)!
	return isEn ? item.en : (SEARCH_NAME_KO[item.id] ?? item.ko)
}
const groups = CATS.map(([code, label]) => {
	const ids = ITEMS.map((i) => i.id).filter((id) => catOf(id) === code)
	const ok = new Map(ids.map((id) => [id, surveyed(id)]))
	return {
		code,
		label,
		ids: ids.sort(
			(a, b) =>
				Number(!ok.get(a)) - Number(!ok.get(b)) ||
				nameOf(a).localeCompare(nameOf(b), isEn ? 'en' : 'ko')
		)
	}
}).filter((g) => g.ids.length)
---

<div class='im-plist' data-plist>
	<nav class='im-plist-tabs' aria-label={isEn ? 'Categories' : '분류'}>
		<button type='button' data-cat='all' aria-pressed='true'>
			{isEn ? 'All' : '전체'}
			<span>{ITEMS.length}</span>
		</button>
		{
			groups.map((g) => (
				<button type='button' data-cat={g.code} aria-pressed='false'>
					{g.label} <span>{g.ids.length}</span>
				</button>
			))
		}
	</nav>

	{
		groups.map((g) => (
			<section class='im-plist-group' data-group={g.code}>
				<h3>{g.label}</h3>
				<PriceBoard ids={g.ids} isEn={isEn} prefix={prefix} />
			</section>
		))
	}
</div>

<script is:inline>
	function initPriceList() {
		document.querySelectorAll('[data-plist]').forEach((box) => {
			if (box.dataset.bound === 'true') return
			box.dataset.bound = 'true'
			const tabs = box.querySelectorAll('.im-plist-tabs button')
			tabs.forEach((tab) =>
				tab.addEventListener('click', () => {
					const cat = tab.dataset.cat
					tabs.forEach((t) => t.setAttribute('aria-pressed', String(t === tab)))
					box.querySelectorAll('[data-group]').forEach((g) => {
						g.hidden = cat !== 'all' && g.dataset.group !== cat
					})
					// 아래로 많이 내려온 뒤 탭을 누르면 고른 분류의 처음으로 올려 준다
					const nav = box.querySelector('.im-plist-tabs')
					if (nav.getBoundingClientRect().top <= 1)
						box.scrollIntoView({ behavior: 'smooth', block: 'start' })
				})
			)
		})
	}
	if (document.readyState === 'loading')
		document.addEventListener('DOMContentLoaded', initPriceList)
	else initPriceList()
	document.addEventListener('astro:page-load', initPriceList)
</script>

<style>
	/* 손가락으로 누르기 쉽게 큰 글자, 넉넉한 간격 */
	/* 목록이 길어서 탭은 화면 위에 붙어 따라온다 (어디서든 분류를 바꿀 수 있게) */
	.im-plist-tabs {
		position: sticky;
		top: 0;
		z-index: 4;
		padding: 10px 0;
		background: var(--bg);
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 10px clamp(18px, 2.4vw, 36px);
		margin-bottom: clamp(28px, 3.4vw, 48px);
	}

	/* 휴대폰에서는 탭을 한 줄로 두고 옆으로 밀어 본다 (두 줄이면 화면을 너무 가린다) */
	@media (max-width: 760px) {
		.im-plist-tabs {
			flex-wrap: nowrap;
			justify-content: flex-start;
			gap: 20px;
			margin-inline: calc(var(--gutter) * -1);
			padding-inline: var(--gutter);
			overflow-x: auto;
			scrollbar-width: none;
		}

		.im-plist-tabs::-webkit-scrollbar {
			display: none;
		}

		.im-plist-tabs button {
			flex: none;
		}
	}

	.im-plist-tabs button {
		white-space: nowrap;
		padding: 6px 0;
		border: 0;
		border-bottom: 2px solid transparent;
		background: none;
		color: var(--muted);
		font: inherit;
		font-size: 17px;
		font-weight: 700;
		cursor: pointer;
	}

	.im-plist-tabs button span {
		font-size: 13px;
		font-weight: 500;
	}

	.im-plist-tabs button[aria-pressed='true'] {
		color: var(--ink);
		border-bottom-color: var(--ink);
	}

	.im-plist-group {
		margin-bottom: clamp(48px, 6vw, 80px);
	}

	.im-plist-group h3 {
		margin: 0 0 clamp(18px, 2vw, 28px);
		padding-bottom: 10px;
		border-bottom: 1px solid var(--ink);
		font-size: 20px;
		font-weight: 800;
	}
</style>
