---
/**
 * 쿠팡 파트너스 다이나믹 배너 (고객 관심 기반 추천: 보는 사람이 쿠팡에서 본·담은 상품을 보여 준다).
 * 파트너스에서 2026-10-04 만든 배너 코드의 설정값을 그대로 쓴다. 바꾸지 않는다.
 *   PC   imunfarm-prices-pc     id 1035870, 680 x 140
 *   모바일 imunfarm-prices-mobile id 1035872, 320 x 100
 * 화면 폭에 맞는 배너 하나만 불러온다 (g.js 의 container 옵션). 한국어 페이지에서만 쓴다.
 */
const PC = {
	id: 1035870,
	template: 'carousel',
	trackingCode: 'AF3621123',
	subId: 'imunfarm',
	width: '680',
	height: '140',
	tsource: ''
}
const MOBILE = {
	id: 1035872,
	template: 'carousel',
	trackingCode: 'AF3621123',
	subId: 'imunfarm',
	width: '320',
	height: '100',
	tsource: ''
}
---

<aside class='im-cdyn' aria-label='광고'>
	<p class='im-cdyn-note'>
		광고 · 이 영역은 쿠팡 파트너스 활동의 일환으로, 이에 따른 일정액의 수수료를 제공받습니다.
	</p>
	<div class='im-cdyn-slot' data-pc={JSON.stringify(PC)} data-mobile={JSON.stringify(MOBILE)}></div>
</aside>

<script>
	declare global {
		interface Window {
			PartnersCoupang?: { G: new (options: Record<string, unknown>) => unknown }
		}
	}

	let loading: Promise<void> | null = null
	const loadScript = () =>
		(loading ??= new Promise<void>((resolve, reject) => {
			if (window.PartnersCoupang) return resolve()
			const s = document.createElement('script')
			s.src = 'https://ads-partners.coupang.com/g.js'
			s.async = true
			s.onload = () => resolve()
			s.onerror = () => reject(new Error('coupang g.js'))
			document.head.appendChild(s)
		}))

	async function mount() {
		const slots = Array.from(
			document.querySelectorAll<HTMLElement>('.im-cdyn-slot:not([data-done])')
		)
		if (!slots.length) return
		try {
			await loadScript()
		} catch {
			slots.forEach((slot) => slot.closest<HTMLElement>('.im-cdyn')?.setAttribute('hidden', ''))
			return
		}
		const wide = window.matchMedia('(min-width: 720px)').matches
		slots.forEach((slot) => {
			slot.dataset.done = '1'
			const options = JSON.parse((wide ? slot.dataset.pc : slot.dataset.mobile) || '{}')
			new window.PartnersCoupang!.G({ ...options, container: slot })
		})
	}

	mount()
	document.addEventListener('astro:page-load', mount)
</script>

<style>
	.im-cdyn {
		margin: clamp(22px, 3vw, 34px) 0;
		padding-top: 10px;
		border-top: 1px solid var(--line);
	}

	.im-cdyn[hidden] {
		display: none;
	}

	.im-cdyn-note {
		margin: 0 0 10px;
		color: var(--muted);
		font-size: 11px;
		line-height: 1.5;
	}

	.im-cdyn-slot {
		display: flex;
		justify-content: center;
		min-height: 100px;
		overflow: hidden;
	}

	@media (min-width: 720px) {
		.im-cdyn-slot {
			min-height: 140px;
		}
	}

	.im-cdyn-slot :global(iframe) {
		display: block;
		max-width: 100%;
	}
</style>
