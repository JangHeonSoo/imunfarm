---
const { page } = Astro.props
---

<nav class='im-pagination im-menu' aria-label='Pagination'>
	{page.url.prev ? <a href={page.url.prev}>Prev</a> : <span>Prev</span>}
	<span class='im-pagination-count'>
		{String(page.currentPage).padStart(2, '0')} / {String(page.lastPage).padStart(2, '0')}
	</span>
	{page.url.next ? <a href={page.url.next}>Next</a> : <span>Next</span>}
</nav>

<style>
	.im-pagination {
		display: flex;
		align-items: center;
		gap: clamp(14px, 2vw, 28px);
		padding-top: clamp(28px, 4vh, 54px);
		border-top: 1px solid var(--line);
		margin-top: clamp(28px, 4vh, 54px);
	}

	.im-pagination span {
		color: var(--muted);
	}

	.im-pagination-count {
		margin-left: auto;
		font-weight: 500;
		font-variant-numeric: tabular-nums;
	}
</style>
