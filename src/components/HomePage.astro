---
import BaseLayout from '@/layouts/BaseLayout'
import {
	DEFAULT_LOCALE,
	getCategorySlug,
	getCategoryTitleFromSlug,
	getLocalePrefix,
	getPostUrl,
	getPosts
} from '@/utils'
import PriceBoard from '@/components/PriceBoard'
import { ITEMS, formatDate, getPriceAsOfDate, buildPriceData } from '@/data/prices'
import { POPULAR_PRICE_IDS } from '@/data/price-popular'

const { locale = DEFAULT_LOCALE } = Astro.props
const isEn = locale === 'en'
const prefix = getLocalePrefix(locale)

const allPosts = await getPosts(undefined, locale)
const posts = allPosts.slice(0, 24)

const counts = new Map<string, number>()
allPosts.forEach((post) => {
	const slug = getCategorySlug(post.data.category)
	counts.set(slug, (counts.get(slug) ?? 0) + 1)
})
// 글이 많은 분류 4개 + 새로 넓힌 생활 분야는 글이 있으면 항상 보인다
const PINNED = ['seasonal-notes', 'gardening', 'country-life']
const top = Array.from(counts.entries())
	.sort((a, b) => b[1] - a[1])
	.map(([slug]) => slug)
	.filter((slug) => !PINNED.includes(slug))
	.slice(0, 4)
const categories = [...top, ...PINNED.filter((slug) => counts.has(slug))].map((slug) => ({
	slug,
	label: getCategoryTitleFromSlug(slug, locale)
}))

// 사람들은 시세를 찾아 들어온다 (2026-10-19 서치어드바이저 검색어 TOP 10이 모두 시세). 메인 첫 화면은 시세가 먼저다.
const { dates } = buildPriceData(getPriceAsOfDate())
const priceDate = formatDate(dates[dates.length - 1])
const priceIndex = ITEMS.map((item) => ({
	id: item.id,
	n: isEn ? item.en : item.ko,
	k: (isEn ? item.keywordsEn : item.keywordsKo).join(' ')
}))

const RATIOS = ['4 / 3', '3 / 4', '1 / 1', '4 / 5', '16 / 10', '5 / 4', '3 / 2', '4 / 3']
---

<BaseLayout title='Home' locale={locale} active='home'>
	<section class='im-front im-pad'>
		<div class='im-front-head'>
			<p class='im-front-kicker'>Today’s Prices</p>
			<h1>{isEn ? 'Korean produce prices today' : '오늘 농산물 시세'}</h1>
			<p class='im-meta'>
				{
					isEn
						? `KAMIS wholesale, Seoul · surveyed ${priceDate} · ${ITEMS.length} items`
						: `서울 도매시장 중도매인 판매가 · ${priceDate} 조사 · ${ITEMS.length}개 품목`
				}
			</p>
		</div>

		<div class='im-search-wrap'>
			<div class='im-search'>
				<input
					id='im-search-input'
					type='search'
					autocomplete='off'
					placeholder='SEARCH'
					aria-label={isEn ? 'Search prices and posts' : '시세·글 검색'}
					data-action={`${prefix}/search/`}
					data-prefix={prefix}
				/>
			</div>
			<ul id='im-search-hits' class='im-search-hits' hidden></ul>
			<script type='application/json' id='im-price-index' set:html={JSON.stringify(priceIndex)} />
		</div>

		<PriceBoard ids={POPULAR_PRICE_IDS} isEn={isEn} prefix={prefix} />
		<div class='im-front-more'>
			<a class='im-front-all' href={`${prefix}/prices/`}>
				{isEn ? `All ${ITEMS.length} items →` : `전체 ${ITEMS.length}개 품목 시세 보기 →`}
			</a>
		</div>
	</section>

	<div class='im-posts-head im-pad'>
		<p class='im-front-kicker'>Notes</p>
		<h2>{isEn ? 'Notes from the farm' : '농사 기록'}</h2>
	</div>

	<nav class='im-filters im-pad'>
		<a class='im-tab' href={`${prefix}/blog/`} aria-current='true'>{isEn ? 'All' : '전체'}</a>
		{
			categories.map((category) => (
				<a class='im-tab' href={`${prefix}/${category.slug}/1`}>
					{category.label}
				</a>
			))
		}
	</nav>

	<div class='im-grid-home im-pad im-bottom'>
		{
			posts.map((post, index) => (
				<a class='im-card' href={getPostUrl(post.slug, locale, post.data.category)}>
					{post.data.heroImage && (
						<img
							src={
								typeof post.data.heroImage === 'string'
									? post.data.heroImage
									: post.data.heroImage.src
							}
							alt={post.data.title}
							loading={index < 4 ? 'eager' : 'lazy'}
							style={`aspect-ratio:${RATIOS[index % RATIOS.length]}`}
						/>
					)}
					<span class='im-card-meta'>{post.data.title}</span>
				</a>
			))
		}
	</div>
</BaseLayout>

<script is:inline>
	function initHomeSearch() {
		const input = document.getElementById('im-search-input')
		const hits = document.getElementById('im-search-hits')
		if (!input || input.dataset.bound === 'true') return
		input.dataset.bound = 'true'
		let index = []
		try {
			index = JSON.parse(document.getElementById('im-price-index').textContent)
		} catch {}
		const norm = (v) => v.toLowerCase().replace(/\s+/g, '')
		const match = (q) => {
			const n = norm(q)
			if (!n) return []
			return index
				.filter((it) => norm(it.n).includes(n) || norm(it.k).includes(n))
				.sort((a, b) => norm(a.n).indexOf(n) - norm(b.n).indexOf(n))
				.slice(0, 6)
		}
		const render = () => {
			const list = match(input.value.trim())
			hits.innerHTML = ''
			list.forEach((it) => {
				const li = document.createElement('li')
				const a = document.createElement('a')
				a.href = input.dataset.prefix + '/prices/' + it.id + '/'
				a.textContent = it.n
				const s = document.createElement('span')
				s.textContent = document.documentElement.lang === 'en' ? 'Price →' : '시세 →'
				a.append(s)
				li.append(a)
				hits.append(li)
			})
			hits.hidden = list.length === 0
		}
		input.addEventListener('input', render)
		input.addEventListener('keydown', (event) => {
			if (event.key !== 'Enter') return
			event.preventDefault()
			const query = input.value.trim()
			if (!query) return
			const list = match(query)
			// 품목 이름과 바로 맞으면 시세 페이지로, 아니면 글 검색
			if (list.length && norm(list[0].n).startsWith(norm(query))) {
				window.location.href = input.dataset.prefix + '/prices/' + list[0].id + '/'
				return
			}
			window.location.href = input.dataset.action + '?q=' + encodeURIComponent(query)
		})
	}
	if (document.readyState === 'loading')
		document.addEventListener('DOMContentLoaded', initHomeSearch)
	else initHomeSearch()
	document.addEventListener('astro:page-load', initHomeSearch)
</script>

<style>
	.im-front {
		padding-top: clamp(28px, 4vw, 64px);
		padding-bottom: clamp(56px, 8vw, 120px);
	}

	.im-front-head,
	.im-posts-head {
		display: grid;
		justify-items: center;
		gap: 10px;
		text-align: center;
	}

	.im-front-kicker {
		margin: 0;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.im-front-head h1,
	.im-posts-head h2 {
		margin: 0;
		font-size: clamp(30px, 4.6vw, 60px);
		font-weight: 800;
		letter-spacing: -0.01em;
		line-height: 1.1;
	}

	.im-posts-head h2 {
		font-size: clamp(24px, 3vw, 40px);
	}

	.im-front-head p.im-meta {
		margin: 0;
	}

	.im-posts-head {
		padding-bottom: clamp(18px, 2.4vw, 32px);
		border-top: 1px solid var(--line);
		padding-top: clamp(48px, 6vw, 88px);
	}

	.im-front-more {
		display: flex;
		justify-content: center;
		margin-top: clamp(32px, 4vw, 56px);
	}

	.im-front-all {
		color: var(--ink);
		font-size: 14px;
		font-weight: 600;
		letter-spacing: 0.02em;
		padding-bottom: 3px;
		border-bottom: 1px solid var(--ink);
	}

	.im-search-wrap {
		position: relative;
	}

	.im-search {
		display: grid;
		place-items: center;
		padding: clamp(24px, 3vw, 44px) 0 clamp(32px, 4vw, 56px);
	}

	.im-search-hits {
		position: absolute;
		top: 100%;
		left: 50%;
		z-index: 5;
		width: min(560px, 100%);
		margin: 0;
		padding: 0;
		list-style: none;
		transform: translateX(-50%);
		background: var(--bg);
		border-top: 1px solid var(--ink);
	}

	.im-search-hits :global(a) {
		display: flex;
		justify-content: space-between;
		padding: 11px 4px;
		color: var(--ink);
		font-size: 16px;
		font-weight: 600;
		border-bottom: 1px solid var(--line);
	}

	.im-search-hits :global(a span) {
		color: var(--muted);
		font-size: 13px;
		font-weight: 500;
	}

	.im-search input {
		width: min(760px, 90vw);
		border: 0;
		background: none;
		padding: 0;
		outline: none;
		color: var(--ink);
		font-family: inherit;
		font-weight: 800;
		font-size: clamp(24px, 3.4vw, 44px);
		letter-spacing: 0.16em;
		text-align: center;
		text-transform: uppercase;
	}

	.im-search input::-webkit-search-cancel-button {
		display: none;
	}

	.im-filters {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: clamp(14px, 2vw, 32px);
		padding-bottom: clamp(14px, 1.6vw, 22px);
		font-size: 13px;
		font-weight: 500;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}
</style>
