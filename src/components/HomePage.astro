---
import BaseLayout from '@/layouts/BaseLayout'
import {
	DEFAULT_LOCALE,
	getCategorySlug,
	getCategoryTitleFromSlug,
	getLocalePrefix,
	getPostUrl,
	getPosts
} from '@/utils'

const { locale = DEFAULT_LOCALE } = Astro.props
const isEn = locale === 'en'
const prefix = getLocalePrefix(locale)

const allPosts = await getPosts(undefined, locale)
const posts = allPosts.slice(0, 24)

const counts = new Map<string, number>()
allPosts.forEach((post) => {
	const slug = getCategorySlug(post.data.category)
	counts.set(slug, (counts.get(slug) ?? 0) + 1)
})
const categories = Array.from(counts.entries())
	.sort((a, b) => b[1] - a[1])
	.slice(0, 4)
	.map(([slug]) => ({ slug, label: getCategoryTitleFromSlug(slug, locale) }))

const RATIOS = ['4 / 3', '3 / 4', '1 / 1', '4 / 5', '16 / 10', '5 / 4', '3 / 2', '4 / 3']
---

<BaseLayout title='Home' locale={locale} active='home'>
	<div class='im-search'>
		<input
			id='im-search-input'
			type='search'
			autocomplete='off'
			placeholder='SEARCH'
			aria-label={isEn ? 'Search posts' : '글 검색'}
			data-action={`${prefix}/search/`}
		/>
	</div>

	<nav class='im-filters im-pad'>
		<a class='im-tab' href={`${prefix}/blog/`} aria-current='true'>{isEn ? 'All' : '전체'}</a>
		{
			categories.map((category) => (
				<a class='im-tab' href={`${prefix}/${category.slug}/1`}>
					{category.label}
				</a>
			))
		}
	</nav>

	<div class='im-grid-home im-pad im-bottom'>
		{
			posts.map((post, index) => (
				<a class='im-card' href={getPostUrl(post.slug, locale, post.data.category)}>
					{post.data.heroImage && (
						<img
							src={
								typeof post.data.heroImage === 'string'
									? post.data.heroImage
									: post.data.heroImage.src
							}
							alt={post.data.title}
							loading={index < 4 ? 'eager' : 'lazy'}
							style={`aspect-ratio:${RATIOS[index % RATIOS.length]}`}
						/>
					)}
					<span class='im-card-meta'>{post.data.title}</span>
				</a>
			))
		}
	</div>
</BaseLayout>

<script is:inline>
	function initHomeSearch() {
		const input = document.getElementById('im-search-input')
		if (!input || input.dataset.bound === 'true') return
		input.dataset.bound = 'true'
		input.addEventListener('keydown', (event) => {
			if (event.key !== 'Enter') return
			event.preventDefault()
			const query = input.value.trim()
			if (!query) return
			window.location.href = input.dataset.action + '?q=' + encodeURIComponent(query)
		})
	}
	if (document.readyState === 'loading')
		document.addEventListener('DOMContentLoaded', initHomeSearch)
	else initHomeSearch()
	document.addEventListener('astro:page-load', initHomeSearch)
</script>

<style>
	.im-search {
		display: grid;
		place-items: center;
		height: clamp(140px, 24vh, 250px);
	}

	.im-search input {
		width: min(760px, 90vw);
		border: 0;
		background: none;
		padding: 0;
		outline: none;
		color: var(--ink);
		font-family: inherit;
		font-weight: 800;
		font-size: clamp(26px, 4.2vw, 54px);
		letter-spacing: 0.16em;
		text-align: center;
		text-transform: uppercase;
	}

	.im-search input::-webkit-search-cancel-button {
		display: none;
	}

	.im-filters {
		display: flex;
		flex-wrap: wrap;
		gap: clamp(14px, 2vw, 32px);
		padding-bottom: clamp(14px, 1.6vw, 22px);
		font-size: 13px;
		font-weight: 500;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}
</style>
