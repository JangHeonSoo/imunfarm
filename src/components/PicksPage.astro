---
import BaseLayout from '@/layouts/BaseLayout'
import { getPostUrl, getPosts } from '@/utils'
import { groupOf, groupsForMonth, parseAffiliateItems, toPolite, type Pick } from '@/data/picks'
import '../styles/tools.css'

const posts = await getPosts(undefined, 'ko')
const byUrl = new Map<string, Pick & { votes: Record<string, number> }>()
for (const post of posts) {
	const slug = post.slug.replace(/^ko\//, '')
	const group = groupOf(slug)
	const ref = {
		title: post.data.title,
		url: getPostUrl(post.slug, 'ko', post.data.category),
		date: post.data.pubDate?.valueOf() ?? 0
	}
	for (const item of parseAffiliateItems(post.body)) {
		const hit = byUrl.get(item.url)
		if (hit) {
			if (!hit.posts.some((p) => p.url === ref.url)) hit.posts.push(ref)
			hit.votes[group] = (hit.votes[group] ?? 0) + 1
			continue
		}
		byUrl.set(item.url, { ...item, group, posts: [ref], votes: { [group]: 1 } })
	}
}
const picks = [...byUrl.values()].map((p) => ({
	...p,
	group: Object.entries(p.votes).sort((a, b) => b[1] - a[1])[0][0],
	posts: p.posts.sort((a, b) => b.date - a.date)
}))

const month = Number(new Date(Date.now() + 9 * 3600 * 1000).toISOString().slice(5, 7))
const groups = groupsForMonth(month)
	.map((g) => ({
		...g,
		inSeason: (g.months as readonly number[]).includes(month),
		items: picks.filter((p) => p.group === g.id).sort((a, b) => b.posts.length - a.posts.length)
	}))
	.filter((g) => g.items.length > 0)

const title = '농가 추천 장비: 수확·건조·저온저장고·텃밭 도구 모음'
const description = `IMUN.FARM 글에서 직접 골라 소개한 농사 도구 ${picks.length}가지를 용도별로 모았습니다. 땅콩·들깨·팥 수확과 건조, 저온저장고 운영, 텃밭 월동, 농막 태양광, 아쿠아포닉스 장비.`
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: '농가 추천 장비',
	description,
	url: new URL('/picks/', Astro.site).href,
	hasPart: groups.map((g) => ({
		'@type': 'ItemList',
		name: g.title,
		numberOfItems: g.items.length,
		itemListElement: g.items.map((p, k) => ({ '@type': 'ListItem', position: k + 1, name: p.name }))
	}))
}
---

<BaseLayout title={title} description={description} locale='ko' active='picks' altPath={null}>
	<div class='im-tool im-picks'>
		<div class='im-picks-top'>
			<div>
				<h1>농가 추천 장비</h1>
				<p class='im-tool-lede'>
					글에서 작업에 맞춰 직접 골라 소개한 도구 {picks.length}가지입니다. 왜 필요한지와 어떤
					글에서 다뤘는지 함께 보여 드립니다.
				</p>
			</div>
			<p class='im-picks-disc'>
				이 페이지는 쿠팡 파트너스 활동의 일환으로, 이에 따른 일정액의 수수료를 제공받습니다.
			</p>
		</div>

		<section class='im-picks-search' aria-label='장비 검색'>
			<div class='im-search' role='search'>
				<input
					id='im-picks-q'
					type='search'
					autocomplete='off'
					placeholder='SEARCH'
					aria-label='추천 장비 검색'
					aria-describedby='im-picks-count'
				/>
			</div>
			<p class='im-picks-count' id='im-picks-count' aria-live='polite'></p>
			<div class='im-picks-coupang'>
				<p class='im-label'>쿠팡에서 바로 검색</p>
				<iframe
					src='https://coupa.ng/cpUhIX'
					width='100%'
					height='75'
					frameborder='0'
					scrolling='no'
					referrerpolicy='unsafe-url'
					title='쿠팡 상품 검색'></iframe>
			</div>
		</section>

		<nav class='im-picks-nav' aria-label='용도별 바로가기'>
			{
				groups.map((g) => (
					<a href={`#${g.id}`} data-group={g.id} class={g.inSeason ? 'is-season' : ''}>
						{g.title}
						<span>{g.items.length}</span>
					</a>
				))
			}
		</nav>

		{
			groups.map((g) => (
				<section class='im-picks-group' id={g.id}>
					<header>
						<h2>{g.title}</h2>
						{g.inSeason && <span class='im-picks-season'>{month}월에 많이 씁니다</span>}
						<p>{g.lede}</p>
					</header>
					<ul class='im-picks-list'>
						{g.items.map((p) => (
							<li
								class='im-pick'
								data-search={[p.name, p.reason, g.title, g.lede, ...p.posts.map((x) => x.title)]
									.join(' ')
									.toLowerCase()}
							>
								<a
									class='im-pick-media'
									href={p.url}
									target='_blank'
									rel='nofollow sponsored noopener'
									referrerpolicy='unsafe-url'
									tabindex='-1'
								>
									<img
										src={p.image}
										alt={p.imageAlt || p.name}
										width='120'
										height='240'
										loading='lazy'
									/>
								</a>
								<div class='im-pick-body'>
									<a
										class='im-pick-name'
										href={p.url}
										target='_blank'
										rel='nofollow sponsored noopener'
										referrerpolicy='unsafe-url'
									>
										{p.name}
									</a>
									<p class='im-pick-reason'>{toPolite(p.reason)}</p>
									<p class='im-pick-posts'>
										{p.posts.slice(0, 2).map((post) => (
											<a href={post.url}>{post.title}</a>
										))}
									</p>
									<a
										class='im-pick-cta'
										href={p.url}
										target='_blank'
										rel='nofollow sponsored noopener'
										referrerpolicy='unsafe-url'
									>
										쿠팡에서 보기 →
									</a>
								</div>
							</li>
						))}
					</ul>
				</section>
			))
		}

		<p class='im-picks-note' style='margin-top:36px'>
			가격과 재고는 쿠팡 상품 페이지에서 수시로 바뀝니다. 구매 전 옵션과 규격을 한 번 더 확인해
			주세요.
		</p>
	</div>
	<script type='application/ld+json' set:html={JSON.stringify(jsonLd)} />
</BaseLayout>

<script>
	const input = document.getElementById('im-picks-q') as HTMLInputElement
	const count = document.getElementById('im-picks-count')!
	const items = Array.from(document.querySelectorAll<HTMLElement>('.im-pick'))
	const groups = Array.from(document.querySelectorAll<HTMLElement>('.im-picks-group'))
	const chips = Array.from(document.querySelectorAll<HTMLElement>('.im-picks-nav [data-group]'))

	function apply() {
		const terms = input.value.trim().toLowerCase().split(/\s+/).filter(Boolean)
		let shown = 0
		items.forEach((li) => {
			const hit = terms.every((t) => (li.dataset.search || '').includes(t))
			li.hidden = !hit
			if (hit) shown++
		})
		groups.forEach((g) => {
			const any = g.querySelector('.im-pick:not([hidden])')
			g.hidden = !any
			chips.find((c) => c.dataset.group === g.id)?.toggleAttribute('hidden', !any)
		})
		count.textContent = !terms.length
			? ''
			: shown
				? `추천 장비 ${shown}개를 찾았습니다.`
				: '추천 장비에는 없는 상품입니다. 아래 쿠팡 검색에서 찾을 수 있습니다.'
		const u = new URL(location.href)
		if (terms.length) u.searchParams.set('q', input.value.trim())
		else u.searchParams.delete('q')
		history.replaceState(null, '', u)
	}

	input.addEventListener('input', apply)
	const q = new URLSearchParams(location.search).get('q')
	if (q) {
		input.value = q
		apply()
	}
</script>

<style>
	.im-picks {
		width: min(calc(1080px + 2 * var(--gutter)), 100%);
	}

	.im-picks .im-tool-lede {
		max-width: 760px;
	}

	.im-picks-note {
		margin: 0 0 18px;
		color: var(--muted);
		font-size: 12px;
		line-height: 1.6;
	}

	.im-picks-search {
		display: grid;
		gap: 10px;
		margin: 0 0 22px;
	}

	/* 메인·시세와 같은 검색 디자인 */
	.im-search {
		display: grid;
		place-items: center;
		height: clamp(120px, 20vh, 220px);
	}

	.im-search input {
		width: min(760px, 90vw);
		border: 0;
		background: none;
		padding: 0;
		outline: none;
		color: var(--ink);
		font-family: inherit;
		font-weight: 800;
		font-size: clamp(26px, 4.2vw, 54px);
		letter-spacing: 0.16em;
		text-align: center;
		text-transform: uppercase;
	}

	.im-search input::-webkit-search-cancel-button {
		display: none;
	}

	.im-picks-count {
		min-height: 1em;
		margin: -12px 0 8px;
		color: var(--muted);
		font-size: 13px;
		text-align: center;
	}

	.im-picks-coupang {
		display: grid;
		gap: 6px;
		width: min(760px, 100%);
		margin: 4px auto 0;
	}

	.im-picks-coupang .im-label {
		margin: 0;
	}

	.im-picks-coupang iframe {
		display: block;
		border: 0;
	}

	.im-picks-nav a[hidden],
	.im-picks-group[hidden],
	.im-pick[hidden] {
		display: none;
	}

	.im-picks-top {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 320px);
		gap: 0 56px;
		align-items: end;
	}

	.im-picks-disc {
		margin: 0 0 34px;
		padding-top: 12px;
		border-top: 1px solid var(--ink);
		color: var(--muted);
		font-size: 12px;
		line-height: 1.6;
	}

	.im-picks-nav {
		display: flex;
		flex-wrap: wrap;
		gap: 10px 22px;
		padding-top: 18px;
		border-top: 1px solid var(--line);
		font-size: 14px;
		font-weight: 600;
	}

	.im-picks-nav a {
		padding-bottom: 2px;
		border-bottom: 1px solid transparent;
	}

	.im-picks-nav a.is-season {
		border-bottom-color: var(--ink);
	}

	.im-picks-nav a:hover {
		border-bottom-color: var(--muted);
	}

	.im-picks-nav span {
		margin-left: 5px;
		color: var(--muted);
		font-weight: 500;
	}

	.im-picks-group {
		margin-top: 52px;
		padding-top: 14px;
		border-top: 1px solid var(--ink);
		scroll-margin-top: 20px;
	}

	.im-picks-group header {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 6px 16px;
		align-items: baseline;
	}

	.im-picks-group h2 {
		margin: 0;
		font-size: 24px;
		font-weight: 700;
		letter-spacing: -0.01em;
	}

	.im-picks-season {
		font-size: 13px;
		font-weight: 700;
	}

	.im-picks-group header p {
		grid-column: 1 / -1;
		margin: 0;
		color: var(--muted);
		font-size: 14px;
		line-height: 1.6;
	}

	.im-picks-list {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0 28px;
		margin: 18px 0 0;
		padding: 0;
		list-style: none;
	}

	.im-pick {
		display: grid;
		grid-template-rows: auto 1fr;
		padding: 0 0 26px;
		border-bottom: 1px solid var(--line);
	}

	.im-pick-media {
		display: flex;
		justify-content: center;
		padding: 4px 0 2px;
	}

	.im-pick-media img {
		display: block;
		width: 120px;
		height: auto;
	}

	.im-pick-body {
		display: grid;
		grid-template-rows: auto auto 1fr auto;
		gap: 6px;
		min-width: 0;
		margin-top: 12px;
	}

	.im-pick-name {
		font-size: 15px;
		font-weight: 700;
		line-height: 1.4;
	}

	.im-pick-name:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.im-pick-reason {
		display: -webkit-box;
		overflow: hidden;
		margin: 0;
		color: var(--muted);
		font-size: 13px;
		line-height: 1.6;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
	}

	.im-pick-posts {
		display: grid;
		align-content: end;
		gap: 2px;
		margin: 6px 0 0;
		font-size: 12px;
		line-height: 1.5;
	}

	.im-pick-posts a {
		overflow: hidden;
		color: var(--muted);
		text-overflow: ellipsis;
		white-space: nowrap;
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.im-pick-posts a:hover {
		color: var(--ink);
	}

	.im-pick-cta {
		justify-self: start;
		margin-top: 8px;
		font-size: 13px;
		font-weight: 700;
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.im-pick-cta:hover {
		text-decoration-thickness: 2px;
	}

	@media (max-width: 900px) {
		.im-picks-top {
			grid-template-columns: minmax(0, 1fr);
		}

		.im-picks-disc {
			margin-top: -14px;
		}

		.im-picks-list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0 16px;
		}
	}

	@media (max-width: 420px) {
		.im-pick-media img {
			width: 100px;
		}
	}
</style>
