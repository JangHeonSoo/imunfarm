<script is:inline>
	;(function () {
		// 기본은 항상 라이트. 하단 Dark 버튼을 누른 사람만 다크로 본다 (휴대폰 다크 설정은 따르지 않음)
		function getTheme() {
			try {
				if (localStorage.getItem('theme') === 'dark') return 'dark'
			} catch (e) {}
			return 'light'
		}

		function setTheme(theme, persist) {
			const html = document.documentElement
			const isDark = theme === 'dark'
			html.classList.toggle('dark', isDark)
			html.classList.toggle('light', !isDark)
			document
				.querySelectorAll('meta[name="theme-color"]')
				.forEach((meta) => meta.setAttribute('content', isDark ? '#0c0c0b' : '#faf8f6'))
			if (persist) {
				try {
					localStorage.setItem('theme', theme)
				} catch (e) {}
			}
		}

		setTheme(getTheme(), false)
		document.addEventListener('astro:after-swap', () => setTheme(getTheme(), false))
		document.addEventListener('theme-change', (e) => setTheme(e.detail.theme, true))
	})()
</script>
