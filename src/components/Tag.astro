---
import { DEFAULT_LOCALE, getLocalePrefix } from '@/utils'

export interface Props {
	tag: string
	locale?: string
}

const { tag, locale = DEFAULT_LOCALE } = Astro.props
const prefix = getLocalePrefix(locale)
---

<a class='im-tag' href={`${prefix}/tags/${tag.toLowerCase()}/`}>{tag}</a>

<style>
	.im-tag {
		display: inline-flex;
		border: 1px solid var(--line);
		padding: 6px 10px;
		color: var(--ink);
		font-size: 12px;
		font-weight: 500;
		letter-spacing: 0.02em;
	}

	.im-tag:hover {
		border-color: var(--ink);
		opacity: 1;
	}
</style>
