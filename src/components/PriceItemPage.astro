---
import BaseLayout from '@/layouts/BaseLayout'
import PriceAnalysis from '@/components/PriceAnalysis'
import PriceChart from '@/components/PriceChart'
import PriceSwitcher from '@/components/PriceSwitcher'
import CoupangDynamic from '@/components/CoupangDynamic'
import kamisItems from '@/data/kamis-items.json'
import { DEFAULT_LOCALE, getLocalePrefix, getPostUrl, getPosts } from '@/utils'
import {
	ITEMS,
	REGIONS,
	buildAnalysis,
	buildItemSeries,
	buildPriceData,
	formatDate,
	getItemStatus,
	getPriceAsOfDate
} from '@/data/prices'
import { siteConfig } from '@/site-config'
import pricePhotos from '@/data/price-photos.json'

const { locale = DEFAULT_LOCALE, itemId } = Astro.props
const isEn = locale === 'en'
const prefix = getLocalePrefix(locale)

const item = ITEMS.find((entry) => entry.id === itemId)!
const name = isEn ? item.en : item.ko
const unit = isEn ? item.unitEn : item.unitKo
const grade = isEn ? item.gradeEn : item.gradeKo

const today = getPriceAsOfDate()
const { dates, table } = buildPriceData(today)
const latest = dates[dates.length - 1]
const analysis = buildAnalysis(item, REGIONS[0], today)
const status = getItemStatus(item, today)
const photo = (pricePhotos as string[]).includes(item.id) ? `/images/prices/${item.id}.webp` : null

const fmt = (value: number | null) =>
	value == null
		? '–'
		: isEn
			? '₩' + value.toLocaleString('en-US')
			: value.toLocaleString('ko-KR') + '원'
const pct = (v: number | null) =>
	v == null ? '–' : (v > 0 ? '+' : v < 0 ? '−' : '') + Math.abs(v).toFixed(1) + '%'
const dir = (v: number | null) =>
	v == null ? 'im-flat' : v > 0 ? 'im-up' : v < 0 ? 'im-down' : 'im-flat'

const regionRows = REGIONS.map((region) => ({
	label: isEn ? region.en : region.ko,
	...table[latest][region.id][item.id]
})).sort((a, b) => (b.price ?? -1) - (a.price ?? -1))

// 관련 기록
const posts = await getPosts(undefined, locale)
const needles = [
	name.toLowerCase(),
	...(isEn ? item.keywordsEn : item.keywordsKo).map((k) => k.toLowerCase())
]
const related = posts
	.filter((post) => {
		const haystack =
			`${post.data.title} ${post.data.description ?? ''} ${(post.data.tags ?? []).join(' ')}`.toLowerCase()
		return needles.some((needle) => haystack.includes(needle.split(' ')[0]))
	})
	.slice(0, 4)

const codeOf = (id: string) =>
	((kamisItems as Record<string, { codes: string[] }>)[id]?.codes[0] ?? '').split('-')
const switchItems = ITEMS.map((entry) => {
	const cell = table[latest][REGIONS[0].id][entry.id]
	return {
		id: entry.id,
		label: isEn ? entry.en : entry.ko,
		category: codeOf(entry.id)[0] ?? '',
		unit: isEn ? entry.unitEn : entry.unitKo,
		price: cell?.price ?? null,
		delta: cell?.delta ?? null,
		photo: (pricePhotos as string[]).includes(entry.id)
			? `/images/prices/thumb/${entry.id}.webp`
			: null,
		search: [entry.id, entry.ko, entry.en, ...entry.keywordsKo, ...entry.keywordsEn]
			.join(' ')
			.toLowerCase()
	}
})
// 같이 보는 품목: 같은 작물의 다른 품종·국산/수입 → 같은 분류 순
const [myCat, myItem] = codeOf(item.id)
const siblings = switchItems.filter((e) => e.id !== item.id && codeOf(e.id)[1] === myItem)
// 가까운 작물끼리 묶은 무리 (KAMIS 품목 코드)
const GROUPS = [
	['111', '112', '115', '121'],
	['141', '142', '143', '144'],
	['151', '152'],
	['312', '313', '314'],
	['315', '316', '317'],
	['211', '212', '213', '214', '215', '233', '252', '253', '279', '280'],
	['221', '223', '224', '225', '251', '255', '256', '257', '422'],
	['231', '232', '247'],
	['241', '242', '243', '244', '245', '246', '258']
]
const groupOf = (code: string) => GROUPS.findIndex((g) => g.includes(code))
const others = switchItems.filter(
	(e) => e.id !== item.id && codeOf(e.id)[1] !== myItem && e.price != null
)
const sameGroup = others.filter(
	(e) => groupOf(codeOf(e.id)[1]) === groupOf(myItem) && groupOf(myItem) >= 0
)
const sameCat = others.filter((e) => e.category === myCat && !sameGroup.includes(e))
const related6 = [...siblings, ...sameGroup, ...sameCat].slice(0, 6)

// 상단 네 칸: 가장 비싼 곳, 최근 평균, 1년 전 같은 달
const priced = regionRows.filter((r) => r.price != null)
const topRegion = priced.length ? priced[0] : null
const seoulPrice = table[latest][REGIONS[0].id][item.id]?.price ?? null
const yearAgo = analysis.benchmarks[0]
const vsAvg =
	analysis.current != null && analysis.windowAvg
		? Math.round(((analysis.current - analysis.windowAvg) / analysis.windowAvg) * 1000) / 10
		: null
const nameMain = name.replace(/\s*\(.*\)\s*$/, '')
const nameVariety = name.match(/\((.*)\)\s*$/)?.[1] ?? null

const dateLabel = formatDate(latest)
const surveyLabel = analysis.currentDate ? formatDate(analysis.currentDate) : null
const seasonValues = analysis.seasonality.filter((v): v is number => v != null)
const staleNote = status.stale
	? isEn
		? `Not surveyed recently${status.lastSurvey ? ` (last survey ${formatDate(status.lastSurvey)})` : ''} — likely out of season.`
		: `최근 조사 자료가 없습니다${status.lastSurvey ? ` (마지막 조사 ${formatDate(status.lastSurvey)})` : ''}.`
	: null
const title = isEn
	? `${name} price — wholesale market outlook (${dateLabel})`
	: `${name} 시세 — 도매가격과 전망 (${dateLabel} 기준)`
const description = isEn
	? `${name} wholesale price (KAMIS, Seoul) ${surveyLabel ? `on ${surveyLabel}: ${fmt(analysis.current)} per ${unit}` : 'not surveyed recently'}. Compared with the same month 1, 3, 5 and 10 years ago, with seasonal index, 5-year monthly trend and prices in five Korean cities.`
	: `${name} 도매 시세(KAMIS 중도매인 판매가격, 서울)는 ${surveyLabel ? `${surveyLabel} 기준 ${unit}당 ${fmt(analysis.current)}` : '최근 조사가 없다'}. 1년·3년·5년·10년 전 같은 달과 비교하고, 계절지수와 최근 5년 월평균 추이, 서울·부산·대구·광주·대전 지역별 가격을 함께 정리했다.`

const canonical = new URL(Astro.url.pathname, siteConfig.siteUrl).href

const faq = isEn
	? [
			{
				q: `How much is ${name} today?`,
				a: surveyLabel
					? `On ${surveyLabel}, the KAMIS wholesale (intermediary) price for ${name} (${grade}, ${unit}) in Seoul was ${fmt(analysis.current)}. The average over the last 30 survey days is ${fmt(analysis.windowAvg)}.`
					: `${name} has not been surveyed recently, so there is no current KAMIS price.`
			},
			{
				q: `Is ${name} expensive right now?`,
				a:
					analysis.percentile == null
						? 'There is not enough recent survey data to compare.'
						: `Within the past 12 months the current price sits at the ${analysis.percentile}th percentile — ${analysis.percentile >= 50 ? 'above' : 'below'} the one-year median.`
			},
			{
				q: `When is ${name} usually most expensive?`,
				a: seasonValues.length
					? `Over a 10-year average, the seasonal index peaks at ${Math.max(...seasonValues)} and bottoms at ${Math.min(...seasonValues)} (10-year average = 100).`
					: 'There is not enough monthly data to compute a seasonal index.'
			}
		]
	: [
			{
				q: `오늘 ${name} 시세는 얼마인가?`,
				a: surveyLabel
					? `${surveyLabel} KAMIS 조사 기준 ${name}(${grade}, ${unit}) 서울 도매시장 중도매인 판매가격은 ${fmt(analysis.current)}이다. 최근 30개 조사일 평균은 ${fmt(analysis.windowAvg)}이다.`
					: `${name}는 최근 KAMIS 조사가 없어 현재 가격이 없다.`
			},
			{
				q: `지금 ${name} 값은 비싼 편인가?`,
				a:
					analysis.percentile == null
						? '비교할 만큼 최근 조사값이 충분하지 않다.'
						: `최근 1년 안에서 보면 현재가는 ${analysis.percentile}번째 백분위에 있다. 1년 중간값보다 ${analysis.percentile >= 50 ? '높은' : '낮은'} 구간이다.`
			},
			{
				q: `${name}는 보통 언제 가장 비싼가?`,
				a: seasonValues.length
					? `10년 평균으로 보면 계절지수가 최고 ${Math.max(...seasonValues)}, 최저 ${Math.min(...seasonValues)}까지 움직인다 (10년 평균 = 100).`
					: '계절지수를 계산할 만큼 월별 조사값이 충분하지 않다.'
			}
		]

const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'Dataset',
		name: title,
		description,
		url: canonical,
		keywords: isEn ? item.keywordsEn : item.keywordsKo,
		temporalCoverage: `${analysis.monthly[0]?.ym ?? latest}/${latest}`,
		spatialCoverage: { '@type': 'Place', name: isEn ? 'Republic of Korea' : '대한민국' },
		variableMeasured: {
			'@type': 'PropertyValue',
			name: isEn ? `${name} wholesale price` : `${name} 도매가격`,
			unitText: unit,
			value: analysis.current
		},
		creator: { '@type': 'Organization', name: siteConfig.author.name, url: siteConfig.siteUrl },
		isAccessibleForFree: true
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: faq.map((entry) => ({
			'@type': 'Question',
			name: entry.q,
			acceptedAnswer: { '@type': 'Answer', text: entry.a }
		}))
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'IMUN.FARM', item: siteConfig.siteUrl },
			{
				'@type': 'ListItem',
				position: 2,
				name: isEn ? 'Prices' : '농산물 시세',
				item: new URL(`${prefix}/prices/`, siteConfig.siteUrl).href
			},
			{ '@type': 'ListItem', position: 3, name }
		]
	}
]

const t = {
	byRegion: isEn ? 'By market · ' + dateLabel : '지역별 시세 · ' + dateLabel,
	market: isEn ? 'City' : '지역',
	price: isEn ? 'Price' : '가격',
	change: isEn ? 'Change' : '전일비',
	faq: isEn ? 'Questions' : '자주 묻는 것',
	related: isEn ? 'Related posts' : '관련 기록',
	otherItems: isEn ? 'Related crops' : '같이 보는 품목',
	source: isEn
		? 'Source: aT KAMIS price information (Public Data Portal) · wholesale intermediary selling prices in Seoul, Busan, Daegu, Gwangju and Daejeon. Days without a survey carry the previous survey value. Past-year comparisons use KAMIS monthly averages for the same month.'
		: '출처: aT KAMIS 가격정보(공공데이터포털) · 서울·부산·대구·광주·대전 도매시장 중도매인 판매가격. 조사가 없는 날은 직전 조사값을 표시한다. 과거 연도 비교는 KAMIS 같은 달 월평균 기준이다.',
	backToPrices: isEn ? 'All prices' : '전체 시세표'
}
---

<BaseLayout title={title} description={description} locale={locale} active='prices'>
	{jsonLd.map((schema) => <script type='application/ld+json' set:html={JSON.stringify(schema)} />)}

	<div class='im-item im-pad im-bottom'>
		<div class='im-top-sm'></div>

		<nav class='im-meta im-crumb'>
			<a href={`${prefix}/prices/`}>{isEn ? 'Prices' : '농산물 시세'}</a>
			<span>/</span>
			<span>{name}</span>
			<PriceSwitcher items={switchItems} currentId={item.id} prefix={prefix} isEn={isEn} />
		</nav>

		<div class={`im-item-top ${photo ? 'has-photo' : ''}`}>
			{
				photo && (
					<img
						class='im-item-photo'
						src={photo}
						alt={name}
						width='480'
						height='480'
						decoding='async'
						fetchpriority='high'
					/>
				)
			}
			<div>
				<h1 class='im-item-title'>
					{nameMain}
					{isEn ? ' price' : ' 시세'}
					{nameVariety && <span class='im-item-variety'> {nameVariety}</span>}
				</h1>
				<p class='im-item-sub'>
					{grade} · {unit} · {isEn ? 'KAMIS wholesale intermediary price' : 'KAMIS 중도매인 판매가'}
				</p>
				{staleNote && <p class='im-meta'>{staleNote}</p>}
			</div>
		</div>

		<dl class='im-item-key'>
			<div>
				<dt>
					<span id='im-item-region'>{isEn ? 'Seoul' : '서울'}</span> ·{' '}
					<span id='im-item-date'>{surveyLabel ?? dateLabel}</span>
				</dt>
				<dd>
					<span class='im-item-price' id='im-item-price'>{fmt(analysis.current)}</span>
					<span class={`im-item-change ${dir(analysis.trend30)}`} id='im-item-change'>
						{isEn ? '30 survey days' : '30개 조사일'}
						{pct(analysis.trend30)}
					</span>
				</dd>
			</div>
			<div>
				<dt>{isEn ? 'Highest market today' : '가장 비싼 곳'}</dt>
				<dd>
					<span class='im-item-key-v'>
						{topRegion ? `${topRegion.label} ${fmt(topRegion.price)}` : '–'}
					</span>
					<span class='im-item-key-s'>
						{
							!topRegion
								? isEn
									? 'No market surveyed on the latest day'
									: '최근 조사일에 조사된 시장이 없습니다'
								: priced.length === 1
									? isEn
										? 'Only one market surveyed'
										: '조사된 시장이 한 곳입니다'
									: seoulPrice != null && topRegion.price !== seoulPrice
										? isEn
											? `${fmt(topRegion.price! - seoulPrice)} above Seoul`
											: `서울보다 ${fmt(topRegion.price! - seoulPrice)} 높습니다`
										: isEn
											? 'Seoul is the highest'
											: '서울이 가장 높습니다'
						}
					</span>
				</dd>
			</div>
			<div>
				<dt>{isEn ? '30-survey-day average' : '최근 30개 조사일 평균'}</dt>
				<dd>
					<span class='im-item-key-v'>{fmt(analysis.windowAvg)}</span>
					<span class='im-item-key-s'>
						{
							vsAvg == null
								? '–'
								: vsAvg === 0
									? isEn
										? 'Today equals the average'
										: '오늘 값이 평균과 같습니다'
									: isEn
										? `Today is ${Math.abs(vsAvg).toFixed(1)}% ${vsAvg > 0 ? 'above' : 'below'}`
										: `오늘은 평균보다 ${Math.abs(vsAvg).toFixed(1)}% ${vsAvg > 0 ? '높습니다' : '낮습니다'}`
						}
					</span>
				</dd>
			</div>
			<div>
				<dt>{isEn ? 'vs same month last year' : '1년 전 같은 달보다'}</dt>
				<dd>
					<span class={`im-item-key-v ${dir(yearAgo.diffPct)}`}>{pct(yearAgo.diffPct)}</span>
					<span class='im-item-key-s'>
						{
							yearAgo.avg != null
								? isEn
									? `${yearAgo.year} average ${fmt(yearAgo.avg)}`
									: `${yearAgo.year}년 같은 달 평균 ${fmt(yearAgo.avg)}`
								: isEn
									? 'No survey last year'
									: '작년 같은 달 조사 없음'
						}
					</span>
				</dd>
			</div>
		</dl>

		<PriceChart
			series={buildItemSeries(item, today)}
			regions={REGIONS.map((r) => ({ id: r.id, label: isEn ? r.en : r.ko }))}
			isEn={isEn}
		/>

		{!isEn && <CoupangDynamic />}

		<p class='im-item-lead'>{description}</p>

		<h2 class='im-analysis-h'>{t.byRegion}</h2>
		<table class='im-region-table'>
			<thead>
				<tr>
					<th>{t.market}</th>
					<th class='im-num'>{t.price}</th>
					<th class='im-num'>{t.change}</th>
				</tr>
			</thead>
			<tbody>
				{
					regionRows.map((row) => (
						<tr>
							<th scope='row'>{row.label}</th>
							<td class='im-num'>{fmt(row.price)}</td>
							<td class={`im-num ${dir(row.delta)}`}>{pct(row.delta)}</td>
						</tr>
					))
				}
			</tbody>
		</table>

		<PriceAnalysis item={item} analysis={analysis} isEn={isEn} fmt={fmt} />

		<h2 class='im-analysis-h'>{t.faq}</h2>
		<div class='im-faq'>
			{
				faq.map((entry) => (
					<details>
						<summary>{entry.q}</summary>
						<p>{entry.a}</p>
					</details>
				))
			}
		</div>

		<p class='im-meta im-source'>{t.source}</p>

		{
			related.length > 0 && (
				<>
					<h2 class='im-analysis-h'>{t.related}</h2>
					<div class='im-related-rows'>
						{related.map((post) => (
							<a class='im-row' href={getPostUrl(post.slug, locale, post.data.category)}>
								<span class='im-row-title'>{post.data.title}</span>
								<span class='im-meta'>→</span>
							</a>
						))}
					</div>
				</>
			)
		}

		<h2 class='im-analysis-h'>{t.otherItems}</h2>
		<div class='im-near'>
			{
				related6.map((entry) => (
					<a class='im-near-row' href={`${prefix}/prices/${entry.id}/`}>
						<span class='im-near-thumb'>
							{entry.photo ? (
								<img
									src={entry.photo}
									alt=''
									width='40'
									height='40'
									loading='lazy'
									decoding='async'
								/>
							) : (
								<span aria-hidden='true'>{entry.label.slice(0, 1)}</span>
							)}
						</span>
						<span class='im-near-name'>{entry.label}</span>
						<span class='im-near-price'>{fmt(entry.price)}</span>
					</a>
				))
			}
		</div>
		<a class='im-near-all im-menu' href={`${prefix}/prices/`}>{t.backToPrices} →</a>
	</div>
</BaseLayout>

<style>
	.im-item {
		/* 본문 760px: 차트·표·문단·목록을 같은 폭으로 맞춘다 */
		width: min(calc(760px + 2 * var(--gutter)), 100%);
		margin-inline: auto;
	}

	.im-crumb {
		display: flex;
		gap: 8px;
	}

	.im-item-title {
		margin: clamp(16px, 2vw, 26px) 0 0;
		font-size: clamp(30px, 4.2vw, 52px);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.12;
		text-wrap: balance;
	}

	.im-item-variety {
		display: block;
		margin-top: 6px;
		color: var(--muted);
		font-size: clamp(15px, 1.6vw, 19px);
		font-weight: 600;
		letter-spacing: 0;
	}

	.im-item-sub {
		margin: 10px 0 0;
		color: var(--muted);
		font-size: 14px;
	}

	.im-item-key {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		margin: clamp(22px, 3vw, 32px) 0 clamp(26px, 3.4vw, 40px);
		border-top: 1px solid var(--ink);
		border-bottom: 1px solid var(--ink);
		font-variant-numeric: tabular-nums;
	}

	.im-item-key > div {
		padding: 16px 18px 18px 0;
	}

	.im-item-key > div:nth-child(even) {
		padding-left: 18px;
		border-left: 1px solid var(--line);
	}

	.im-item-key > div:nth-child(n + 3) {
		border-top: 1px solid var(--line);
	}

	.im-item-key dt {
		font-size: 13px;
		font-weight: 700;
	}

	.im-item-key dd {
		display: grid;
		gap: 6px;
		margin: 8px 0 0;
	}

	.im-item-price,
	.im-item-key-v {
		font-size: clamp(24px, 3vw, 34px);
		font-weight: 800;
		line-height: 1.1;
		letter-spacing: -0.02em;
	}

	.im-item-key-s,
	.im-item-change {
		color: var(--muted);
		font-size: 13px;
		line-height: 1.5;
	}

	.im-item-change.im-up {
		color: var(--up);
	}

	.im-item-change.im-down {
		color: var(--down);
	}

	@media (max-width: 640px) {
		.im-item-price,
		.im-item-key-v {
