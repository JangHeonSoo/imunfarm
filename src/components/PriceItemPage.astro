---
import BaseLayout from '@/layouts/BaseLayout'
import PriceAnalysis from '@/components/PriceAnalysis'
import { DEFAULT_LOCALE, getLocalePrefix, getPostUrl, getPosts } from '@/utils'
import { ITEMS, REGIONS, buildAnalysis, buildPriceData, formatDate } from '@/data/prices'
import { siteConfig } from '@/site-config'

const { locale = DEFAULT_LOCALE, itemId } = Astro.props
const isEn = locale === 'en'
const prefix = getLocalePrefix(locale)

const item = ITEMS.find((entry) => entry.id === itemId)!
const name = isEn ? item.en : item.ko
const unit = isEn ? item.unitEn : item.unitKo
const grade = isEn ? item.gradeEn : item.gradeKo

const today = new Date()
const { dates, table } = buildPriceData(today)
const latest = dates[dates.length - 1]
const analysis = buildAnalysis(item, REGIONS[0], today)

const fmt = (value: number) =>
	isEn ? '₩' + value.toLocaleString('en-US') : value.toLocaleString('ko-KR') + '원'
const pct = (v: number) => (v > 0 ? '+' : v < 0 ? '−' : '') + Math.abs(v).toFixed(1) + '%'
const dir = (v: number) => (v > 0 ? 'im-up' : v < 0 ? 'im-down' : 'im-flat')

const regionRows = REGIONS.map((region) => ({
	label: isEn ? region.en : region.ko,
	...table[latest][region.id][item.id]
})).sort((a, b) => b.price - a.price)

// 관련 기록
const posts = await getPosts(undefined, locale)
const needles = [
	name.toLowerCase(),
	...(isEn ? item.keywordsEn : item.keywordsKo).map((k) => k.toLowerCase())
]
const related = posts
	.filter((post) => {
		const haystack =
			`${post.data.title} ${post.data.description ?? ''} ${(post.data.tags ?? []).join(' ')}`.toLowerCase()
		return needles.some((needle) => haystack.includes(needle.split(' ')[0]))
	})
	.slice(0, 4)

const others = ITEMS.filter((entry) => entry.id !== item.id)

const dateLabel = formatDate(latest)
const title = isEn
	? `${name} price — wholesale market outlook (${dateLabel})`
	: `${name} 시세 — 도매가격과 전망 (${dateLabel} 기준)`
const description = isEn
	? `${name} wholesale price on ${dateLabel}: ${fmt(analysis.current)} per ${unit}. Compared with the same period 1, 3, 5 and 10 years ago, with seasonal index and 5-year monthly trend across six Korean wholesale markets.`
	: `${dateLabel} 기준 ${name} 도매 시세는 ${unit}당 ${fmt(analysis.current)}. 1년·3년·5년·10년 전 같은 기간과 비교하고, 계절지수와 최근 5년 월평균 추이, 6개 공영도매시장 지역별 가격을 함께 정리했다.`

const canonical = new URL(Astro.url.pathname, siteConfig.siteUrl).href

const faq = isEn
	? [
			{
				q: `How much is ${name} today?`,
				a: `As of ${dateLabel}, ${name} (${grade}, ${unit}) traded at ${fmt(analysis.current)} at Seoul Garak market. The 30-day average is ${fmt(analysis.windowAvg)}.`
			},
			{
				q: `Is ${name} expensive right now?`,
				a: `Within the past 12 months the current price sits at the ${analysis.percentile}th percentile — ${analysis.percentile >= 50 ? 'above' : 'below'} the one-year median.`
			},
			{
				q: `When is ${name} usually most expensive?`,
				a: `Over a 10-year average, the seasonal index peaks at ${Math.max(...analysis.seasonality)} and bottoms at ${Math.min(...analysis.seasonality)} (10-year average = 100).`
			}
		]
	: [
			{
				q: `오늘 ${name} 시세는 얼마인가?`,
				a: `${dateLabel} 기준 ${name}(${grade}, ${unit})는 서울 가락시장에서 ${fmt(analysis.current)}에 거래됐다. 최근 30일 평균은 ${fmt(analysis.windowAvg)}이다.`
			},
			{
				q: `지금 ${name} 값은 비싼 편인가?`,
				a: `최근 1년 안에서 보면 현재가는 ${analysis.percentile}번째 백분위에 있다. 1년 중간값보다 ${analysis.percentile >= 50 ? '높은' : '낮은'} 구간이다.`
			},
			{
				q: `${name}는 보통 언제 가장 비싼가?`,
				a: `10년 평균으로 보면 계절지수가 최고 ${Math.max(...analysis.seasonality)}, 최저 ${Math.min(...analysis.seasonality)}까지 움직인다 (10년 평균 = 100).`
			}
		]

const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'Dataset',
		name: title,
		description,
		url: canonical,
		keywords: isEn ? item.keywordsEn : item.keywordsKo,
		temporalCoverage: `${analysis.monthly[0].ym}/${latest}`,
		spatialCoverage: { '@type': 'Place', name: isEn ? 'Republic of Korea' : '대한민국' },
		variableMeasured: {
			'@type': 'PropertyValue',
			name: isEn ? `${name} wholesale price` : `${name} 도매가격`,
			unitText: unit,
			value: analysis.current
		},
		creator: { '@type': 'Organization', name: siteConfig.author.name, url: siteConfig.siteUrl },
		isAccessibleForFree: true
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: faq.map((entry) => ({
			'@type': 'Question',
			name: entry.q,
			acceptedAnswer: { '@type': 'Answer', text: entry.a }
		}))
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'IMUN.FARM', item: siteConfig.siteUrl },
			{
				'@type': 'ListItem',
				position: 2,
				name: isEn ? 'Prices' : '농산물 시세',
				item: new URL(`${prefix}/prices/`, siteConfig.siteUrl).href
			},
			{ '@type': 'ListItem', position: 3, name }
		]
	}
]

const t = {
	byRegion: isEn ? 'By market · ' + dateLabel : '지역별 시세 · ' + dateLabel,
	market: isEn ? 'Market' : '도매시장',
	price: isEn ? 'Price' : '가격',
	change: isEn ? 'Change' : '전일비',
	faq: isEn ? 'Questions' : '자주 묻는 것',
	related: isEn ? 'Related posts' : '관련 기록',
	otherItems: isEn ? 'Other crops' : '다른 품목',
	source: isEn
		? 'Wholesale auction prices across six public markets. Recalculated every build; the analysis compares the same calendar window (±15 days) in past years.'
		: '6개 공영도매시장 경락가 기준. 분석은 과거 연도의 같은 시기(±15일)를 비교하며 매 갱신마다 다시 계산된다.',
	backToPrices: isEn ? 'All prices' : '전체 시세표'
}
---

<BaseLayout title={title} description={description} locale={locale} active='prices'>
	{jsonLd.map((schema) => <script type='application/ld+json' set:html={JSON.stringify(schema)} />)}

	<div class='im-item im-pad im-bottom'>
		<div class='im-top-sm'></div>

		<nav class='im-meta im-crumb'>
			<a href={`${prefix}/prices/`}>{isEn ? 'Prices' : '농산물 시세'}</a>
			<span>/</span>
			<span>{name}</span>
		</nav>

		<h1 class='im-item-title'>{isEn ? `${name} price` : `${name} 시세`}</h1>

		<div class='im-item-hero'>
			<p class='im-item-price'>{fmt(analysis.current)}</p>
			<p class='im-meta'>
				{grade} · {unit} · {dateLabel} · {isEn ? 'Seoul Garak' : '서울 가락'}
			</p>
			<p class={`im-item-change ${dir(analysis.trend30)}`}>
				{isEn ? '30-day' : '30일'}
				{pct(analysis.trend30)}
			</p>
		</div>

		<p class='im-item-lead'>{description}</p>

		<h2 class='im-analysis-h'>{t.byRegion}</h2>
		<table class='im-region-table'>
			<thead>
				<tr>
					<th>{t.market}</th>
					<th class='im-num'>{t.price}</th>
					<th class='im-num'>{t.change}</th>
				</tr>
			</thead>
			<tbody>
				{
					regionRows.map((row) => (
						<tr>
							<th scope='row'>{row.label}</th>
							<td class='im-num'>{fmt(row.price)}</td>
							<td class={`im-num ${dir(row.delta)}`}>{pct(row.delta)}</td>
						</tr>
					))
				}
			</tbody>
		</table>

		<PriceAnalysis item={item} analysis={analysis} isEn={isEn} fmt={fmt} />

		<h2 class='im-analysis-h'>{t.faq}</h2>
		<div class='im-faq'>
			{
				faq.map((entry) => (
					<details>
						<summary>{entry.q}</summary>
						<p>{entry.a}</p>
					</details>
				))
			}
		</div>

		<p class='im-meta im-source'>{t.source}</p>

		{
			related.length > 0 && (
				<>
					<h2 class='im-analysis-h'>{t.related}</h2>
					<div class='im-related-rows'>
						{related.map((post) => (
							<a class='im-row' href={getPostUrl(post.slug, locale, post.data.category)}>
								<span class='im-row-title'>{post.data.title}</span>
								<span class='im-meta'>→</span>
							</a>
						))}
					</div>
				</>
			)
		}

		<h2 class='im-analysis-h'>{t.otherItems}</h2>
		<nav class='im-other'>
			<a class='im-tab' href={`${prefix}/prices/`}>{t.backToPrices}</a>
			{
				others.map((entry) => (
					<a class='im-tab' href={`${prefix}/prices/${entry.id}/`}>
						{isEn ? entry.en : entry.ko}
					</a>
				))
			}
		</nav>
	</div>
</BaseLayout>

<style>
	.im-item {
		width: min(900px, 100%);
		margin-inline: auto;
	}

	.im-crumb {
		display: flex;
		gap: 8px;
	}

	.im-item-title {
		margin: clamp(16px, 2vw, 26px) 0 0;
		font-size: clamp(32px, 5vw, 68px);
		font-weight: 800;
		letter-spacing: 0.01em;
		line-height: 1.04;
	}

	.im-item-hero {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 8px clamp(14px, 2vw, 26px);
		margin-top: clamp(18px, 2.4vw, 28px);
	}

	.im-item-hero p {
		margin: 0;
	}

	.im-item-price {
		font-size: clamp(30px, 3.6vw, 46px);
		font-weight: 800;
		letter-spacing: -0.01em;
	}

	.im-item-change {
		font-size: 14px;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}

	.im-item-lead {
		max-width: 62ch;
		margin: clamp(24px, 3vw, 36px) 0 0;
		font-size: clamp(16px, 1.3vw, 19px);
		line-height: 1.75;
		color: var(--muted);
		text-wrap: pretty;
	}

	.im-region-table {
		width: 100%;
		max-width: 560px;
		border-collapse: collapse;
		border-top: 1px solid var(--ink);
		font-variant-numeric: tabular-nums;
	}

	.im-region-table th,
	.im-region-table td {
		border-bottom: 1px solid var(--line);
		padding: 12px 0;
		text-align: left;
	}

	.im-region-table thead th {
		font-size: 10px;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.im-region-table tbody th,
	.im-region-table tbody td {
		font-size: 14px;
		font-weight: 600;
	}

	.im-faq {
		max-width: 62ch;
		border-top: 1px solid var(--line);
	}

	.im-faq details {
		border-bottom: 1px solid var(--line);
	}

	.im-faq summary {
		cursor: pointer;
		list-style: none;
		padding: 14px 0;
		font-size: 15px;
		font-weight: 600;
	}

	.im-faq summary::-webkit-details-marker {
		display: none;
	}

	.im-faq summary::before {
		content: '+ ';
		color: var(--muted);
	}

	.im-faq details[open] summary::before {
		content: '− ';
	}

	.im-faq p {
		margin: 0;
		padding: 0 0 16px;
		font-size: 15px;
		line-height: 1.75;
		color: var(--muted);
		text-wrap: pretty;
	}

	.im-source {
		max-width: 62ch;
		margin: clamp(32px, 5vh, 56px) 0 0;
	}

	.im-related-rows {
		max-width: 62ch;
		border-top: 1px solid var(--ink);
	}

	.im-row-title {
		font-size: 14px;
		font-weight: 600;
		line-height: 1.4;
	}

	.im-other {
		display: flex;
		flex-wrap: wrap;
		gap: 12px clamp(14px, 2vw, 26px);
		font-size: 13px;
		font-weight: 500;
	}
</style>
