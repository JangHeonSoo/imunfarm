---
import type { CollectionEntry } from 'astro:content'
import { DEFAULT_LOCALE, formatPostDate, getPostUrl } from '@/utils'

type Props = {
	posts: CollectionEntry<'blog'>[]
	locale?: string
}

const { posts, locale = DEFAULT_LOCALE } = Astro.props
const isEn = locale === 'en'
---

{
	posts.length > 0 && (
		<section class='im-related'>
			<p class='im-label'>{isEn ? 'Related' : '관련 기록'}</p>
			<div class='im-related-list'>
				{posts.map((post) => (
					<a class='im-row' href={getPostUrl(post.slug, locale, post.data.category)}>
						<span class='im-related-title'>{post.data.title}</span>
						<span class='im-meta'>{formatPostDate(post.data.pubDate)}</span>
					</a>
				))}
			</div>
		</section>
	)
}

<style>
	.im-related {
		display: grid;
		gap: 12px;
		margin-top: clamp(48px, 8vh, 96px);
		max-width: 760px;
	}

	.im-related-list {
		border-top: 1px solid var(--ink);
	}

	.im-related-title {
		font-size: 14px;
		font-weight: 600;
		line-height: 1.4;
	}
</style>
