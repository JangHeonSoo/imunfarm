---
import { DEFAULT_LOCALE, getLocaleName, getLocalePrefix } from '@/utils'
import { CONTACT_EMAIL } from '@/site-config'

const { locale = DEFAULT_LOCALE, otherLocale = 'en', altPath, active = '' } = Astro.props
const prefix = getLocalePrefix(locale)
const isEn = locale === 'en'
const mailto = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(
	isEn ? 'IMUN.FARM inquiry' : 'imun.farm 문의'
)}`

const links = [
	{ href: `${prefix}/blog/`, label: isEn ? 'Posts' : '기록', key: 'blog' },
	{ href: `${prefix}/tags/`, label: isEn ? 'Tags' : '태그', key: 'tags' },
	{ href: `${prefix}/prices/`, label: isEn ? 'Prices' : '시세', key: 'prices' }
]
---

<footer class='im-footer im-menu'>
	<nav class='im-footer-group'>
		{
			links.map((link) => (
				<a href={link.href} aria-current={active === link.key ? 'page' : undefined}>
					{link.label}
				</a>
			))
		}
	</nav>
	<div class='im-footer-group im-footer-end'>
		{
			altPath && (
				<a href={altPath} class='im-lang'>
					{getLocaleName(otherLocale)} <span>+</span>
				</a>
			)
		}
		<button type='button' id='im-theme-toggle' data-label-dark='Dark' data-label-light='Light'
			>Dark</button
		>
		<a href={mailto}>{isEn ? 'Contact' : '문의'}</a>
		<a href={mailto}>{CONTACT_EMAIL}</a>
	</div>
</footer>

<script is:inline>
	function initThemeToggle() {
		const button = document.getElementById('im-theme-toggle')
		if (!button) return
		const sync = () => {
			const isDark = document.documentElement.classList.contains('dark')
			button.textContent = isDark ? button.dataset.labelLight : button.dataset.labelDark
		}
		sync()
		if (button.dataset.bound === 'true') return
		button.dataset.bound = 'true'
		button.addEventListener('click', () => {
			const next = document.documentElement.classList.contains('dark') ? 'light' : 'dark'
			document.dispatchEvent(new CustomEvent('theme-change', { detail: { theme: next } }))
			sync()
		})
	}
	if (document.readyState === 'loading')
		document.addEventListener('DOMContentLoaded', initThemeToggle)
	else initThemeToggle()
	document.addEventListener('astro:page-load', initThemeToggle)
	document.addEventListener('astro:after-swap', initThemeToggle)
</script>

<style>
	.im-footer {
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-items: end;
		gap: clamp(16px, 3vw, 40px);
		padding: clamp(60px, 14vh, 170px) var(--gutter) clamp(18px, 2vw, 28px);
		color: var(--ink);
	}

	.im-footer-group {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: clamp(14px, 2vw, 28px);
	}

	.im-footer-end {
		justify-content: flex-end;
	}

	.im-footer a,
	.im-footer button {
		border: 0;
		background: none;
		padding: 0;
		color: inherit;
		font: inherit;
		letter-spacing: inherit;
		text-transform: inherit;
		transition: opacity 200ms ease;
	}

	.im-footer a:hover,
	.im-footer button:hover {
		opacity: 0.55;
	}

	.im-footer a[aria-current='page'] {
		opacity: 0.55;
	}

	.im-lang span {
		font-weight: 500;
	}

	@media (max-width: 640px) {
		.im-footer {
			grid-template-columns: 1fr;
		}

		.im-footer-end {
			justify-content: flex-start;
		}
	}
</style>
