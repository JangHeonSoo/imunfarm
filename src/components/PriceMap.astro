---
/**
 * 시세 지도 (finviz.com/map 방식). 데이터: src/data/price-map.ts
 * - 배치: d3-hierarchy treemap (squarify, 분류 → 소분류 → 작물 3단, 분류·소분류 머리띠는 paddingTop).
 *   참고: Observable @d3/nested-treemap
 * - 확대·이동: d3-zoom 을 canvas 에 건다. 그림 전체를 변환하므로 글자·사진도 함께 커진다 (finviz 처럼).
 *   참고: Observable @d3/zoom-canvas, d3-zoom README
 * - 휠은 지도 위에서 바로 확대·축소된다 (finviz 처럼). 페이지는 지도 밖에서 내린다.
 *   휴대폰은 처음 크기에서 한 손가락이면 페이지 스크롤, 두 손가락이면 확대.
 * - 칸이 화면에서 작으면 누를 때 먼저 그 소분류로 확대하고, 크면 시세 페이지로 간다.
 * - 색은 기본이 어제(직전 조사일) 대비, 단추로 작년 같은 달 대비로 바꾼다.
 */
import { buildPriceMap } from '@/data/price-map'

type Props = { isEn?: boolean; prefix?: string }
const { isEn = false, prefix = '' } = Astro.props
const { groups, days, priceDate, prevDate } = buildPriceMap(isEn)
const md = (iso: string) => {
	const [, m, d] = iso.split('-').map(Number)
	return isEn ? `${m}/${d}` : `${m}월 ${d}일`
}
const payload = { groups, prefix, isEn }
---

<div class='im-map' data-map>
	<div class='im-map-mode' role='group' aria-label={isEn ? 'Compare with' : '무엇과 비교할지'}>
		<button type='button' data-mode='day' aria-pressed='true'>
			{isEn ? 'vs yesterday' : '어제와 비교'}
		</button>
		<button type='button' data-mode='yoy' aria-pressed='false'>
			{isEn ? 'vs last year' : '작년과 비교'}
		</button>
	</div>
	<div class='im-map-bar'>
		<p>
			{
				isEn
					? 'Scroll or pinch to zoom, drag to move. Click a tile to open.'
					: '휠이나 두 손가락으로 확대하고, 끌어서 옮깁니다. 칸을 누르면 시세 페이지로 갑니다.'
			}
		</p>
		<div class='im-map-tools'>
			<button type='button' data-zoom='in' aria-label={isEn ? 'Zoom in' : '확대'}>+</button>
			<button type='button' data-zoom='out' aria-label={isEn ? 'Zoom out' : '축소'}>−</button>
			<button type='button' data-zoom='reset' class='im-map-reset'>{isEn ? 'All' : '전체'}</button>
		</div>
	</div>

	<div class='im-map-stage' data-stage>
		<canvas data-canvas aria-hidden='true'></canvas>
		<div class='im-map-tip' data-tip hidden></div>
	</div>

	<!-- 크롤러·화면 낭독기용 목록 (지도는 canvas 라 글자가 없다) -->
	<ul class='im-map-sr'>
		{
			groups.map((g) =>
				g.subs.map((s) =>
					s.tiles.map((t) => (
						<li>
							<a href={`${prefix}/prices/${t.id}/`}>
								{g.label} {s.label} {t.name}
							</a>
						</li>
					))
				)
			)
		}
	</ul>

	<div class='im-map-legend'>
		<span data-legend-label>{isEn ? 'vs yesterday' : '어제보다'}</span>
		<span class='im-map-end'>{isEn ? 'Cheaper' : '쌉니다'}</span>
		<span class='im-map-scale' aria-hidden='true'>
			<i class='d3'></i><i class='d2'></i><i class='d1'></i><i class='n'></i><i class='u1'></i><i
				class='u2'></i><i class='u3'></i>
		</span>
		<span class='im-map-end'>{isEn ? 'Pricier' : '비쌉니다'}</span>
	</div>
	<p class='im-meta im-map-note'>
		{
			isEn
				? `Tile size: national public wholesale market trade value (average of the last ${days} survey days). Grains and seeds trade mostly outside these markets, so their tiles look small.`
				: '큰 칸일수록 요즘 도매시장에서 많이 팔린 품목입니다. 곡식과 깨는 도매시장 밖에서 많이 팔려 작게 보입니다.'
		}
	</p>
	<p class='im-meta im-map-note' data-mode-note='day'>
		{
			isEn
				? `Compares ${md(priceDate)} with the previous survey day, ${md(prevDate)}. Many items keep the same price for days, so they stay grey.`
				: `${md(priceDate)} 값을 그 전 조사일인 ${md(prevDate)} 값과 비교합니다. 며칠씩 값이 그대로인 품목이 많아 회색 칸이 많습니다.`
		}
	</p>
	<p class='im-meta im-map-note' data-mode-note='yoy' hidden>
		{
			isEn
				? 'Compares the last 30 days with the same month last year.'
				: '최근 30일 평균을 작년 같은 달 평균과 비교합니다.'
		}
	</p>
	<script type='application/json' data-map-data set:html={JSON.stringify(payload)} />
</div>

<script>
	import { hierarchy, treemap, treemapSquarify, type HierarchyRectangularNode } from 'd3-hierarchy'
	import { select } from 'd3-selection'
	import { zoom, zoomIdentity, type ZoomTransform } from 'd3-zoom'
	import 'd3-transition'

	type Tile = {
		id: string
		name: string
		photo: string | null
		value: number
		yoy: number | null
		day: number | null
		price: number | null
		unit: string
		kg: number | null
	}
	type Sub = { label: string; tiles: Tile[] }
	type Group = { key: string; label: string; subs: Sub[] }
	type Datum = { name: string; tile?: Tile; children?: Datum[] }
	type Node = HierarchyRectangularNode<Datum>

	const GROUP_HEAD = 20
	const SUB_HEAD = 14

	// finviz 처럼 7단계 색. 하루 변동은 작아서 구간을 좁게 잡는다
	type Mode = 'day' | 'yoy'
	const STEPS: Record<Mode, [number, number, number]> = { day: [1, 5, 10], yoy: [5, 15, 30] }
	const bucketOf = (v: number | null, mode: Mode) => {
		if (v == null) return 'x'
		const [a, b, c] = STEPS[mode]
		const n = Math.abs(v)
		const side = v < 0 ? 'd' : 'u'
		return n < a ? 'n' : n < b ? side + '1' : n < c ? side + '2' : side + '3'
	}
	const PALETTE = {
		light: {
			d3: '#2b5b8f',
			d2: '#4a7eb3',
			d1: '#86a9cc',
			n: '#cfcbc4',
			u1: '#d6927f',
			u2: '#c25a44',
			u3: '#a2341f',
			x: '#e7e4df',
			frame: '#1d1d1b',
			head: '#faf8f6',
			sub: '#3b3b38',
			subText: '#e9e6e1'
		},
		dark: {
			d3: '#2f6ea8',
			d2: '#2a557f',
			d1: '#2a3f55',
			n: '#3a3b40',
			u1: '#5a3029',
			u2: '#8a3a2b',
			u3: '#b4432c',
			x: '#2a2a27',
			frame: '#000',
			head: '#f4f2ef',
			sub: '#26262a',
			subText: '#bdbab5'
		}
	}
	const lightText = new Set(['d3', 'd2', 'u2', 'u3'])

	const initMap = (box: HTMLElement) => {
		if (box.dataset.bound === 'true') return
		box.dataset.bound = 'true'
		const data = JSON.parse(box.querySelector('[data-map-data]')!.textContent || '{}') as {
			groups: Group[]
			prefix: string
			isEn: boolean
		}
		const { isEn, prefix } = data
		const stage = box.querySelector<HTMLElement>('[data-stage]')!
		const canvas = box.querySelector<HTMLCanvasElement>('[data-canvas]')!
		const tip = box.querySelector<HTMLElement>('[data-tip]')!
		const ctx = canvas.getContext('2d')!
		const font = getComputedStyle(document.body).fontFamily
		const isDark = () => document.documentElement.classList.contains('dark')

		const fmt = (v: number | null) =>
			v == null ? '–' : isEn ? '₩' + v.toLocaleString('en-US') : v.toLocaleString('ko-KR') + '원'
		const pct = (v: number | null) =>
			v == null ? '' : (v > 0 ? '+' : v < 0 ? '−' : '') + Math.round(Math.abs(v)) + '%'
		let mode: Mode = 'day'
		const val = (t: Tile) => (mode === 'day' ? t.day : t.yoy)
		const bucket = (v: number | null) => bucketOf(v, mode)
		const sentence = (v: number | null) => {
			if (v == null) return isEn ? 'Not surveyed now' : '지금은 조사하지 않습니다'
			const n = Math.round(Math.abs(v))
			const when = mode === 'day' ? (isEn ? 'yesterday' : '어제') : isEn ? 'last year' : '작년'
			if (isEn)
				return n < 1
					? `About the same as ${when}`
					: `${n}% ${v > 0 ? 'higher' : 'lower'} than ${when}`
			if (n < 1) return mode === 'day' ? '어제와 같습니다' : '작년과 비슷합니다'
			return `${when}보다 ${n}% ${v > 0 ? '비쌉니다' : '쌉니다'}`
		}
		const priceText = (t: Tile) => (t.price == null ? '' : t.kg ? `1kg ${fmt(t.kg)}` : fmt(t.price))

		// 품목 사진 (칸 안 동그란 아이콘)
		const photos = new Map<string, HTMLImageElement>()
		data.groups.forEach((g) =>
			g.subs.forEach((s) =>
				s.tiles.forEach((t) => {
					if (!t.photo) return
					const img = new Image()
					img.decoding = 'async'
					img.src = t.photo
					img.onload = () => draw()
					photos.set(t.id, img)
				})
			)
		)

		const rootDatum: Datum = {
			name: '',
			children: data.groups.map((g) => ({
				name: g.label,
				children: g.subs.map((s) => ({
					name: s.label,
					children: s.tiles.map((t) => ({ name: t.name, tile: t }))
				}))
			}))
		}

		let W = 0
		let H = 0
		let root: Node | null = null
		let leaves: Node[] = []
		let t: ZoomTransform = zoomIdentity
		let hover: Node | null = null

		const layout = () => {
			const h = hierarchy(rootDatum)
				.sum((d) => d.tile?.value ?? 0)
				.sort((a, b) => (b.value ?? 0) - (a.value ?? 0))
			root = treemap<Datum>()
				.tile(treemapSquarify)
				.size([W, H])
				.paddingInner(0)
				.paddingOuter(0)
				// paddingOuter 가 위쪽 여백까지 덮어쓰므로 머리띠 여백은 그 뒤에 준다
				.paddingTop((d) => (d.depth === 1 ? GROUP_HEAD : d.depth === 2 ? SUB_HEAD : 0))(h)
			leaves = root.leaves()
		}

		const theme = () => (isDark() ? PALETTE.dark : PALETTE.light)

		// 글자를 칸 폭에 맞게 자른다
		const fitText = (text: string, maxW: number) => {
			if (ctx.measureText(text).width <= maxW) return text
			let s = text
			while (s.length > 1 && ctx.measureText(s + '…').width > maxW) s = s.slice(0, -1)
			return s.length > 1 ? s + '…' : ''
		}

		const draw = () => {
			if (!root) return
			const P = theme()
			const dpr = window.devicePixelRatio || 1
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
			ctx.fillStyle = P.frame
			ctx.fillRect(0, 0, W, H)
			ctx.setTransform(dpr * t.k, 0, 0, dpr * t.k, dpr * t.x, dpr * t.y)
			const px = 1 / t.k // 화면 1px 을 세계 좌표로
			ctx.textBaseline = 'middle'

			// 분류·소분류 머리띠
			ctx.textAlign = 'left'
			for (const n of root.descendants()) {
				if (n.depth === 0 || n.depth === 3) continue
				const w = n.x1 - n.x0
				if (n.depth === 2) {
					ctx.fillStyle = P.sub
					ctx.fillRect(n.x0 + px, n.y0 + px, w - 2 * px, SUB_HEAD - px)
				}
				const fs = n.depth === 1 ? 12.5 : 9.5
				if (fs * t.k < 7) continue
				ctx.font = `${n.depth === 1 ? 800 : 700} ${fs}px ${font}`
				ctx.fillStyle = n.depth === 1 ? P.head : P.subText
				const label = fitText(n.data.name, w - 10)
				if (label)
					ctx.fillText(label, n.x0 + 5, n.y0 + (n.depth === 1 ? GROUP_HEAD : SUB_HEAD) / 2 + 0.5)
			}

			// 작물 칸
			ctx.textAlign = 'center'
			for (const n of leaves) {
				const tile = n.data.tile!
				const x = n.x0 + px
				const y = n.y0 + px
				const w = n.x1 - n.x0 - 2 * px
				const h = n.y1 - n.y0 - 2 * px
				if (w <= 0 || h <= 0) continue
				const b = bucket(val(tile))
				ctx.fillStyle = P[b as keyof typeof P]
				ctx.fillRect(x, y, w, h)

				// 글자 크기는 칸 크기에 비례 (finviz 처럼 큰 칸은 큰 글자)
				const len = Math.max(2, tile.name.length)
				const fs = Math.min(h * 0.24, (w * 0.86) / len, 40)
				if (fs * t.k < 8) continue
				const textColor = lightText.has(b) || isDark() ? '#fff' : '#1d1d1b'
				const img = photos.get(tile.id)
				const showIcon = !!img?.complete && img.naturalWidth > 0 && w * t.k >= 84 && h * t.k >= 92
				const showPrice = fs * t.k >= 15 && tile.price != null
				const icon = showIcon ? Math.min(w, h) * 0.3 : 0
				const l2 = fs * 0.82
				// 가격은 글자 수가 많아 따로 폭에 맞춘다
				const l3 = showPrice ? Math.min(fs * 0.6, (w * 0.9) / (priceText(tile).length * 0.62)) : 0
				const total = icon + (icon ? fs * 0.35 : 0) + fs + l2 * 1.1 + (l3 ? l3 * 1.3 : 0)
				let cy = y + h / 2 - total / 2
				const cx = x + w / 2
				if (showIcon) {
					ctx.save()
					ctx.beginPath()
					ctx.arc(cx, cy + icon / 2, icon / 2, 0, Math.PI * 2)
					ctx.fillStyle = '#fff'
					ctx.fill()
					ctx.clip()
					ctx.drawImage(img!, cx - icon / 2, cy, icon, icon)
					ctx.restore()
					cy += icon + fs * 0.35
				}
				ctx.fillStyle = val(tile) == null ? (isDark() ? '#8d8a85' : '#77746f') : textColor
				ctx.font = `800 ${fs}px ${font}`
				ctx.fillText(fitText(tile.name, w - 4 * px), cx, cy + fs / 2)
				cy += fs
				ctx.font = `700 ${l2}px ${font}`
				ctx.fillText(
					val(tile) == null ? (isEn ? 'no survey' : '조사 없음') : pct(val(tile)),
					cx,
					cy + l2 * 0.6
				)
				cy += l2 * 1.1
				if (showPrice) {
					ctx.font = `600 ${l3}px ${font}`
					ctx.globalAlpha = 0.85
					ctx.fillText(fitText(priceText(tile), w - 6 * px), cx, cy + l3 * 0.75)
					ctx.globalAlpha = 1
				}
			}

			// 마우스를 올린 칸과 그 소분류 테두리 (finviz 의 노란 테두리 대신 흰색)
			if (hover) {
				const sub = hover.parent!
				ctx.strokeStyle = '#fff'
				ctx.lineWidth = 2 * px
				ctx.strokeRect(sub.x0 + px, sub.y0 + px, sub.x1 - sub.x0 - 2 * px, sub.y1 - sub.y0 - 2 * px)
				ctx.lineWidth = 3 * px
				ctx.strokeRect(
					hover.x0 + 1.5 * px,
					hover.y0 + 1.5 * px,
					hover.x1 - hover.x0 - 3 * px,
					hover.y1 - hover.y0 - 3 * px
				)
			}
		}

		// d3-zoom: 휠·끌기·두 손가락 확대
		const z = zoom<HTMLCanvasElement, unknown>()
			.scaleExtent([1, 16])
			// d3 기본값(-deltaY × 0.002)은 맥 마우스처럼 한 칸에 deltaY 가 4–16 정도로 작게 오면 거의 안 커진다
			// ("줌인이 안 된다", "너무 느리다" 지적 2026-10-19). 마우스 휠 한 칸은 1.4배로 고정하고, 트랙패드는 이동량에 비례.
			.wheelDelta((event: WheelEvent) => {
				const legacy = (event as WheelEvent & { wheelDeltaY?: number }).wheelDeltaY ?? 0
				const notch = event.deltaMode === 1 || (legacy !== 0 && legacy % 120 === 0)
				if (notch) return -Math.sign(event.deltaY) * Math.log2(1.4)
				return -event.deltaY * (event.ctrlKey ? 0.02 : 0.008)
			})
			.filter((event: any) => {
				// 휠은 방향과 상관없이 지도 확대·축소 (finviz 처럼). 맥 '자연스러운 스크롤'에서는 휠을 앞으로 밀면
				// deltaY > 0 이라, 처음 크기에서 이 방향을 페이지 스크롤로 넘겼더니 확대가 안 된다는 지적을 받았다 (2026-10-19)
				if (event.type === 'wheel') return true
				if (event.type === 'touchstart') return event.touches.length > 1 || t.k > 1.001
				if (event.type === 'mousedown') return !event.button && t.k > 1.001
				return !event.ctrlKey && !event.button
			})
			.on('zoom', (event) => {
				t = event.transform
				canvas.style.touchAction = t.k > 1.001 ? 'none' : 'pan-y'
				box.classList.toggle('is-zoomed', t.k > 1.001)
				tip.hidden = true
				draw()
			})

		const resize = () => {
			W = stage.clientWidth
			H = stage.clientHeight
			const dpr = window.devicePixelRatio || 1
			canvas.width = Math.round(W * dpr)
			canvas.height = Math.round(H * dpr)
			canvas.style.width = W + 'px'
			canvas.style.height = H + 'px'
			layout()
			z.extent([
				[0, 0],
				[W, H]
			]).translateExtent([
				[0, 0],
				[W, H]
			])
			t = zoomIdentity
			select(canvas).call(z.transform, zoomIdentity)
			draw()
		}

		select(canvas).call(z).on('dblclick.zoom', null)
		canvas.style.touchAction = 'pan-y'

		const fitTo = (n: Node) => {
			const w = n.x1 - n.x0
			const h = n.y1 - n.y0
			const k = Math.min(16, Math.max(1, 0.96 * Math.min(W / w, H / h)))
			const tr = zoomIdentity
				.translate(W / 2, H / 2)
				.scale(k)
				.translate(-(n.x0 + w / 2), -(n.y0 + h / 2))
			select(canvas).transition().duration(450).call(z.transform, tr)
		}

		const at = (e: MouseEvent) => {
			const r = canvas.getBoundingClientRect()
			const [wx, wy] = t.invert([e.clientX - r.left, e.clientY - r.top])
			return { wx, wy, sx: e.clientX - r.left, sy: e.clientY - r.top }
		}
		const leafAt = (wx: number, wy: number) =>
			leaves.find((n) => wx >= n.x0 && wx < n.x1 && wy >= n.y0 && wy < n.y1) ?? null
		const headAt = (wx: number, wy: number) =>
			root
				?.descendants()
				.filter((n) => n.depth === 1 || n.depth === 2)
				.find(
					(n) =>
						wx >= n.x0 &&
						wx < n.x1 &&
						wy >= n.y0 &&
						wy < n.y0 + (n.depth === 1 ? GROUP_HEAD : SUB_HEAD)
				) ?? null

		// 가격 카드 (finviz 처럼 같은 소분류 품목 목록)
		const showTip = (n: Node, sx: number, sy: number) => {
			const sub = n.parent!
			const group = sub.parent!
			const tile = n.data.tile!
			tip.innerHTML = ''
			const head = document.createElement('p')
			head.className = 'im-tip-head'
			head.textContent = `${group.data.name} · ${sub.data.name}`
			const main = document.createElement('div')
			main.className = 'im-tip-main'
			if (tile.photo) {
				const img = document.createElement('img')
				img.src = tile.photo
				img.alt = ''
				main.append(img)
			}
			const mid = document.createElement('div')
			const nm = document.createElement('b')
			nm.textContent = tile.name
			const un = document.createElement('span')
			un.textContent =
				tile.price == null ? '' : `${isEn ? '' : '도매 '}${tile.unit} ${fmt(tile.price)}`
			mid.append(nm, un)
			const right = document.createElement('div')
			right.className = 'im-tip-right'
			const pr = document.createElement('strong')
			pr.textContent = priceText(tile)
			const yy = document.createElement('em')
			yy.textContent = sentence(val(tile))
			yy.className = 'b-' + bucket(val(tile))
			right.append(pr, yy)
			main.append(mid, right)
			const list = document.createElement('ul')
			for (const c of sub.children ?? []) {
				const ct = c.data.tile!
				const li = document.createElement('li')
				if (c === n) li.className = 'is-on'
				const a = document.createElement('span')
				a.textContent = ct.name
				const b = document.createElement('span')
				b.textContent = priceText(ct)
				const d = document.createElement('span')
				d.textContent = val(ct) == null ? '–' : pct(val(ct))
				d.className = 'b-' + bucket(val(ct))
				li.append(a, b, d)
				list.append(li)
			}
			tip.append(head, main, list)
			tip.hidden = false
			const tw = tip.offsetWidth
			const th = tip.offsetHeight
			const x = sx + 18 + tw > W ? Math.max(4, sx - tw - 14) : sx + 18
			const y = Math.min(Math.max(4, sy - 20), Math.max(4, H - th - 4))
			tip.style.transform = `translate(${x}px, ${y}px)`
		}

		canvas.addEventListener('pointermove', (e) => {
			if (e.pointerType !== 'mouse' || e.buttons) return
			const { wx, wy, sx, sy } = at(e)
			const n = leafAt(wx, wy)
			canvas.style.cursor = n || headAt(wx, wy) ? 'pointer' : t.k > 1.001 ? 'grab' : 'default'
			if (n !== hover) {
				hover = n
				draw()
			}
			if (n) showTip(n, sx, sy)
			else tip.hidden = true
		})
		canvas.addEventListener('pointerleave', () => {
			hover = null
			tip.hidden = true
			draw()
		})

		// 누르기: 머리띠는 그 묶음으로 확대, 작은 칸은 소분류로 확대, 큰 칸은 시세 페이지
		canvas.addEventListener('click', (e) => {
			const { wx, wy } = at(e)
			const head = headAt(wx, wy)
			if (head) {
				fitTo(head)
				return
			}
			const n = leafAt(wx, wy)
			if (!n) return
			const sw = (n.x1 - n.x0) * t.k
			const sh = (n.y1 - n.y0) * t.k
			if (Math.min(sw, sh) < 60) {
				const sub = n.parent!
				const subBig = (sub.x1 - sub.x0) * t.k >= W * 0.9 || (sub.y1 - sub.y0) * t.k >= H * 0.9
				fitTo(subBig ? n : sub)
				return
			}
			window.location.href = `${prefix}/prices/${n.data.tile!.id}/`
		})

		box.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach((b) =>
			b.addEventListener('click', () => {
				const sel = select(canvas).transition().duration(300)
				if (b.dataset.zoom === 'reset') sel.call(z.transform, zoomIdentity)
				else sel.call(z.scaleBy, b.dataset.zoom === 'in' ? 1.7 : 1 / 1.7)
			})
		)

		// 어제와 비교 / 작년과 비교
		const legendLabel = box.querySelector<HTMLElement>('[data-legend-label]')!
		box.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) =>
			b.addEventListener('click', () => {
				mode = b.dataset.mode as Mode
				box
					.querySelectorAll<HTMLButtonElement>('[data-mode]')
					.forEach((o) => o.setAttribute('aria-pressed', String(o === b)))
				box
					.querySelectorAll<HTMLElement>('[data-mode-note]')
					.forEach((o) => (o.hidden = o.dataset.modeNote !== mode))
				legendLabel.textContent =
					mode === 'day' ? (isEn ? 'vs yesterday' : '어제보다') : isEn ? 'vs last year' : '작년보다'
				tip.hidden = true
				draw()
			})
		)

		new MutationObserver(draw).observe(document.documentElement, {
			attributes: true,
			attributeFilter: ['class']
		})
		new ResizeObserver(() => {
			if (stage.clientWidth !== W || stage.clientHeight !== H) resize()
		}).observe(stage)
		resize()
		box.classList.add('is-ready')
	}

	const initAll = () => document.querySelectorAll<HTMLElement>('[data-map]').forEach(initMap)
	if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initAll)
	else initAll()
	document.addEventListener('astro:page-load', initAll)
</script>

