	}

	/* 3D 무대: 본문 폭(760)보다 넓게, 화면 가장자리 여백은 남긴다 */
	.im-farm-stage {
		--w: min(1080px, calc(100vw - 2 * var(--gutter)));
		position: relative;
		width: var(--w);
		margin-left: calc((100% - var(--w)) / 2);
