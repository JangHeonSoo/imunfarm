	.im-farm-chips :global(.im-farm-chip[aria-pressed='true']) {
		background: var(--ink);
		color: var(--bg);
	}

	@media (hover: hover) {
		.im-farm-chips :global(.im-farm-chip[aria-pressed='false']:hover) {
