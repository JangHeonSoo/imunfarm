		inset: 12% 20%;
		width: 60%;
		height: 76%;
	}

	.im-farm-svg path {
		fill: var(--line);
		stroke: var(--ink);
		stroke-width: 0.4;
		vector-effect: non-scaling-stroke;
	}

	.im-farm-stage.is-3d .im-farm-svg {
		display: none;
	}

	.im-farm-tag,
	.im-farm-drag,
	.im-farm-busy {
		position: absolute;
		margin: 0;
		font-size: 12px;
		letter-spacing: 0.06em;
		pointer-events: none;
	}

	.im-farm-tag {
		top: 14px;
		left: 0;
		padding: 3px 8px;
		border: 1px solid var(--ink);
		font-weight: 700;
	}

	.im-farm-tag[hidden] {
		display: none;
	}

	.im-farm-drag {
		right: 0;
		bottom: 12px;
		color: var(--muted);
		transition: opacity 0.4s ease;
	}

	.im-farm-stage.is-touched .im-farm-drag,
	.im-farm-stage:not(.is-3d) .im-farm-drag {
		opacity: 0;
	}

	.im-farm-busy {
		inset: 0;
		display: grid;
		place-items: center;
		font-size: 15px;
		font-weight: 700;
		letter-spacing: 0;
		opacity: 0;
		transition: opacity 0.2s ease;
	}

	.im-farm-stage.is-busy .im-farm-busy {
		opacity: 1;
	}

	.im-farm-stage.is-busy :global(.im-farm-canvas),
	.im-farm-stage.is-busy .im-farm-svg {
		opacity: 0.18;
	}

	.im-farm-panel {
		padding: 18px 0 4px;
	}

	.im-farm-addr {
		margin: 0;
		font-size: clamp(18px, 2.2vw, 22px);
		font-weight: 800;
		line-height: 1.35;
		letter-spacing: -0.01em;
		overflow-wrap: anywhere;
	}

	.im-farm-facts {
		margin: 4px 0 0;
		font-size: 15px;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}

	.im-farm-note {
