	.im-farm-pick :global(a) {
		font-weight: 700;
		font-variant-numeric: tabular-nums;
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.im-farm-more {
		margin-top: 40px;
		border-top: 1px solid var(--ink);
