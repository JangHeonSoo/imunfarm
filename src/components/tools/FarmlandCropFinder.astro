---
/**
 * 땅 주소 → 내 땅 3D 미리보기와 맞는 작물. 주소·필지·토지특성은 브라우저(브이월드 JSONP), 팜맵·추천은 /api/farmland.
 * 화면은 3D 판 + 한 줄 정보 + 작물 버튼만. 검색엔진용 표·설명은 아래 접힌 칸에 서버에서 그린다.
 */
import ToolShell from '@/components/tools/ToolShell'
import { DEFAULT_LOCALE, getLocalePrefix } from '@/utils'
import {
	ITEMS,
	REGIONS,
	buildItemSeries,
	buildMarketQuotes,
	getPriceAsOfDate,
	getItemStatus
} from '@/data/prices'
import {
	FARMLAND_CROPS,
	ZONE_LABEL,
	monthRange,
	rankCrops,
	type Jimok
} from '@/data/farmland-crops'

const { locale = DEFAULT_LOCALE } = Astro.props
const isEn = locale === 'en'
const prefix = getLocalePrefix(locale)
const num = (v: number) => Math.round(v).toLocaleString(isEn ? 'en-US' : 'ko-KR')

// 작물별 최근 도매가 (서울 먼저, 없으면 조사된 다른 시장). 철이 지난 품목은 값 대신 링크만
const { quotes } = buildMarketQuotes(getPriceAsOfDate())
type PriceInfo = {
	price: number
	unit: string
	date: string
	region: string
	href: string
	/** 같은 시장 약 30일 전 조사값 대비 % */
	d30: number | null
	/** 작년 같은 달 평균 대비 이번 달 평균 % */
	y1: number | null
}
const prices: Record<string, PriceInfo | null> = {}
const pct = (now: number, then: number | undefined) =>
	then ? Math.round(((now - then) / then) * 1000) / 10 : null
for (const c of FARMLAND_CROPS) {
	const item = c.priceId ? ITEMS.find((i) => i.id === c.priceId) : null
	if (!item || getItemStatus(item).stale) {
		prices[c.id] = null
		continue
	}
	const region = REGIONS.find((r) => quotes[item.id]?.[r.id])
	const q = region ? quotes[item.id][region.id] : null
	if (!q || !region) {
		prices[c.id] = null
		continue
	}
	// 오르내림: 같은 시장의 약 30일 전 조사값, 작년 같은 달 평균
	const series = buildItemSeries(item)
	const daily = series.daily[region.id] ?? []
	const cut = new Date(new Date(q.date).getTime() - 30 * 864e5).toISOString().slice(0, 10)
	const before = [...daily].reverse().find(([d]) => d <= cut)?.[1]
	const monthly = new Map(series.monthly[region.id] ?? [])
	const ym = q.date.slice(0, 7)
	const lastYm = `${Number(ym.slice(0, 4)) - 1}${ym.slice(4)}`
	prices[c.id] = {
		price: q.price,
		unit: isEn ? item.unitEn : item.unitKo,
		date: q.date.replace(/-/g, '.'),
		region: isEn ? region.en : region.ko,
		href: `${prefix}/prices/${item.id}/`,
		d30: pct(q.price, before),
		y1: monthly.has(ym) ? pct(monthly.get(ym)!, monthly.get(lastYm)) : null
	}
}

// 지목별 대표 작물 표 (중부, 이번 달 기준). 검색엔진과 처음 온 사람용
const month = getPriceAsOfDate().getMonth() + 1
const cropName = (id: string) => {
	const c = FARMLAND_CROPS.find((x) => x.id === id)!
	return isEn ? c.en : c.ko
}
const byJimok = (['전', '답', '과수원'] as Jimok[]).map((j) => ({
	jimok: j,
	label: isEn ? { 전: 'Field (jeon)', 답: 'Paddy (dap)', 과수원: 'Orchard' }[j as '전'] : j,
	picks: rankCrops({ jimok: j, use: null, zone: 'central', month }, 6).map((p) => cropName(p.id))
}))

// 처음 화면의 예시 땅: 충남 서산시 운산면 여미리 1 (전 2,294㎡, 팜맵 밭). 경계는 무게중심 기준 미터 (localFrame 과 같은 계산)
const SAMPLE = {
	address: isEn
		? 'Yeomi-ri 1, Unsan-myeon, Seosan, South Chungcheong'
		: '충청남도 서산시 운산면 여미리 1',
	pnu: '4421038034100010000',
	jibun: '1전',
	zoning: isEn ? 'Planned management area' : '계획관리지역',
	// 토지특성 (브이월드 getLandCharacteristics, 2017 기준 조사)
	land: {
		terrain: '완경사',
		shape: '사다리형',
		road: '세로한면(가)',
		roadCode: '08',
		year: '2017'
	},
	jimok: '전',
	areaM2: 2294,
	farmUse: '밭',
	zone: 'central' as const,
	isFarmland: true,
	crops: rankCrops({ jimok: '전', use: '밭', zone: 'central', month }),
	ring: [
		[-31.1, 9.1],
		[-28.6, 13.4],
		[-23.9, 18.2],
		[-14.6, 23],
		[-6.5, 25.6],
		[-3.9, 26.3],
		[1.2, 27.7],
		[9.4, 24.9],
		[19.7, 18.9],
		[24.3, 12.6],
		[25, 4.8],
		[26.4, -3.9],
		[24, -7.4],
		[25.2, -11],
		[22.4, -17.8],
		[21.3, -18.6],
		[-2.6, -34.2],
		[-7.7, -28.3],
		[-16.5, -12.5],
		[-21.3, -7.2],
		[-25.9, -1.5],
		[-29.1, 3.9]
	] as [number, number][],
	// 변마다 바깥에 닿은 땅 (이웃 필지 지목으로 2026-10-12 확인: 서쪽 아래 변들이 구거 406구, 길에 닿은 변은 없음)
	tags: [...Array(16).fill(null), ...Array(6).fill('ditch')] as (
		| 'road'
		| 'ditch'
		| 'river'
		| null
	)[]
}

// 3D 가 뜨기 전(또는 WebGL 이 없을 때) 보이는 위에서 본 윤곽
const svgOf = (ring: [number, number][]) => {
	const xs = ring.map((p) => p[0])
	const ys = ring.map((p) => -p[1])
	const pad = 6
	const minX = Math.min(...xs) - pad
	const minY = Math.min(...ys) - pad
	const w = Math.max(...xs) - minX + pad
	const h = Math.max(...ys) - minY + pad
	return {
		viewBox: `${minX.toFixed(1)} ${minY.toFixed(1)} ${w.toFixed(1)} ${h.toFixed(1)}`,
		d: 'M' + ring.map(([x, y]) => `${x.toFixed(1)} ${(-y).toFixed(1)}`).join('L') + 'Z'
	}
}
const sampleSvg = svgOf(SAMPLE.ring)

const zoneShort = (z: keyof typeof ZONE_LABEL) =>
	(isEn ? ZONE_LABEL[z].en : ZONE_LABEL[z].ko).split(' (')[0]
const areaText = (m2: number) =>
	isEn ? `${num(m2 / 3.3058)} pyeong (${num(m2)} ㎡)` : `${num(m2 / 3.3058)}평 (${num(m2)}㎡)`
const sampleFacts = [
	SAMPLE.jimok,
	areaText(SAMPLE.areaM2),
	SAMPLE.farmUse,
	zoneShort(SAMPLE.zone)
].join(' · ')
const first = FARMLAND_CROPS.find((c) => c.id === SAMPLE.crops[0]?.id)

const title = isEn
	? 'Farmland Crop Finder: Check Land Category and What to Grow by Address'
	: '내 땅 지목 조회·농지 작물 추천: 주소만 넣으면 맞는 작물 찾기'
const description = isEn
	? 'Enter a Korean land address to see its land category (jimok), area and zoning, then crops that fit the land and climate, with planting months and today’s wholesale price.'
	: '땅 주소를 넣으면 지목(전·답·과수원)과 면적, 용도지역을 확인하고 그 땅과 지역 기후에 맞는 작물을 추천합니다. 심는 시기와 오늘 도매 시세까지 함께 봅니다.'

const faq = isEn
	? [
			{
				q: 'Where does the land information come from?',
				a: 'Land category, area and zoning come from the national cadastral and land characteristics data published through VWorld (Ministry of Land). Actual use (paddy, field, orchard, greenhouse) comes from the FarmMap of the Ministry of Agriculture.'
			},
			{
				q: 'Does it check the soil?',
				a: 'No. Soil fitness by parcel is published by the RDA on Heuktoram (soil.rda.go.kr). Look up the same address there before you plant.'
			},
			{
				q: 'Can I farm land that is not jeon, dap or orchard?',
				a: 'Building land (dae) or forest (imya) usually needs a change of use permit before it can be farmed or built on. Ask the city or county office.'
			}
		]
	: [
			{
				q: '내 땅 지목은 어떻게 조회하나요?',
				a: '위 칸에 지번 주소(예: ○○군 ○○면 ○○리 123)나 도로명 주소를 넣으면 국토교통부 연속지적도와 토지특성 자료로 지목, 면적, 용도지역을 보여 드립니다. 정식 서류가 필요하면 토지대장이나 토지이용계획확인서를 정부24에서 떼어 보세요.'
			},
			{
				q: '추천 작물은 어떤 기준으로 고르나요?',
				a: '지목(전·답·과수원)과 기후대에 맞는 작물 가운데 농촌진흥청 농산물소득자료집의 10a당 소득이 가장 높은 작물을 고릅니다. 흙의 성질은 반영하지 않으니 흙토람에서 같은 주소의 토양 적성도 꼭 확인해 보세요.'
			},
			{
				q: '논(답)에 밭작물을 심어도 되나요?',
				a: '농지 안에서 작물을 바꾸는 것은 대체로 가능합니다. 다만 논은 물이 잘 안 빠져서 콩·들깨 같은 밭작물을 심으려면 배수로를 내고 이랑을 높여야 합니다.'
			},
			{
				q: '지목이 대지나 임야인 땅에서도 농사를 지을 수 있나요?',
				a: '임야나 대지를 농지처럼 쓰거나 시설을 지으려면 용도 변경이나 허가가 필요한 경우가 많습니다. 시·군청 농지·산림 담당 부서에 먼저 확인하세요.'
			}
		]

const related = [
	{
		href: `${prefix}/prices/`,
		title: isEn ? 'Today’s wholesale prices' : '오늘 농산물 도매 시세',
		sub: isEn ? 'See what each crop sells for' : '추천 작물이 지금 얼마에 팔리는지'
	},
	{
		href: `${prefix}/support/`,
		title: isEn ? 'Farm support programmes' : '농업 지원사업 모음',
		sub: undefined
	},
	{
		href: `${prefix}/blog/farm-shed-mobile-home-price-2026/`,
		title: isEn ? 'Farm sheds and mobile homes 2026' : '농막·이동식 주택 가격 2026',
		sub: undefined
	}
]

const data = {
	isEn,
	prefix,
	crops: FARMLAND_CROPS,
	prices,
	zones: ZONE_LABEL,
	sample: SAMPLE
}
---

<ToolShell
	locale={locale}
	title={title}
	description={description}
	h1={isEn ? 'What to grow on my land' : '내 땅에 맞는 작물 찾기'}
	lede={isEn
		? 'Enter an address. We pick the most profitable crop for the plot, lay out the buildings it needs at proper spacing and show it all in 3D.'
		: '주소를 넣으면 이 땅에 가장 효율적인 작물을 고르고, 필요한 시설을 알맞은 간격으로 배치해 3D로 보여 드립니다.'}
	basis={isEn ? 'Cadastral data · FarmMap' : '연속지적도·토지특성·팜맵 기준'}
	faq={faq}
	related={related}
	path='/tools/farmland-crop-finder/'
	active='land'
>
	<form class='im-farm-search' id='im-farm-form' role='search'>
		<input
			id='im-farm-address'
			name='address'
			type='search'
			autocomplete='street-address'
			enterkeyhint='search'
			minlength='4'
			maxlength='120'
			required
			placeholder={isEn ? 'Land address' : '땅 주소'}
			aria-label={isEn ? 'Land address' : '땅 주소'}
		/>
		<p class='im-farm-hint'>
			{
				isEn
					? 'Lot address works best, e.g. 서산시 운산면 여미리 1'
					: '지번 주소가 가장 정확합니다. 예) 서산시 운산면 여미리 1'
			}
		</p>
		<button type='submit' class='im-farm-go'>{isEn ? 'Look up →' : '조회하기 →'}</button>
	</form>
	<p class='im-farm-error' id='im-farm-error' role='alert' hidden></p>

	<section class='im-farm-view' id='im-farm-view' aria-live='polite'>
		<div class='im-farm-stage' id='im-farm-stage'>
			<svg class='im-farm-svg' viewBox={sampleSvg.viewBox} aria-hidden='true'>
				<path d={sampleSvg.d}></path>
			</svg>
			<p class='im-farm-tag' id='im-farm-tag'>{isEn ? 'Example' : '예시'}</p>
			<p class='im-farm-drag' aria-hidden='true'>{isEn ? 'Drag to turn' : '끌어서 돌려 보기'}</p>
			<p class='im-farm-busy' id='im-farm-busy'>{isEn ? 'Looking up…' : '찾는 중입니다…'}</p>
		</div>

		<div class='im-farm-panel'>
			<p class='im-farm-addr' id='im-farm-addr'>{SAMPLE.address}</p>
			<p class='im-farm-facts' id='im-farm-facts'>{sampleFacts}</p>
			<p class='im-farm-note' id='im-farm-note' hidden></p>

			<div
				class='im-farm-modes'
				id='im-farm-modes'
				role='radiogroup'
				aria-label={isEn ? 'How to farm' : '농사 방식'}
			>
				{
					(
						[
							['field', '노지 밭', 'Open field'],
							['house', '비닐하우스', 'Tunnel house'],
							['smart', '스마트팜', 'Smart farm']
						] as const
					).map(([m, ko, en]) => (
						<button type='button' role='radio' aria-checked='false' data-mode={m}>
							<b>{isEn ? en : ko}</b>
							<span>–</span>
						</button>
					))
				}
			</div>

			<div class='im-farm-best'>
				<p class='im-label' id='im-farm-best-label'>
					{isEn ? 'Most profitable crop here' : '이 땅에 가장 효율적인 작물'}
				</p>
				<p class='im-farm-best-name' id='im-farm-best-name'>{first ? cropName(first.id) : '–'}</p>
				<p class='im-farm-best-reason' id='im-farm-best-reason'></p>
				<div class='im-farm-spec' id='im-farm-spec'></div>
				<p class='im-farm-src' id='im-farm-src' hidden></p>
				<div class='im-farm-mix' id='im-farm-mix' hidden>
					<label>
						<span id='im-farm-mix-label'></span>
						<select id='im-farm-mix-sel'></select>
					</label>
					<p class='im-farm-mix-sum' id='im-farm-mix-sum'></p>
				</div>
			</div>

			<div class='im-farm-rank'>
				<p class='im-label'>
					{
						isEn
							? 'Crops for this plot · bar = income per 10a · right = this plot, a year'
							: '이 땅에 심을 수 있는 작물 · 막대는 10a당 소득, 오른쪽은 이 땅 한 해 예상'
					}
				</p>
				<ol id='im-farm-rank'></ol>
				<div class='im-farm-rank-tools'>
					<button type='button' class='im-farm-rank-more' id='im-farm-rank-more' hidden></button>
					<label class='im-farm-add'>
						<span>{isEn ? 'Add a crop' : '작물 추가해서 보기'}</span>
						<select id='im-farm-add'>
							<option value=''>{isEn ? 'Choose…' : '고르기…'}</option>
						</select>
					</label>
				</div>
				<p class='im-farm-rank-none' id='im-farm-rank-none' hidden></p>
			</div>

			<p class='im-farm-foot'>
				<span>{isEn ? 'Drag a building to move it.' : '시설은 끌어서 옮길 수 있습니다.'}</span>
				<button type='button' id='im-farm-auto'>{isEn ? 'Reset layout' : '처음 배치로'}</button>
				<button type='button' id='im-farm-pdf'>{isEn ? 'Download PDF' : 'PDF로 받기'}</button>
			</p>
			<p class='im-farm-approx' id='im-farm-approx'></p>
		</div>
	</section>

	<details class='im-farm-more'>
		<summary
			>{
				isEn ? 'Planting months and wholesale prices by crop' : '작물별 심는 시기·도매가 보기'
			}</summary
		>

		<section class='im-tool-section'>
			<h2 class='im-label'>
				{
					isEn
						? 'Typical crops by land category (central region)'
						: '지목별 많이 고르는 작물 (중부 기준)'
				}
			</h2>
			<table class='im-tool-table im-farm-jimok'>
				<thead>
					<tr>
						<th>{isEn ? 'Land' : '지목'}</th>
						<th>{isEn ? 'Crops that fit' : '맞는 작물'}</th>
					</tr>
				</thead>
				<tbody>
					{
						byJimok.map((r) => (
							<tr>
								<td>{r.label}</td>
								<td>{r.picks.join(', ')}</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</section>

		<section class='im-tool-section'>
			<h2 class='im-label'>{isEn ? 'Planting calendar' : '작물별 심는 때와 거두는 때'}</h2>
			<table class='im-tool-table'>
				<thead>
					<tr>
						<th>{isEn ? 'Crop' : '작물'}</th>
						<th>{isEn ? 'Plant' : '심기'}</th>
						<th>{isEn ? 'Harvest' : '수확'}</th>
						<th class='is-hide-sm'>{isEn ? 'Wholesale' : '도매 시세'}</th>
					</tr>
				</thead>
				<tbody>
					{
						FARMLAND_CROPS.map((c) => {
							const p = prices[c.id]
							return (
								<tr>
									<td>
										{c.priceId ? (
											<a class='im-inline' href={`${prefix}/prices/${c.priceId}/`}>
												{isEn ? c.en : c.ko}
											</a>
										) : isEn ? (
											c.en
										) : (
											c.ko
										)}
									</td>
									<td>{monthRange(c.plant, isEn)}</td>
									<td>
										{c.years
											? isEn
												? `${monthRange(c.harvest, true)}, from year ${c.years}`
												: `심고 ${c.years}년 뒤부터 ${monthRange(c.harvest, false)}`
											: c.nextYear
												? isEn
													? `${monthRange(c.harvest, true)} next year`
													: `이듬해 ${monthRange(c.harvest, false)}`
												: monthRange(c.harvest, isEn)}
									</td>
									<td class='is-hide-sm'>
										{p
											? isEn
												? `₩${num(p.price)} / ${p.unit}`
												: `${p.unit} ${num(p.price)}원`
											: '–'}
									</td>
								</tr>
							)
						})
					}
				</tbody>
			</table>
			<p class='im-farm-small'>
				{
					isEn
						? 'Months are general guides from the Rural Development Administration (Nongsaro) and move a few weeks by region and cultivar.'
						: '시기는 농촌진흥청 농사로의 일반 기준이며, 지역과 품종에 따라 몇 주씩 앞뒤로 달라집니다.'
				}
			</p>
		</section>

		<section class='im-tool-section'>
			<h2 class='im-label'>{isEn ? 'Before you plant' : '심기 전에 꼭 확인할 것'}</h2>
			<p>
				{
					isEn
						? 'This is a reference, not an official land survey or soil test. The 3D view is a model of the parcel outline, not a design drawing. '
						: '이 결과는 참고용이며 정식 토지 서류나 토양 검사를 대신하지 않습니다. 3D 화면은 필지 경계로 만든 모형이며 설계 도면이 아닙니다. '
				}
				{
					isEn
						? 'Check the soil of the same parcel on '
						: '같은 주소의 흙 성질과 작물별 토양 적성은 '
				}
				<a class='im-inline' href='https://soil.rda.go.kr/' target='_blank' rel='noopener'
					>{isEn ? 'Heuktoram (RDA)' : '농촌진흥청 흙토람'}</a
				>
				{isEn ? ', and ask the ' : '에서 확인하세요. 농지 취득, 용도 변경, 비닐하우스·농막 설치는 '}
				<a class='im-inline' href='https://www.gov.kr/' target='_blank' rel='noopener'
					>{isEn ? 'city or county office (Gov24)' : '시·군청 농지 담당 부서(정부24)'}</a
				>
				{
					isEn
						? ' about farmland rules, change of use and installing greenhouses or sheds.'
						: '에 먼저 문의하세요.'
				}
			</p>
		</section>
	</details>

	<script type='application/json' id='im-farm-data' set:html={JSON.stringify(data)} />
</ToolShell>

<script>
	import {
		cropMode,
		monthRange,
		type CropRule,
		type CropPick,
		type FarmMode,
		type Zone
	} from '@/data/farmland-crops'
	import {
		geocode,
		landFacts,
		neighboursOf,
		parcelAt,
		polygonAreaM2,
		vworldReady
	} from '@/data/farmland-vworld'
	import {
		HOUSE_GAP,
		KINDS,
		autoLayout,
		classifyEdges,
		computePlan,
		decodeLayout,
		encodeLayout,
		exportPlan,
		localFrame,
		makeSite,
		tagOfJibun,
		type EdgeTag,
		type Layout,
		type Plan,
		type Site
	} from '@/data/farmland-layout'
	import type { CropSpacing, FieldView, Ring } from './farmland-3d'
	import { BUILD_COST, payback } from '@/data/farmland-cost'

	type Price = {
		price: number
		unit: string
		date: string
		region: string
		href: string
		d30: number | null
		y1: number | null
	} | null
	type View = {
		address: string
		jimok: string | null
		areaM2: number | null
		areaEstimated?: boolean
		farmUse: string | null
		landUse?: string | null
		zone: Zone
		isFarmland: boolean
		crops: CropPick[]
		refined?: string | null
		fixture?: boolean
		pnu?: string | null
		jibun?: string | null
		zoning?: string | null
		/** 토지특성의 땅 모양·높낮이·도로 (브라우저 조회 값) */
		land?: {
			terrain: string | null
			shape: string | null
			road: string | null
			roadCode: string | null
			year: string | null
		} | null
	}
	type Data = {
		isEn: boolean
		prefix: string
		crops: CropRule[]
		prices: Record<string, Price>
		zones: Record<Zone, { ko: string; en: string }>
		sample: View & { ring: Ring; tags: EdgeTag[] }
	}

	const D = JSON.parse(document.getElementById('im-farm-data')!.textContent || '{}') as Data
	const isEn = D.isEn
	const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T
	const form = $<HTMLFormElement>('im-farm-form')
	const input = $<HTMLInputElement>('im-farm-address')
	const errorEl = $('im-farm-error')
	const stage = $('im-farm-stage')
	const tag = $('im-farm-tag')
	const addrEl = $('im-farm-addr')
	const factsEl = $('im-farm-facts')
	const noteEl = $('im-farm-note')
	const num = (v: number) => Math.round(v).toLocaleString(isEn ? 'en-US' : 'ko-KR')
	const L = (ko: string, en: string) => (isEn ? en : ko)

	const ERR: Record<string, [string, string]> = {
		address: [
			'주소를 4자에서 120자 사이로 입력해 주세요.',
			'Enter an address of 4 to 120 characters.'
		],
		'not-found': [
			'주소를 찾지 못했습니다. 시·군·읍면·리와 번지까지 넣어 보세요.',
			'Address not found. Include the county, township, village and lot number.'
		],
		'no-parcel': ['이 주소의 필지 정보를 찾지 못했습니다.', 'No parcel found at this address.'],
		unavailable: [
			'지금은 조회 준비 중입니다. 잠시 뒤에 다시 시도해 주세요.',
			'Lookup is not available yet. Please try again later.'
		],
		upstream: [
			'토지 정보 서버가 응답하지 않습니다. 잠시 뒤에 다시 시도해 주세요.',
			'The land data service did not respond. Please try again later.'
		]
	}
	const err = (k: string) => L(...(ERR[k] ?? ERR.upstream))

	// ── 3D ──────────────────────────────────────────────
	let view: FieldView | null = null
	let mod: Promise<typeof import('./farmland-3d')> | null = null
	const load = () => (mod ??= import('./farmland-3d'))
	let ring: Ring = D.sample.ring

	async function show(r: Ring, crop: string | null) {
		ring = r
		drawSvg(r)
		try {
			const m = await load()
			if (!view) {
				view = m.createFieldView(stage)
				stage.classList.add('is-3d')
			}
			view.setParcel(r)
			view.setCrop(crop, spacingOf(cropOf(crop)))
			view.onPlan(planHandlers)
		} catch {
			// WebGL 이 없으면 위에서 본 윤곽(svg)만 남는다
			stage.classList.remove('is-3d')
		}
		refreshPlan()
	}

	function drawSvg(r: Ring) {
		const svg = stage.querySelector('svg')!
		const xs = r.map((p) => p[0])
		const ys = r.map((p) => -p[1])
		const pad = Math.max(4, (Math.max(...xs) - Math.min(...xs)) * 0.08)
		const minX = Math.min(...xs) - pad
		const minY = Math.min(...ys) - pad
		svg.setAttribute(
			'viewBox',
			`${minX} ${minY} ${Math.max(...xs) - minX + pad} ${Math.max(...ys) - minY + pad}`
		)
		svg
			.querySelector('path')!
			.setAttribute('d', 'M' + r.map(([x, y]) => `${x} ${-y}`).join('L') + 'Z')
	}

	// ── 추천 작물·시설 ───────────────────────────────────
	// 화면은 셋뿐: 가장 효율적인 작물 1개, 그 작물에 맞춘 자동 배치, 3D 둘러보기
	let crop: string | null = null
	const bestName = $('im-farm-best-name')
	const bestReason = $('im-farm-best-reason')
	const specEl = $('im-farm-spec')
	const srcEl = $('im-farm-src')
	/** 심는 간격 한 줄 (PDF 용) */
	let specLine: string | null = null
	/** 설치비·땅 조건 안내 문장 (화면 아래·PDF) */
	let costNotes: string[] = []
	/** PDF 에 그대로 옮길 표 (설치비·땅 조건) */
	let specGroups: { title: string; rows: Row[] }[] = []
	// 나눠 짓기: 하우스·온실 밖 남은 밭(통로 뺀 덩어리)에 노지 작물을 함께 심는다
	const mixEl = $('im-farm-mix')
	const mixLabel = $('im-farm-mix-label')
	const mixSel = $<HTMLSelectElement>('im-farm-mix-sel')
	const mixSum = $('im-farm-mix-sum')
	let sideId: string | null = null
	/** PDF 용 나눠 짓기 요약 */
	let mixInfo: {
		name: string
		area: number
		yearly: number | null
		spacing: string | null
	} | null = null
	mixSel.addEventListener('change', () => {
		sideId = mixSel.value || null
		view?.setSide(sideId, spacingOf(cropOf(sideId)))
		renderMix()
	})
	const zonesArea = () => (plan ? plan.zones.reduce((a, z) => a + z.area, 0) : 0)

	function renderMix() {
		const area = zonesArea()
		const main = cropOf(crop)
		const show = mode !== 'field' && !!main && area >= 30
		mixEl.hidden = !show
		mixInfo = null
		if (!show) return
		const yearly = (c: CropRule | null, a: number) => (c?.income ? (c.income.won * a) / 1000 : null)
		mixLabel.textContent = L(
			`남은 밭 ${pyeong(area)}에 함께 심기`,
			`Also plant the open ${num(area)} ㎡`
		)
		const fieldCrops = picks.filter((c) => cropMode(c) === 'field')
		mixSel.replaceChildren(
			new Option(L('안 심음', 'Nothing'), ''),
			...fieldCrops.map((c) => {
				const y = yearly(c, area)
				return new Option(
					`${nameOf(c)}${y ? L(` · 약 ${money(y)}`, ` · ≈ ${money(y)}`) : ''}`,
					c.id
				)
			})
		)
		if (sideId && !fieldCrops.some((c) => c.id === sideId)) sideId = null
		mixSel.value = sideId ?? ''
		const side = cropOf(sideId)
		if (!side) {
			mixSum.textContent = L(
				'하우스·온실 사이 통로는 빼고, 이어진 밭 덩어리만 셉니다.',
				'Paths between houses are left out; only connected open ground counts.'
			)
			return
		}
		const a = yearly(main, growOf(mode, plan!))
		const b = yearly(side, area)
		const sp = spacingRows(side, area)
			.map(([k, v]) => `${k} ${v}`)
			.join(' · ')
		mixInfo = { name: nameOf(side), area, yearly: b, spacing: sp || null }
		const total = document.createElement('b')
		total.textContent = L(
			`${nameOf(main!)} 약 ${a ? money(a) : '–'} + ${nameOf(side)} 약 ${b ? money(b) : '–'} = 한 해 합계 약 ${money((a ?? 0) + (b ?? 0))}`,
			`${nameOf(main!)} ≈ ${a ? money(a) : '–'} + ${nameOf(side)} ≈ ${b ? money(b) : '–'} = ≈ ${money((a ?? 0) + (b ?? 0))} a year`
		)
		const how = document.createElement('small')
		how.textContent = sp ? L(`${nameOf(side)} 심는 간격: ${sp}`, `${nameOf(side)}: ${sp}`) : ''
		mixSum.replaceChildren(total, how)
	}
	const modesEl = $('im-farm-modes')
	const rankEl = $('im-farm-rank')
	const rankNone = $('im-farm-rank-none')
	const rankMore = $<HTMLButtonElement>('im-farm-rank-more')
	const addSel = $<HTMLSelectElement>('im-farm-add')
	/** 내가 표에 더한 작물 (이 땅에 덜 맞는 작물도 넣을 수 있다) */
	const added: string[] = []
	addSel.addEventListener('change', () => {
		const id = addSel.value
		addSel.value = ''
		if (id && !added.includes(id)) added.push(id)
		renderRank()
	})
	/** 작물 표는 처음엔 위 8개만 (고른 작물이 아래에 있으면 그것까지) */
	const RANK_TOP = 8
	let rankAll = false
	rankMore.addEventListener('click', () => {
		rankAll = !rankAll
		renderRank()
	})
	const busyEl = $('im-farm-busy')
	const approxEl = $('im-farm-approx')

	let site: Site = makeSite(D.sample.ring, D.sample.tags)
	let layout: Layout = { pieces: [], well: null, outlet: null }
	let pending: Layout | null = null
	let plan: Plan | null = null
	let sel: number | null = null

	const cropOf = (id: string | null) => D.crops.find((x) => x.id === id) ?? null
	const nameOf = (c: CropRule) => (isEn ? c.en : c.ko)
	const pyeong = (m2: number) => L(`${num(m2 / 3.3058)}평`, `${num(m2)} ㎡`)
	const m1 = (v: number) => (Math.round(v * 10) / 10).toLocaleString(isEn ? 'en-US' : 'ko-KR')
	/** 만 원 단위 (EN 은 백만 원) */
	/** 만 원 단위, 1억 넘으면 '3억 4,560만 원' (EN 은 백만 원) */
	const money = (won: number) => {
		if (isEn) return `₩${(won / 1e6).toFixed(1)}M`
		const man = Math.round(won / 1e4)
		if (man < 10000) return `${num(man)}만 원`
		const eok = Math.floor(man / 10000)
		const rest = man % 10000
		return rest ? `${eok}억 ${num(rest)}만 원` : `${eok}억 원`
	}

	/** 긴 변 방향으로 잰 가로 × 세로 (m, 긴 쪽 먼저) */
	function dims(r: Ring, theta: number) {
		const c = Math.cos(-theta)
		const sn = Math.sin(-theta)
		const us = r.map(([x, y]) => x * c - y * sn)
		const vs = r.map(([x, y]) => x * sn + y * c)
		const a = Math.max(...us) - Math.min(...us)
		const b = Math.max(...vs) - Math.min(...vs)
		return a >= b ? [a, b] : [b, a]
	}

	function season(c: CropRule) {
		const plant = monthRange(c.plant, isEn)
		const h = monthRange(c.harvest, isEn)
		const harvest = c.years
			? L(`심고 ${c.years}년 뒤부터 ${h}`, `${h}, from year ${c.years}`)
			: c.nextYear
				? L(`이듬해 ${h}`, `${h} next year`)
				: h
		return L(`심기 ${plant} · 수확 ${harvest}`, `Plant ${plant} · Harvest ${harvest}`)
	}

	// 농사 방식: 노지 밭·비닐하우스·스마트팜. 방식마다 그 방식에 맞는 작물 중 10a당 소득 1위를 심는다
	let mode: FarmMode = 'house'
	/** 이 땅에 맞는 작물 (소득 높은 순) */
	let picks: CropRule[] = []
	/** 방식별 자동 배치 (땅이 바뀌면 비운다) */
	let layouts: Partial<Record<FarmMode, Layout>> = {}
	const MODE_NAME: Record<FarmMode, [string, string]> = {
		field: ['노지 밭', 'open field'],
		house: ['비닐하우스', 'tunnel house'],
		smart: ['스마트팜', 'smart farm']
	}
	const modeName = (m: FarmMode) => L(...MODE_NAME[m])
	const bestFor = (m: FarmMode) => picks.find((c) => cropMode(c) === m) ?? null
	const layoutFor = (m: FarmMode) => (layouts[m] ??= autoLayout(site, { mode: m }))
	/** 하우스·온실 작물은 그 안 넓이, 밭 작물은 시설을 뺀 밭 넓이에 심는다고 본다 */
	const growOf = (m: FarmMode, p: Plan) => (m === 'field' ? p.totals.field : p.totals.greenhouse)

	/** 농사로 표준 재식거리(cm) → 3D 용 m */
	function spacingOf(c: CropRule | null): CropSpacing | null {
		const sp = c?.spacing
		if (!sp) return null
		// 범위면 가운데 값으로 그린다
		const mid = (a: number, b?: number) => (b === undefined ? a : (a + b) / 2) / 100
		const pitch = mid(sp.pitch, sp.pitchTo)
		const bed = sp.bed ? sp.bed / 100 : sp.ridge ? pitch * 0.7 : null
		return {
			pitch,
			bed,
			lines: sp.lines,
			// 줄 사이가 없으면 두둑(없으면 이랑)의 8할 안에 고르게
			lineGap: sp.lineGap ? sp.lineGap / 100 : ((bed ?? pitch) * 0.8) / sp.lines,
			step: mid(sp.step, sp.stepTo),
			// 3D 글씨는 간격만 (포기 수 줄은 빼고)
			label: spacingRows(c!, 0)
				.filter(([k]) => k !== L('10a당', 'Per 10a') && k !== L('이 배치', 'This layout'))
				.slice(0, 3)
				.map(([k, v]) => `${k} ${v}`)
				.join(' · ')
		}
	}

	function mark(id: string | null) {
		crop = id
		for (const b of rankEl.querySelectorAll<HTMLButtonElement>('button'))
			b.setAttribute('aria-pressed', String(b.dataset.id === id))
		const c = cropOf(id)
		bestName.textContent = c ? nameOf(c) : '–'
	}

	/** 방식 버튼마다 그 방식 1위 작물로 이 땅에서 한 해 얼마인지 */
	function renderModes() {
		for (const b of modesEl.querySelectorAll<HTMLButtonElement>('button[data-mode]')) {
			const m = b.dataset.mode as FarmMode
			b.setAttribute('aria-checked', String(m === mode))
			const c = bestFor(m)
			const span = b.querySelector('span')!
			if (!c) {
				span.textContent = L('맞는 작물 없음', 'no crop fits')
				continue
			}
			const p = computePlan(site, layoutFor(m))
			const grow = growOf(m, p)
			span.textContent =
				c.income && grow > 0
					? L(
							`${nameOf(c)} · 한 해 약 ${money((c.income.won * grow) / 1000)}`,
							`${nameOf(c)} · ≈ ${money((c.income.won * grow) / 1000)}/yr`
						)
					: nameOf(c)
		}
	}

	/** 작물 표: 맞는 작물을 10a당 소득 막대로. 누르면 그 작물·방식으로 다시 배치 */
	/** 이 땅에서 그 작물의 방식대로 배치했을 때 한 해 예상 소득 (원) */
	function yearlyOf(c: CropRule) {
		if (!c.income) return null
		const m = cropMode(c)
		const grow = growOf(m, computePlan(site, layoutFor(m)))
		return grow > 0 ? (c.income.won * grow) / 1000 : null
	}

	function renderRank() {
		const withIncome = picks.filter((c) => c.income)
		const top = rankAll ? withIncome : withIncome.filter((c, i) => i < RANK_TOP || c.id === crop)
		const extra = added
			.map((id) => cropOf(id))
			.filter((c): c is CropRule => !!c && !top.includes(c))
		const rows = [...top, ...extra]
		const max = Math.max(1, ...rows.map((c) => c.income?.won ?? 0))
		rankMore.hidden = withIncome.length <= RANK_TOP
		rankMore.textContent = rankAll
			? L('위 8개만 보기', 'Show top 8')
			: L(`작물 ${withIncome.length}개 모두 보기`, `Show all ${withIncome.length} crops`)
		const fits = new Set(picks.map((c) => c.id))
		rankEl.replaceChildren(
			...rows.map((c) => {
				const li = document.createElement('li')
				const b = document.createElement('button')
				b.type = 'button'
				b.dataset.id = c.id
				b.setAttribute('aria-pressed', String(c.id === crop))
				const name = document.createElement('span')
				name.className = 'n'
				name.textContent = nameOf(c)
				const m = document.createElement('small')
				m.textContent = fits.has(c.id)
					? modeName(cropMode(c))
					: L(`${modeName(cropMode(c))} · 이 땅엔 덜 맞음`, `${modeName(cropMode(c))} · weak fit`)
				name.append(m)
				const bar = document.createElement('span')
				bar.className = 'b'
				const fillEl = document.createElement('i')
				fillEl.style.width = c.income ? `${Math.max(2, (c.income.won / max) * 100)}%` : '0'
				bar.append(fillEl)
				const val = document.createElement('span')
				val.className = 'v'
				const yr = yearlyOf(c)
				const big = document.createElement('b')
				big.textContent = yr
					? L(`약 ${money(yr)}`, `≈ ${money(yr)}`)
					: L('소득 자료 없음', 'no income data')
				val.append(big)
				if (c.income) {
					const per = document.createElement('small')
					per.textContent = L(`10a당 ${money(c.income.won)}`, `${money(c.income.won)} per 10a`)
					val.append(per)
				}
				b.append(name, bar, val)
				li.append(b)
				if (extra.includes(c)) {
					const x = document.createElement('button')
					x.type = 'button'
					x.className = 'x'
					x.dataset.remove = c.id
					x.setAttribute('aria-label', L(`${nameOf(c)} 빼기`, `Remove ${nameOf(c)}`))
					x.textContent = '×'
					li.append(x)
				}
				return li
			})
		)
		// 추가 목록: 표에 없는 작물 전부 (이 땅에 맞는 작물 먼저, 소득 높은 순)
		const inTable = new Set(rows.map((c) => c.id))
		const rest = D.crops.filter((c) => !inTable.has(c.id))
		rest.sort(
			(a, b) =>
				Number(fits.has(b.id)) - Number(fits.has(a.id)) ||
				(b.income?.won ?? 0) - (a.income?.won ?? 0)
		)
		addSel.replaceChildren(
			new Option(L('고르기…', 'Choose…'), ''),
			...rest.map(
				(c) =>
					new Option(
						`${nameOf(c)} · ${modeName(cropMode(c))}${fits.has(c.id) ? '' : L(' (덜 맞음)', ' (weak fit)')}`,
						c.id
					)
			)
		)
		const none = picks.filter((c) => !c.income && !inTable.has(c.id))
		rankNone.hidden = !none.length
		rankNone.textContent = L(
			`소득 자료가 없는 작물: ${none.map(nameOf).join(' · ')}`,
			`No income data: ${none.map(nameOf).join(' · ')}`
		)
	}

	/** 방식을 바꾸면 잠깐 "배치하는 중"을 띄우고 그 방식에 맞게 다시 세팅한다 */
	let switching = 0
	async function setMode(m: FarmMode, cropId?: string | null) {
		const ticket = ++switching
		const keepBusy = busyEl.textContent
		busyEl.textContent = L(`${modeName(m)}로 배치하는 중입니다…`, `Laying out for ${modeName(m)}…`)
		stage.classList.add('is-busy', 'is-switching')
		const started = performance.now()
		// 오버레이가 먼저 그려지게 한 프레임 쉰다
		await new Promise((r) => requestAnimationFrame(() => setTimeout(r, 0)))
		mode = m
		if (m === 'field' && sideId) {
			sideId = null
			view?.setSide(null)
		}
		const id = cropId ?? bestFor(m)?.id ?? null
		mark(id)
		layout = structuredClone(layoutFor(m))
		sel = null
		view?.setCrop(id, spacingOf(cropOf(id)))
		refreshPlan()
		renderModes()
		renderRank()
		// 너무 빨리 끝나도 바뀐 것이 보이게 잠깐 둔다
		const wait = Math.max(0, 550 - (performance.now() - started))
		await new Promise((r) => setTimeout(r, wait))
		if (ticket !== switching) return
		stage.classList.remove('is-busy', 'is-switching')
		busyEl.textContent = keepBusy
	}

	/** 작물을 고르면 그 작물의 방식으로 다시 배치한다 */
	function choose(id: string | null) {
		const c = cropOf(id)
		setMode(c ? cropMode(c) : mode, id)
	}

	modesEl.addEventListener('click', (e) => {
		const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-mode]')
		if (b && b.dataset.mode !== mode) setMode(b.dataset.mode as FarmMode)
	})
	rankEl.addEventListener('click', (e) => {
		const x = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-remove]')
		if (x) {
			added.splice(added.indexOf(x.dataset.remove!), 1)
			renderRank()
			return
		}
		const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-id]')
		if (b && b.dataset.id !== crop) choose(b.dataset.id!)
	})

	function refreshPlan(light = false) {
		plan = computePlan(site, layout)
		view?.setPlan(plan, { edit: true, selected: sel, light })
		updateCard()
		if (!light)
			saveHash()
			// 3단계(배치도 PDF)가 읽을 자료
		;(window as unknown as { imunFarmPlan?: unknown }).imunFarmPlan = exportPlan(site, plan)
	}

	type Row = [string, string, string?]
	// 2m 밑은 cm 로 (이랑 120cm · 두둑 90cm 처럼 한 단위로 읽히게), 나무 간격처럼 큰 값은 m
	const cmTxt = (v: number) => (v >= 200 ? `${m1(v / 100)}m` : `${v}cm`)
	const rng = (a: number, b?: number) =>
		b === undefined
			? cmTxt(a)
			: a >= 200 || b > 200
				? `${m1(a / 100)}–${m1(b / 100)}m`
				: `${a}–${b}cm`
	const isTree = (c: CropRule) => !!c.years

	/** 심는 간격 표 (농사로 표준 재식거리). grow = 이 배치에서 심는 넓이 ㎡ */
	function spacingRows(c: CropRule, grow: number): Row[] {
		const sp = c.spacing
		if (!sp) return []
		const rows: Row[] = []
		const tree = isTree(c)
		if (sp.text) rows.push([L('심는 방법', 'Layout'), L(sp.text.ko, sp.text.en)])
		else if (tree) {
			rows.push([L('줄 사이', 'Between rows'), rng(sp.pitch, sp.pitchTo)])
			rows.push([L('나무 사이', 'Between trees'), rng(sp.step, sp.stepTo)])
		} else {
			if (sp.bed) {
				rows.push([L('이랑 너비', 'Ridge pitch'), cmTxt(sp.pitch)])
				rows.push([
					L('두둑 · 고랑', 'Bed · furrow'),
					`${cmTxt(sp.bed)} · ${cmTxt(sp.pitch - sp.bed)}`
				])
			} else
				rows.push([
					sp.ridge ? L('이랑 너비', 'Ridge pitch') : L('줄 사이', 'Between rows'),
					rng(sp.pitch, sp.pitchTo)
				])
			if (sp.lines > 1)
				rows.push([
					L('한 이랑에', 'Rows per ridge'),
					L(`${sp.lines}줄`, `${sp.lines}`) +
						(sp.lineGap
							? L(` · 줄 사이 ${cmTxt(sp.lineGap)}`, ` · ${cmTxt(sp.lineGap)} apart`)
							: '')
				])
			rows.push([L('포기 사이', 'Between plants'), rng(sp.step, sp.stepTo)])
		}
		// 10a당 포기 수: 자료 값이 있으면 그것, 없으면 간격으로 계산 (그림용 간격이면 계산하지 않음)
		const unit = tree ? L('그루', ' trees') : L('포기', ' plants')
		const mid = (a: number, b?: number) => (b === undefined ? a : (a + b) / 2)
		let per: [number, number] | null = null
		if (sp.per10a) per = [sp.per10a, sp.per10aTo ?? sp.per10a]
		else if (!sp.model) {
			const v =
				(1000 * sp.lines) / ((mid(sp.pitch, sp.pitchTo) / 100) * (mid(sp.step, sp.stepTo) / 100))
			per = [v, v]
		}
		if (per) {
			const txt = per[0] === per[1] ? num(per[0]) : `${num(per[0])}–${num(per[1])}`
			rows.push([L('10a당', 'Per 10a'), L(`약 ${txt}${unit}`, `about ${txt}${unit}`)])
			const here = Math.round((grow * (per[0] + per[1])) / 2 / 1000)
			if (here > 0)
				rows.push([
					L('이 배치', 'This layout'),
					L(`약 ${num(here)}${unit}`, `about ${num(here)}${unit}`)
				])
		}
		return rows
	}

	function seasonRows(c: CropRule): Row[] {
		const h = monthRange(c.harvest, isEn)
		const harvest = c.years
			? L(`심고 ${c.years}년 뒤부터 ${h}`, `${h}, from year ${c.years}`)
			: c.nextYear
				? L(`이듬해 ${h}`, `${h} next year`)
				: h
		return [
			[L('심기', 'Plant'), monthRange(c.plant, isEn)],
			[L('수확', 'Harvest'), harvest]
		]
	}

	/** 표 묶음 하나: 제목 + 이름/값 줄 */
	function specGroup(title: string, rows: Row[]) {
		const sec = document.createElement('section')
		const h = document.createElement('h3')
		h.textContent = title
		const dl = document.createElement('dl')
		for (const [k, v, href] of rows) {
			const div = document.createElement('div')
			const dt = document.createElement('dt')
			dt.textContent = k
			const dd = document.createElement('dd')
			if (href) {
				const a = document.createElement('a')
				a.href = href
				a.textContent = v
				dd.append(a)
			} else dd.textContent = v
			div.append(dt, dd)
			dl.append(div)
		}
		sec.append(h, dl)
		return sec
	}

	function updateCard() {
		const c = cropOf(crop)
		// 꼬리표: 전체 1위(스마트팜 빼고)면 '가장 효율적인 작물', 방식 1위면 '○○ 1위 작물', 아니면 '고른 작물'
		const topAll = picks.find((x) => cropMode(x) !== 'smart')
		$('im-farm-best-label').textContent =
			c && c.id === topAll?.id
				? L('이 땅에 가장 효율적인 작물', 'Most profitable crop here')
				: c && c.id === bestFor(mode)?.id
					? L(`${modeName(mode)} 1위 작물`, `Top crop for ${modeName(mode)}`)
					: L('고른 작물', 'Chosen crop')
		const grow = plan ? growOf(mode, plan) : 0
		bestReason.textContent = c
			? L(c.reasonKo, c.reasonEn)
			: L('이 방식에 맞는 작물이 없습니다.', 'No crop fits this way of farming.')

		// 소득
		const money1: Row[] = []
		if (c?.income) {
			money1.push([L('10a당 소득', 'Income per 10a'), money(c.income.won)])
			if (grow > 0)
				money1.push([
					L('이 배치 한 해', 'This layout, a year'),
					L(
						`약 ${money((c.income.won * grow) / 1000)}`,
						`about ${money((c.income.won * grow) / 1000)}`
					)
				])
		}
		if (c) money1.push(...seasonRows(c))
		// 오늘 도매가와 오르내림 (시세 페이지로)
		const pr = c ? D.prices[c.id] : null
		if (pr) {
			const sign = (v: number) =>
				`${v > 0 ? '+' : ''}${v.toLocaleString(isEn ? 'en-US' : 'ko-KR')}%`
			money1.push([
				L('오늘 도매가', 'Wholesale today'),
				L(`${num(pr.price)}원 / ${pr.unit} →`, `₩${num(pr.price)} / ${pr.unit} →`),
				pr.href
			])
			const moves = [
				pr.d30 !== null ? L(`한 달 전보다 ${sign(pr.d30)}`, `${sign(pr.d30)} vs a month ago`) : '',
				pr.y1 !== null
					? L(
							`이번 달 평균이 작년 ${Number(pr.date.slice(5, 7))}월보다 ${sign(pr.y1)}`,
							`month average ${sign(pr.y1)} vs last year`
						)
					: ''
			].filter(Boolean)
			if (moves.length) money1.push([L('오르내림', 'Change'), moves.join(' · ')])
			money1.push([L('조사', 'Market'), `${pr.region} ${pr.date}`])
		}

		// 배치
		const lay: Row[] = []
		const houses = plan?.pieces.filter((p) => p.piece.k === 'single' && !p.outside) ?? []
		const smart = plan?.pieces.find((p) => p.piece.k === 'smart' && !p.outside)
		const area = (m2: number) => L(`${pyeong(m2)} (${num(m2)}㎡)`, `${num(m2)} ㎡`)
		if (smart) {
			lay.push([L('유리온실', 'Glasshouse'), `${m1(smart.w)} × ${m1(smart.l)}m`])
			lay.push([
				L('칸 · 높이', 'Bays · height'),
				L(
					`${KINDS.smart.w}m × ${smart.piece.n}칸 · ${m1(smart.h)}m`,
					`${smart.piece.n} × ${KINDS.smart.w} m · ${m1(smart.h)} m`
				)
			])
		}
		if (houses.length) {
			const ls = houses.map((h) => h.l)
			const lo = Math.min(...ls)
			const hi = Math.max(...ls)
			lay.push([L('단동 하우스', 'Tunnel houses'), L(`${houses.length}동`, `${houses.length}`)])
			lay.push([
				L('한 동 크기', 'Each house'),
				L(
					`폭 ${m1(KINDS.single.w)}m × 길이 ${lo === hi ? m1(lo) : `${m1(lo)}–${m1(hi)}`}m · 높이 ${m1(KINDS.single.h)}m`,
					`${m1(KINDS.single.w)} m × ${lo === hi ? m1(lo) : `${m1(lo)}–${m1(hi)}`} m, ${m1(KINDS.single.h)} m high`
				)
			])
			lay.push([L('동 사이', 'Between houses'), `${m1(HOUSE_GAP)}m`])
		}
		if (smart || houses.length)
			lay.push([
				L('땅 경계에서', 'From the boundary'),
				L(`옆 ${m1(HOUSE_GAP)}m · 끝 2.5m`, `${m1(HOUSE_GAP)} m sides · 2.5 m ends`)
			])
		if (plan && grow > 0)
			lay.push([
				mode === 'field' ? L('밭 면적', 'Field') : L('재배 면적', 'Under cover'),
				area(grow)
			])
		for (const p of plan?.pieces ?? [])
			if (p.piece.k === 'storage' || p.piece.k === 'yard')
				lay.push([
					p.piece.k === 'storage' ? L('창고', 'Storage') : L('작업 공간', 'Work yard'),
					`${m1(p.w)} × ${m1(p.l)}m`
				])
		if (plan?.entry)
			lay.push([L('진입로', 'Access'), L(`폭 ${m1(plan.entry.w)}m`, `${m1(plan.entry.w)} m wide`)])

		const space = c ? spacingRows(c, grow) : []
		specLine = space.length ? space.map(([k, v]) => `${k} ${v}`).join(' · ') : null

		// 설치비·회수 (하우스·온실만)
		const costRows: Row[] = []
		costNotes = []
		const bc = BUILD_COST[mode]
		if (bc && c?.income && grow > 0) {
			const won = (v: number) => money(v)
			// 범위: 둘 다 1억 밑이면 '3,133–4,135만 원'
			const span = (a: number, b: number) =>
				Math.round(a / 1e5) === Math.round(b / 1e5)
					? won(a)
					: !isEn && b < 1e8
						? `${num(a / 1e4)}–${num(b / 1e4)}만 원`
						: `${won(a)}–${won(b)}`
			const cash = ((c.income.won + (c.income.depr ?? 0)) * grow) / 1000
			const pb = payback(bc, grow, cash)
			const yrs = ([a, b]: [number | null, number | null]) =>
				a === null || b === null
					? '–'
					: Math.round(a * 10) === Math.round(b * 10)
						? `${m1(a)}`
						: `${m1(a)}–${m1(b)}`
			costRows.push([L('시설 면적', 'Facility area'), area(grow)])
			costRows.push([
				L('설치비 (보조 전)', 'Build cost'),
				L(`약 ${span(pb.total[0], pb.total[1])}`, `about ${span(pb.total[0], pb.total[1])}`)
			])
			costRows.push([
				bc.loan ? L('보조 뒤 내 몫', 'Your share') : L('보조 뒤 자부담', 'Your share'),
				L(`약 ${span(pb.mine[0], pb.mine[1])}`, `about ${span(pb.mine[0], pb.mine[1])}`)
			])
			costRows.push([L('한 해 현금', 'Cash a year'), L(`약 ${won(cash)}`, `about ${won(cash)}`)])
			costRows.push([
				L('회수 기간', 'Payback'),
				L(
					`보조 받으면 약 ${yrs(pb.withGrant)}년 · 없으면 약 ${yrs(pb.noGrant)}년`,
					`${yrs(pb.withGrant)} yrs with grant · ${yrs(pb.noGrant)} without`
				)
			])
			if (!pb.eligible)
				costRows.push([
					L('지원 신청 조건', 'Grant condition'),
					L(
						`${num(bc.minArea)}㎡ 이상 (이 배치 ${num(grow)}㎡)`,
						`${num(bc.minArea)} ㎡ or more (this layout ${num(grow)} ㎡)`
					)
				])
			costNotes.push(
				bc.loan
					? L(
							`보조 ${Math.round(bc.grant * 100)}%(국고 20%·지방비 30%) 뒤 내 몫은 자부담 20%와 갚아야 하는 융자 30%입니다.`,
							`After the ${Math.round(bc.grant * 100)}% grant, your share is 20% own money plus a 30% loan.`
						)
					: '',
				L(
					'한 해 현금은 소득에 기존 시설 감가상각비를 다시 더한 값입니다 (새 설치비를 따로 나누므로 두 번 빼지 않게).',
					'Cash a year adds back the depreciation already in operating costs, so the new build cost is not counted twice.'
				),
				L(
					'회수 기간은 이미 짓고 있는 농가의 평균 소득으로 셈한 것이라, 처음 짓는 몇 해는 더 길어질 수 있습니다.',
					'Payback uses the average income of existing farms; the first years of a new farm are usually lower.'
				),
				L(bc.note.ko, bc.note.en),
				L(`설치비 근거: ${bc.src.ko}`, `Cost source: ${bc.src.en}`)
			)
		}

		// 땅 조건: 토지특성(지형높이·형상·도로)과 지적도상 물길
		const landRows: Row[] = []
		const ld = current.land
		const ditch = site.tags.filter((t) => t === 'ditch').length
		const river = site.tags.filter((t) => t === 'river').length
		if (ld?.terrain) landRows.push([L('높낮이', 'Terrain'), ld.terrain])
		if (ld?.shape) landRows.push([L('모양', 'Shape'), ld.shape])
		if (ld?.road)
			landRows.push([
				L('도로', 'Road'),
				ld.roadCode === '12' ? L('맹지 (길에 닿지 않음)', 'Landlocked') : ld.road
			])
		landRows.push([
			L('물길', 'Water'),
			river
				? L('하천에 닿음', 'Touches a river')
				: ditch
					? L('구거(물길)에 닿음', 'Touches a ditch')
					: L('지적도상 닿은 물길 없음', 'No ditch or river on the map')
		])
		if (ld?.terrain === '급경사' || ld?.terrain === '고지')
			costNotes.push(
				L(
					`이 땅은 '${ld.terrain}'로 조사되어 하우스·온실은 터를 고르거나 계단식으로 나눠 지어야 할 수 있습니다.`,
					`Recorded as '${ld.terrain}'; houses may need levelling or terracing.`
				)
			)
		if (ld?.roadCode === '12')
			costNotes.push(
				L(
					'맹지는 시설을 지으려면 들어가는 길(통행로)부터 확보해야 합니다.',
					'A landlocked plot needs an access right first.'
				)
			)
		if (!ditch && !river)
			costNotes.push(
				L(
					'지적도상 닿은 구거·하천이 없어 관정이나 상수도를 따로 확인해야 합니다.',
					'No ditch or river touches the plot; check for a well or mains water.'
				)
			)
		if (ld?.year)
			costNotes.push(
				L(
					`높낮이·모양·도로는 토지특성 ${ld.year}년 조사 값입니다.`,
					`Terrain, shape and road are from the ${ld.year} land survey.`
				)
			)

		specEl.replaceChildren(
			...(money1.length ? [specGroup(L('소득 · 시기', 'Income · season'), money1)] : []),
			specGroup(L(`배치 · ${modeName(mode)}`, `Layout · ${modeName(mode)}`), lay),
			...(space.length ? [specGroup(L('심는 간격', 'Planting'), space)] : []),
			...(costRows.length ? [specGroup(L('설치비 · 회수', 'Build cost · payback'), costRows)] : []),
			specGroup(L('땅 조건', 'Plot'), landRows)
		)
		specGroups = [
			...(costRows.length
				? [{ title: L('설치비 · 회수', 'Build cost · payback'), rows: costRows }]
				: []),
			{ title: L('땅 조건', 'Plot'), rows: landRows }
		]
		srcEl.hidden = !c?.spacing && !c?.income?.item && !costNotes.length
		srcEl.textContent = [
			...costNotes,
			c?.income?.item ? L(`소득 항목: ${c.income.item}`, `Income item: ${c.income.item}`) : '',
			c?.spacing ? L(`간격 출처: ${c.spacing.src}`, `Spacing source: ${c.spacing.src}`) : ''
		]
			.filter(Boolean)
			.join(' · ')

		renderMix()

		approxEl.textContent = [
			c?.income
				? L(
						`소득은 농촌진흥청 ${c.income.year} 농산물소득자료집의 전국 평균(10a = 약 300평)으로, 총수입에서 경영비(비료·농약·인건비·기존 시설의 해마다 감가상각비 등)를 뺀 값입니다. 새로 짓는 시설의 설치비와 대출이자는 따로 셉니다.`,
						`Income is the national average in the RDA ${c.income.year} farm income data book (10a = 1,000 ㎡): revenue minus operating costs, which include yearly depreciation of existing facilities. New build cost and loan interest are counted separately.`
					)
				: '',
			site.roadFrom === 'parcel'
				? ''
				: L(
						'길에 닿은 변을 지적도에서 찾지 못해 진입로 쪽은 어림했습니다.',
						'No road edge was found on the cadastral map, so the entrance side is a guess.'
					)
		]
			.filter(Boolean)
			.join(' ')
	}

	function saveHash() {
		const u = new URL(location.href)
		u.hash = layout.pieces.length ? `plan=${encodeLayout(layout)}` : ''
		history.replaceState(null, '', u)
	}

	const planHandlers = {
		pick(id: number | null) {
			sel = id
			refreshPlan(true)
		},
		move(id: number, x: number, y: number) {
			const p = layout.pieces.find((q) => q.id === id)
			if (!p) return
			p.x = x
			p.y = y
			sel = id
			refreshPlan()
		}
	}

	$('im-farm-auto').addEventListener('click', () => {
		delete layouts[mode]
		setMode(mode, crop)
	})

	// ── 배치 계획도 PDF (누를 때만 불러온다) ─────────────
	const pdfBtn = $<HTMLButtonElement>('im-farm-pdf')
	pdfBtn.addEventListener('click', async () => {
		if (pdfBtn.disabled) return
		if (!plan) refreshPlan()
		if (!plan) return
		saveHash()
		// iOS 사파리는 내려받기 대신 새 탭에서 연다. 팝업이 막히지 않게 누르는 순간 창을 연다
		const ios =
			/iP(hone|ad|od)/.test(navigator.userAgent) ||
			(navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1)
		const win = ios ? window.open('', '_blank') : null
		const label = pdfBtn.textContent
		pdfBtn.disabled = true
		pdfBtn.textContent = L('PDF 만드는 중입니다…', 'Making the PDF…')
		try {
			const { buildPdf } = await import('./farmland-pdf')
			// 표지 그림은 A4 폭에 맞는 가로 그림
			const W = 1600
			const H = Math.round(W / 1.6)
			const shot = view?.snapshot(W, H) ?? null
			const c = cropOf(crop)
			const t = plan.totals
			const grow = growOf(mode, plan)
			const v = current
			const zone = (isEn ? D.zones[v.zone].en : D.zones[v.zone].ko).split(' (')[0]
			const [w, h] = dims(site.ring, site.theta)
			const blob = await buildPdf({
				isEn,
				sample: !tag.hidden,
				address: v.address,
				pnu: v.pnu ?? null,
				jibun: v.jibun ?? null,
				// 토지특성이 없어 지번 끝 글자로 받은 지목은 이름으로 풀어 쓴다
				jimok: v.jimok
					? (({ 과: '과수원', 목: '목장용지', 임: '임야' } as Record<string, string>)[v.jimok] ??
						v.jimok)
					: null,
				areaM2: v.areaM2,
				areaEstimated: !!v.areaEstimated,
				size: [w, h],
				zoning: v.zoning ?? null,
				use: v.farmUse ?? v.landUse ?? null,
				zone,
				theta: site.theta,
				plan: exportPlan(site, plan),
				houseGap: HOUSE_GAP,
				spacing: specLine,
				mix: mixInfo,
				cropLabel: $('im-farm-best-label').textContent ?? '',
				groups: specGroups.map((g) => ({
					title: g.title,
					rows: g.rows.map(([k, v]) => [k, v] as [string, string])
				})),
				crop: c
					? {
							name: nameOf(c),
							season: season(c),
							greenhouse: mode !== 'field',
							income: c.income ?? null,
							grow,
							// 다른 방식의 1위 작물들 (방식 이름을 붙여서)
							alts: (['field', 'house', 'smart'] as FarmMode[])
								.filter((m) => m !== mode)
								.map((m) => bestFor(m))
								.filter((x): x is CropRule => !!x)
								.map((x) => ({
									name: `${nameOf(x)} (${modeName(cropMode(x))})`,
									income: x.income?.won ?? null
								}))
						}
					: null,
				notes: [
					noteEl.hidden ? '' : (noteEl.textContent ?? ''),
					approxEl.textContent ?? '',
					srcEl.hidden ? '' : (srcEl.textContent ?? '')
				].filter(Boolean),
				shareUrl: location.href,
				snapshot: shot,
				snapW: W,
				snapH: H
			})
			const url = URL.createObjectURL(blob)
			// 파일 이름: 번지 (예: 1, 250-1, 산12)
			const lot =
				v.address.match(/(산\s*)?\d+(-\d+)?\s*(\(|$)/)?.[0].replace(/[\s(]/g, '') ??
				(v.jibun ?? '').replace(/[^\d산-]/g, '')
			if (win) win.location.href = url
			else {
				const a = document.createElement('a')
				a.href = url
				a.download = `imunfarm-${L('배치계획', 'layout')}-${lot || 'plan'}.pdf`
				document.body.append(a)
				a.click()
				a.remove()
			}
			setTimeout(() => URL.revokeObjectURL(url), 60_000)
			pdfBtn.textContent = label
		} catch {
			win?.close()
			pdfBtn.textContent = L('PDF를 만들지 못했습니다', 'Could not make the PDF')
			setTimeout(() => (pdfBtn.textContent = label), 2400)
		} finally {
			pdfBtn.disabled = false
		}
	})

	let current: View = D.sample
	function render(v: View, r: Ring, isSample = false, tags: EdgeTag[] = []) {
		current = v
		site = makeSite(r, tags)
		tag.hidden = !isSample
		addrEl.textContent = v.address
		const area = v.areaM2
			? (v.areaEstimated ? L('약 ', '≈ ') : '') +
				L(
					`${num(v.areaM2 / 3.3058)}평 (${num(v.areaM2)}㎡)`,
					`${num(v.areaM2 / 3.3058)} pyeong (${num(v.areaM2)} ㎡)`
				)
			: null
		const [w, h] = dims(r, site.theta)
		const size = L(`가로 ${m1(w)}m × 세로 ${m1(h)}m`, `${m1(w)} × ${m1(h)} m`)
		factsEl.textContent = [v.jimok, area, size].filter(Boolean).join(' · ')

		const notes: string[] = []
		if (v.refined)
			notes.push(
				L(
					'입력한 번지가 없어 가장 가까운 필지로 찾았습니다.',
					'That lot was not found, so the nearest lot is shown.'
				)
			)
		if (!v.isFarmland)
			notes.push(
				L(
					`농지가 아닌 땅입니다(지목 ${v.jimok ?? '–'}). 밭이라고 보고 계산했으며, 농사를 지으려면 허가가 필요할 수 있습니다.`,
					`Not registered as farmland (${v.jimok ?? '–'}). Treated as a field; farming it may need a permit.`
				)
			)
		if (v.fixture) notes.push('개발용 예시 응답입니다.')
		noteEl.hidden = !notes.length
		noteEl.textContent = notes.join(' ')

		picks = v.crops.map((p) => cropOf(p.id)).filter((c): c is CropRule => !!c)
		layouts = {}
		sideId = null
		view?.setSide(null)
		// 처음 방식은 10a당 소득 1위 작물의 방식. 단 스마트팜(유리온실)은 설치비가 훨씬 커서 처음엔 고르지 않고 버튼으로만
		const first = picks.find((c) => cropMode(c) !== 'smart') ?? picks[0] ?? null
		mode = first ? cropMode(first) : 'field'
		const firstId = first?.id ?? null
		mark(firstId)
		// 주소창에 저장된 배치가 있으면(처음 열 때만) 그 배치로
		if (pending) {
			mode = pending.pieces.some((q) => q.k === 'smart')
				? 'smart'
				: pending.pieces.some((q) => q.k === 'single')
					? 'house'
					: mode
			const id = bestFor(mode)?.id ?? firstId
			mark(id)
			layout = pending
		} else layout = structuredClone(layoutFor(mode))
		pending = null
		sel = null
		renderModes()
		renderRank()
		show(r, crop)
	}

	// ── 조회 ────────────────────────────────────────────
	// 브이월드는 해외 서버 요청을 막아서 주소·필지·토지특성은 브라우저에서 조회하고, 팜맵·추천만 서버에 묻는다
	async function lookup(address: string) {
		errorEl.hidden = true
		stage.classList.add('is-busy')
		const fixture = new URLSearchParams(location.search).get('fixture') === '1'
		try {
			const q = new URLSearchParams()
			let refined: string | null = null
			let land: View['land'] = null
			let r: Ring | null = null
			let tags: EdgeTag[] = []
			if (fixture) {
				q.set('fixture', '1')
				r = D.sample.ring
				tags = D.sample.tags
			} else {
				if (!vworldReady()) return fail('unavailable')
				const point = await geocode(address)
				if (!point) return fail('not-found')
				const parcel = await parcelAt(point.lon, point.lat)
				if (!parcel) return fail('no-parcel')
				// 토지특성이 없으면(예: 새 행정구역 코드) 지번 끝 글자 지목과 경계 면적으로 계속한다
				const [facts, nbs] = await Promise.all([
					landFacts(parcel.pnu).catch(() => null),
					// 이웃 필지로 길·구거에 닿은 변을 찾는다 (시설 배치의 진입로·배수 쪽)
					neighboursOf(parcel.polygon, parcel.pnu).catch(() => []),
					load().catch(() => null)
				])
				if (facts)
					land = {
						terrain: facts.terrain,
						shape: facts.shape,
						road: facts.road,
						roadCode: facts.roadCode,
						year: facts.year
					}
				const frame = localFrame(parcel.polygon)
				r = frame?.ring ?? null
				if (frame)
					tags = classifyEdges(
						frame.ring,
						nbs.flatMap((n) =>
							n.rings.map((rr) => ({
								ring: rr.map(([a, b]) => frame.toLocal(a, b)),
								tag: tagOfJibun(n.jibun)
							}))
						)
					)
				const area = facts?.areaM2 ?? polygonAreaM2(parcel.polygon)
				const addr = parcel.address || point.text
				// 지번으로 찾았는데 번지가 바뀌었으면(예: 250 → 250-1) 알려 준다
				const lot = (t: string) => t.match(/(산\s*)?\d+(-\d+)?\s*$/)?.[0].replace(/\s/g, '') ?? null
				if (point.type === 'PARCEL' && lot(address) && lot(address) !== lot(addr)) refined = addr
				const set = (k: string, v: string | number | null | undefined) => {
					if (v !== null && v !== undefined && v !== '') q.set(k, String(v))
				}
				set('pnu', parcel.pnu)
				set('lon', parcel.lon)
				set('lat', parcel.lat)
				set('address', addr)
				set('jibun', parcel.jibun)
				set('jimok', facts?.jimok)
				set('area', area ? Math.round(area * 10) / 10 : null)
				if (!facts?.areaM2 && area) q.set('areaEstimated', '1')
				set('zoning', facts?.zoning)
				set('landUse', facts?.landUse)
			}
			const res = await fetch(`/api/farmland?${q}`)
			const body = (await res.json()) as View & { error?: string }
			if (!res.ok || body.error) return fail(body.error ?? 'upstream')
			render({ ...body, refined, land }, r ?? ring, false, tags)
			stage.scrollIntoView({
				behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
				block: 'nearest'
			})
		} catch {
			fail('upstream')
		} finally {
			stage.classList.remove('is-busy')
		}
	}

	function fail(k: string) {
		errorEl.textContent = err(k)
		errorEl.hidden = false
	}

	form.addEventListener('submit', (e) => {
		e.preventDefault()
		const address = input.value.replace(/\s+/g, ' ').trim()
		if (address.length < 4) return fail('address')
		const u = new URL(location.href)
		u.searchParams.set('address', address)
		u.hash = ''
		history.replaceState(null, '', u)
		input.blur()
		lookup(address)
	})

	// 주소창 # 에 저장된 배치가 있으면 그 배치로 연다
	const saved = new URLSearchParams(location.hash.slice(1)).get('plan')
	pending = saved ? decodeLayout(saved) : null

	// 예시 땅을 먼저 세워 두고, 주소가 있으면 조회가 끝나는 대로 바꾼다 (조회가 실패해도 화면이 비지 않게)
	const start = new URLSearchParams(location.search).get('address')
	if (start) {
		const keep = pending
		pending = null
		render(D.sample, D.sample.ring, true, D.sample.tags)
		pending = keep
		input.value = start
		lookup(start)
	} else render(D.sample, D.sample.ring, true, D.sample.tags)
</script>

