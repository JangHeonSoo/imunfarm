---
import BaseLayout from '@/layouts/BaseLayout'
import { DEFAULT_LOCALE, getLocalePrefix } from '@/utils'
import {
	ITEMS,
	REGIONS,
	buildAnalysis,
	buildPriceData,
	formatDate,
	getItemStatus,
	getPriceAsOfDate
} from '@/data/prices'
import { siteConfig } from '@/site-config'
import PriceSwitcher from '@/components/PriceSwitcher'
import CoupangDynamic from '@/components/CoupangDynamic'
import kamisItems from '@/data/kamis-items.json'
import pricePhotos from '@/data/price-photos.json'
import { buildMoversInput } from '@/data/movers-input'
import { buildMovers } from '@/data/movers'

const { locale = DEFAULT_LOCALE } = Astro.props
const isEn = locale === 'en'
const prefix = getLocalePrefix(locale)

const today = getPriceAsOfDate()
const { dates, table } = buildPriceData(today)
const recentDates = [...dates].reverse().slice(0, 5)
const latest = dates[dates.length - 1]
const dateLabel = formatDate(latest)
const defaultRegion = REGIONS[0]

const fmtServer = (value: number | null) =>
	value == null
		? '–'
		: isEn
			? '₩' + value.toLocaleString('en-US')
			: value.toLocaleString('ko-KR') + '원'
const pct = (v: number | null) =>
	v == null ? '–' : (v > 0 ? '+' : v < 0 ? '−' : '') + Math.abs(v).toFixed(1) + '%'
const dir = (v: number | null) =>
	v == null ? 'im-flat' : v > 0 ? 'im-up' : v < 0 ? 'im-down' : 'im-flat'
const mark = (v: number) => (v > 0 ? '▲ ' : v < 0 ? '▼ ' : '– ')

const thumbOf = (id: string) =>
	(pricePhotos as string[]).includes(id) ? `/images/prices/thumb/${id}.webp` : null
const categoryOf = (id: string) =>
	((kamisItems as Record<string, { codes: string[] }>)[id]?.codes[0] ?? '').split('-')[0]

// 서버에서 그리는 초기 표 (JS 없이도 읽히고 크롤러가 색인한다)
// 오늘 많이 움직인 품목과 근거 (첫 화면 깜빡임 없이 서버에서 먼저 그린다)
const moversInput = buildMoversInput(isEn, today)
const initialMovers = buildMovers(moversInput, defaultRegion.id, dates.length - 1, isEn).map(
	(m) => ({
		...m,
		photo: thumbOf(m.id)
	})
)

// 분류 소제목 (KAMIS 부류 코드 첫 자리)
const CAT_LABELS: Record<string, string> = isEn
	? { '400': 'Fruit', '100': 'Grains and beans', '300': 'Special crops', '200': 'Vegetables' }
	: { '400': '과일', '100': '식량작물', '300': '특용작물', '200': '채소' }

// 최근 조사일 범위 안에서 오늘 값의 위치 (0 = 최저, 1 = 최고)
const rangeOf = (values: (number | null)[], i: number) => {
	const cur = values[i]
	const known = values.slice(0, i + 1).filter((v): v is number => v != null)
	if (cur == null || known.length < 5) return null
	const lo = Math.min(...known)
	const hi = Math.max(...known)
	return { lo, hi, pos: hi > lo ? (cur - lo) / (hi - lo) : 0.5 }
}

const initialRows = ITEMS.map((item) => ({
	id: item.id,
	photo: thumbOf(item.id),
	label: isEn ? item.en : item.ko,
	grade: isEn ? item.gradeEn : item.gradeKo,
	unit: isEn ? item.unitEn : item.unitKo,
	cat: categoryOf(item.id),
	range: rangeOf(moversInput.series[item.id][defaultRegion.id], dates.length - 1),
	...table[latest][defaultRegion.id][item.id]
}))
const initialCounts = {
	down: initialRows.filter((r) => r.price != null && r.delta != null && r.delta < 0).length,
	up: initialRows.filter((r) => r.price != null && r.delta != null && r.delta > 0).length,
	flat: initialRows.filter((r) => r.price != null && (r.delta == null || r.delta === 0)).length
}
const catCount = (cat: string) => initialRows.filter((r) => r.cat === cat).length

// 품목별 분석 요약 — 차트 아래 목록
const MONTHS_KO = [
	'1월',
	'2월',
	'3월',
	'4월',
	'5월',
	'6월',
	'7월',
	'8월',
	'9월',
	'10월',
	'11월',
	'12월'
]
const MONTHS_EN = [
	'Jan',
	'Feb',
	'Mar',
	'Apr',
	'May',
	'Jun',
	'Jul',
	'Aug',
	'Sep',
	'Oct',
	'Nov',
	'Dec'
]
const months = isEn ? MONTHS_EN : MONTHS_KO
const analyses = ITEMS.map((item) => {
	const a = buildAnalysis(item, defaultRegion, today)
	const status = getItemStatus(item, today)
	const seasonValues = a.seasonality.filter((v): v is number => v != null)
	const peak = seasonValues.length ? a.seasonality.indexOf(Math.max(...seasonValues)) : -1
	const seasonDelta =
		a.nextMonthIndex != null && a.monthIndex != null ? a.nextMonthIndex - a.monthIndex : null
	const parts = isEn
		? [
				status.stale &&
					(status.lastSurvey ? `last survey ${formatDate(status.lastSurvey)}` : 'not surveyed'),
				a.percentile != null && `${a.percentile}th percentile within 12 months`,
				a.benchmarks[3].diffPct != null && `${pct(a.benchmarks[3].diffPct)} vs 10 years ago`,
				peak >= 0 && `seasonal peak in ${months[peak]}`,
				seasonDelta != null &&
					`next month ${seasonDelta > 0 ? 'up' : seasonDelta < 0 ? 'down' : 'flat'} ${Math.abs(seasonDelta)}p`
			]
		: [
				status.stale &&
					(status.lastSurvey ? `마지막 조사 ${formatDate(status.lastSurvey)}` : '조사 없음'),
				a.percentile != null && `최근 1년 중 ${a.percentile}번째 백분위`,
				a.benchmarks[3].diffPct != null && `10년 전 같은 달 대비 ${pct(a.benchmarks[3].diffPct)}`,
				peak >= 0 && `계절 고점 ${months[peak]}`,
				seasonDelta != null &&
					`다음 달 지수 ${seasonDelta > 0 ? '상승' : seasonDelta < 0 ? '하락' : '보합'} ${Math.abs(seasonDelta)}p`
			]
	const summary = parts.filter(Boolean).join(' · ')
	return {
		id: item.id,
		label: isEn ? item.en : item.ko,
		unit: isEn ? item.unitEn : item.unitKo,
		price: a.current,
		trend30: a.trend30,
		summary
	}
})

const payload = {
	vol: moversInput.vol,
	why: moversInput.why,
	dates,
	series: moversInput.series,
	regions: REGIONS.map((r) => ({ id: r.id, label: isEn ? r.en : r.ko })),
	catLabels: CAT_LABELS,
	items: ITEMS.map((i) => ({
		id: i.id,
		cat: categoryOf(i.id),
		photo: thumbOf(i.id),
		label: isEn ? i.en : i.ko,
		grade: isEn ? i.gradeEn : i.gradeKo,
		unit: isEn ? i.unitEn : i.unitKo,
		searchText: [
			i.id,
			i.ko,
			i.en,
			i.gradeKo,
			i.gradeEn,
			i.unitKo,
			i.unitEn,
			...i.keywordsKo,
			...i.keywordsEn
		]
			.join(' ')
			.toLowerCase()
	})),
	base: prefix,
	locale: isEn ? 'en-US' : 'ko-KR',
	prefix: isEn ? '₩' : '',
	suffix: isEn ? '' : '원',
	labels: {
		range: isEn ? 'Range' : '범위',
		latest: isEn ? 'Latest' : '최근',
		noResults: isEn ? 'No matching crops.' : '검색 결과가 없습니다.',
		noSurvey: isEn
			? 'No KAMIS survey in this period (likely out of season).'
			: '이 기간에는 KAMIS 조사 자료가 없습니다.'
	}
}

const switchItems = ITEMS.map((entry) => {
	const cell = table[latest][defaultRegion.id][entry.id]
	return {
		id: entry.id,
		label: isEn ? entry.en : entry.ko,
		category: categoryOf(entry.id),
		unit: isEn ? entry.unitEn : entry.unitKo,
		price: cell?.price ?? null,
		delta: cell?.delta ?? null,
		photo: thumbOf(entry.id),
		search: [entry.id, entry.ko, entry.en, ...entry.keywordsKo, ...entry.keywordsEn]
			.join(' ')
			.toLowerCase()
	}
})

const canonical = new URL(Astro.url.pathname, siteConfig.siteUrl).href
const pageTitle = isEn
	? `Korean produce prices — wholesale market rates by region (${dateLabel})`
	: `오늘 농산물 가격·시세표 — 지역별 도매가격 (${dateLabel} 기준)`
const pageDescription = isEn
	? `KAMIS wholesale prices for ${ITEMS.length} major Korean crops in ${REGIONS.length} cities (Seoul, Busan, Daegu, Gwangju, Daejeon), with a 30-survey-day trend chart and a 10-year monthly analysis for each crop. Latest survey ${dateLabel}.`
	: `${dateLabel} KAMIS 조사 기준 배추·무·양파·마늘·대파·감자·사과·배·토마토·오이·청양고추·수박 등 주요 농산물 ${ITEMS.length}개 품목의 지역별 도매 시세표. 서울·부산·대구·광주·대전 도매시장 중도매인 판매가격과 최근 30개 조사일 추이 차트, 품목별 10년 월평균 분석을 함께 제공한다.`

const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'Dataset',
		name: pageTitle,
		description: pageDescription,
		url: canonical,
		keywords: isEn
			? ['korean produce prices', 'wholesale market price', 'vegetable price korea']
			: [
					'농산물 시세',
					'농산물 가격',
					'도매시장 시세',
					'채소 가격',
					'과일 시세',
					'농산물 도매가격'
				],
		temporalCoverage: `${dates[0]}/${latest}`,
		spatialCoverage: { '@type': 'Place', name: isEn ? 'Republic of Korea' : '대한민국' },
		creator: { '@type': 'Organization', name: siteConfig.author.name, url: siteConfig.siteUrl },
		isAccessibleForFree: true,
		distribution: initialRows.map((row) => ({
			'@type': 'PropertyValue',
			name: row.label,
			unitText: row.unit,
			value: row.price
		}))
	},
	{
		'@context': 'https://schema.org',
		'@type': 'ItemList',
		name: isEn ? 'Crop price analysis' : '품목별 시세 분석',
		itemListElement: analyses.map((entry, index) => ({
			'@type': 'ListItem',
			position: index + 1,
			name: entry.label,
			url: new URL(`${prefix}/prices/${entry.id}/`, siteConfig.siteUrl).href
		}))
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'IMUN.FARM', item: siteConfig.siteUrl },
			{ '@type': 'ListItem', position: 2, name: isEn ? 'Prices' : '농산물 시세', item: canonical }
		]
	}
]

const t = {
	basis: isEn ? 'Basis' : '기준',
	item: isEn ? 'Item' : '품목',
	grade: isEn ? 'Grade' : '등급',
	unit: isEn ? 'Unit' : '단위',
	price: isEn ? 'Price' : '가격',
	delta: isEn ? 'Change' : '전일비',
	range: isEn ? 'Today within recent low–high' : '최근 조사일 최저–최고 중 오늘',
	note: isEn
		? 'Source: aT KAMIS (Public Data Portal) · wholesale intermediary selling prices · days without a survey show the previous survey value'
		: '출처: aT KAMIS 가격정보(공공데이터포털) · 도매시장 중도매인 판매가격 · 조사가 없는 날은 직전 조사값',
	chart: isEn ? 'Trend · last 30 survey days' : '추이 최근 30개 조사일',
	high: isEn ? 'High' : '최고',
	low: isEn ? 'Low' : '최저',
	avg: isEn ? 'Average' : '평균',
	change30: isEn ? '30-day change' : '30개 조사일 대비',
	tableView: isEn ? 'View as table' : '표로 보기',
	analysisTitle: isEn ? 'Crop price analysis' : '품목별 시세 분석',
	analysisLead: isEn
		? 'Each crop compared with the same period 1, 3, 5 and 10 years ago, with its seasonal index and monthly trend.'
		: '품목별로 1년·3년·5년·10년 전 같은 기간과 비교하고, 계절지수와 월평균 추이를 함께 본다.',
	readMore: isEn ? 'Read analysis' : '분석 보기',
	searchLabel: isEn ? 'Search crops' : '작물 검색',
	searchPlaceholder: isEn
		? 'Search tomato, Shine Muscat, pepper…'
		: '사과, 홍로, 샤인머스켓, 시금치, 피망…',
	noResults: isEn ? 'No matching crops.' : '검색 결과가 없습니다.'
}
---

<BaseLayout title={pageTitle} description={pageDescription} locale={locale} active='prices'>
	{jsonLd.map((schema) => <script type='application/ld+json' set:html={JSON.stringify(schema)} />)}
	<div class='im-prices im-pad im-bottom'>
		<div class='im-top-sm'></div>

		<header class='im-prices-top'>
			<div>
				<h1>{isEn ? "Today's Korean produce wholesale prices" : '오늘 농산물 도매 시세'}</h1>
				<p class='im-prices-sub' id='im-prices-sub'>
					{isEn ? 'KAMIS wholesale intermediary prices' : 'KAMIS 중도매인 판매가'} ·{' '}
					<span id='im-prices-when'>
						{isEn ? defaultRegion.en : defaultRegion.ko}
						{dateLabel}
					</span>{' '}
					{isEn ? 'survey' : '조사'} · {ITEMS.length}
					{isEn ? ' crops' : '개 품목'}
				</p>
			</div>
			<dl
				class='im-prices-sum'
				aria-label={isEn ? 'Change vs previous survey' : '직전 조사일 대비'}
			>
				<div>
					<dt>{isEn ? 'Down' : '내린 품목'}</dt>
					<dd class='im-down' data-count='down'>{initialCounts.down}</dd>
				</div>
				<div>
					<dt>{isEn ? 'Up' : '오른 품목'}</dt>
					<dd class='im-up' data-count='up'>{initialCounts.up}</dd>
				</div>
				<div>
					<dt>{isEn ? 'Unchanged' : '그대로'}</dt>
					<dd data-count='flat'>{initialCounts.flat}</dd>
				</div>
			</dl>
		</header>

		<section
			class='im-movers'
			id='im-movers-section'
			hidden={initialMovers.length === 0}
			aria-label={isEn ? 'Biggest movers today' : '오늘 많이 움직인 품목'}
		>
			<div class='im-movers-head'>
				<p class='im-label'>{isEn ? 'Biggest movers' : '오늘 많이 움직인 품목'}</p>
				<div class='im-movers-tools'>
					<p class='im-meta' id='im-movers-basis'>
						{isEn ? defaultRegion.en : defaultRegion.ko} · {dateLabel} ·{' '}
						{isEn ? 'vs previous survey' : '직전 조사일 대비'}
					</p>
					<div class='im-movers-nav'>
						<button
							type='button'
							class='im-movers-arrow'
							data-movers-dir='-1'
							aria-label={isEn ? 'Previous' : '이전'}>‹</button
						>
						<button
							type='button'
							class='im-movers-arrow'
							data-movers-dir='1'
							aria-label={isEn ? 'Next' : '다음'}>›</button
						>
					</div>
				</div>
			</div>
			<div class='im-movers-stage'>
				<button
					type='button'
					class='im-movers-side is-prev'
					data-movers-dir='-1'
					aria-label={isEn ? 'Previous' : '이전'}>‹</button
				>
				<button
					type='button'
					class='im-movers-side is-next'
					data-movers-dir='1'
					aria-label={isEn ? 'Next' : '다음'}>›</button
				>
				<div class='im-movers-row' id='im-movers'>
					{
						initialMovers.map((m) => (
							<a class='im-mover' href={`${prefix}/prices/${m.id}/`} draggable='false'>
								<span class='im-mover-photo'>
									{m.photo && (
										<img
											src={m.photo}
											alt=''
											width='64'
											height='64'
											decoding='async'
											draggable='false'
										/>
									)}
								</span>
								<span class='im-mover-name'>{m.label}</span>
								<span class='im-mover-price'>{fmtServer(m.price)}</span>
								<span class={`im-mover-change ${dir(m.delta)}`}>
									{mark(m.delta)}
									{Math.abs(m.delta).toFixed(1)}%
								</span>
								<span class='im-mover-why'>
									{m.reasons.map((text) => (
										<span>{text}</span>
									))}
								</span>
							</a>
						))
					}
				</div>
			</div>
		</section>

		{!isEn && <CoupangDynamic />}

		<div class='im-price-controls'>
			<div>
				<p class='im-label'>지역 Region</p>
				<div class='im-tabs im-menu' id='im-region-tabs'>
					{
						payload.regions.map((region, index) => (
							<button
								type='button'
								class='im-tab'
								data-region={region.id}
								aria-current={index === 0 ? 'true' : 'false'}
							>
								{region.label}
							</button>
						))
					}
				</div>
			</div>
			<div>
				<p class='im-label'>날짜 Date</p>
				<div class='im-tabs im-menu im-date-tabs' id='im-date-tabs'>
					{
						recentDates.map((date, index) => (
							<button
								type='button'
								class='im-tab'
								data-date={date}
								aria-current={index === 0 ? 'true' : 'false'}
							>
								{formatDate(date)}
							</button>
						))
					}
				</div>
			</div>
			<div class='im-price-basis'>
				<p class='im-label'>{t.basis}</p>
				<p class='im-basis-value' id='im-price-basis'>
					{isEn ? defaultRegion.en : defaultRegion.ko} · {dateLabel}
				</p>
			</div>
		</div>

		<div class='im-search im-price-search' role='search'>
			<input
				id='im-price-search'
				type='search'
				autocomplete='off'
				placeholder='SEARCH'
				aria-label={t.searchLabel}
			/>
		</div>

		<div class='im-price-table'>
			<div class='im-price-head'>
				<span>{t.item}</span>
				<span class='im-num'>{t.price}</span>
				<span class='im-num'>{t.delta}</span>
				<span class='im-price-range-h'>{t.range}</span>
			</div>
			<div id='im-price-rows'>
				{
					initialRows.map((row, k) => (
						<Fragment>
							{(k === 0 || initialRows[k - 1].cat !== row.cat) && CAT_LABELS[row.cat] && (
								<div class='im-price-cat'>
									<h2>{CAT_LABELS[row.cat]}</h2>
									<span>
										{catCount(row.cat)}
										{isEn ? ' crops' : '개 품목'}
									</span>
								</div>
							)}
							<a class='im-price-row' href={`${prefix}/prices/${row.id}/`}>
								<span class='im-price-item'>
									<button
										type='button'
										class='im-fav'
										aria-pressed='false'
										title={isEn ? 'Add to my crops' : '내 품목에 추가'}
										aria-label={`${isEn ? 'Add to my crops' : '내 품목에 추가'}: ${row.label}`}
									>
										☆
									</button>
									<span class='im-price-thumb'>
										{row.photo ? (
											<img
												src={row.photo}
												alt=''
												width='32'
												height='32'
												loading='lazy'
												decoding='async'
											/>
										) : (
											<span aria-hidden='true'>{row.label.slice(0, 1)}</span>
										)}
									</span>
									<span class='im-price-name'>
										<span>{row.label}</span>
										<small>
											{row.grade} · {row.unit}
										</small>
									</span>
								</span>
								<span class='im-num im-price-value'>{fmtServer(row.price)}</span>
								<span class={`im-num im-price-delta ${dir(row.delta)}`}>
									{!row.delta ? '–' : `${mark(row.delta)}${Math.abs(row.delta).toFixed(1)}%`}
								</span>
								<span class='im-price-range'>
									{row.range && row.range.hi === row.range.lo && (
										<span class='im-range-same'>
											{isEn ? 'Same price on every recent survey' : '최근 조사일 내내 같은 값'}
										</span>
									)}
									{row.range && row.range.hi > row.range.lo && (
										<Fragment>
											<span>{row.range.lo.toLocaleString(isEn ? 'en-US' : 'ko-KR')}</span>
											<span class='im-range-bar'>
												<i
													class={
														row.range.pos >= 0.8 ? 'is-hi' : row.range.pos <= 0.2 ? 'is-lo' : ''
													}
													style={`left:${(row.range.pos * 100).toFixed(1)}%`}
												/>
											</span>
											<span>{row.range.hi.toLocaleString(isEn ? 'en-US' : 'ko-KR')}</span>
										</Fragment>
									)}
								</span>
							</a>
						</Fragment>
					))
				}
			</div>
		</div>
		<p class='im-meta im-price-note'>{t.note}</p>

		<section class='im-chart-section'>
			<div class='im-chart-head'>
				<div class='im-chart-who'>
					<span class='im-price-thumb im-chart-thumb' id='im-chart-thumb'></span>
					<div>
						<p class='im-label'>{t.chart}</p>
						<h2 class='im-chart-title' id='im-chart-title'></h2>
						<PriceSwitcher
							items={switchItems}
							currentId={ITEMS[0].id}
							prefix={prefix}
							isEn={isEn}
							mode='select'
						/>
					</div>
				</div>
				<dl class='im-chart-stats'>
					<div><dt class='im-label'>{t.high}</dt><dd id='im-stat-high'></dd></div>
					<div><dt class='im-label'>{t.low}</dt><dd id='im-stat-low'></dd></div>
					<div><dt class='im-label'>{t.avg}</dt><dd id='im-stat-avg'></dd></div>
					<div><dt class='im-label'>{t.change30}</dt><dd id='im-stat-change'></dd></div>
				</dl>
			</div>

			<figure class='im-chart' id='im-chart'>
				<div class='im-chart-plot'>
					<div id='im-chart-host' class='im-chart-host' role='img' aria-describedby='im-chart-desc'>
					</div>
					<div class='im-tooltip' id='im-chart-tooltip' hidden></div>
				</div>
				<figcaption class='im-meta' id='im-chart-desc'></figcaption>
			</figure>

			<details class='im-chart-table'>
				<summary class='im-menu'>{t.tableView}</summary>
				<div class='im-chart-table-scroll'>
					<table id='im-chart-data'>
						<thead>
							<tr>
								<th>{t.basis}</th>
								<th class='im-num'>{t.price}</th>
								<th class='im-num'>{t.delta}</th>
							</tr>
						</thead>
						<tbody></tbody>
					</table>
				</div>
			</details>
		</section>

		<section class='im-crop-analysis'>
			<h2 class='im-crop-title'>{t.analysisTitle}</h2>
			<p class='im-crop-lead'>{t.analysisLead}</p>
			<div class='im-crop-list' id='im-analysis-rows'>
				{
					analyses.map((entry) => (
						<a
							class='im-crop-row'
							data-analysis-item={entry.id}
							href={`${prefix}/prices/${entry.id}/`}
						>
							<span class='im-crop-name'>{entry.label}</span>
							<span class='im-crop-summary'>{entry.summary}</span>
							<span class='im-crop-price'>
								<span class='im-num'>{fmtServer(entry.price)}</span>
								<span class={`im-num im-crop-delta ${dir(entry.trend30)}`}>
									{pct(entry.trend30)}
								</span>
							</span>
						</a>
					))
				}
			</div>
			<p class='im-meta im-analysis-empty' id='im-analysis-empty' hidden>{t.noResults}</p>
		</section>
	</div>

	<script type='application/json' id='im-price-data' set:html={JSON.stringify(payload)} />
</BaseLayout>

<script>
	// @ts-nocheck
	import uPlot from 'uplot'
	import 'uplot/dist/uPlot.min.css'
	import { buildMovers } from '@/data/movers'

	function initPrices() {
		const node = document.getElementById('im-price-data')
		const hostEl = document.getElementById('im-chart-host')
		if (!node || !hostEl || hostEl.dataset.ready) return
		hostEl.dataset.ready = '1'
		const data = JSON.parse(node.textContent)

		const rowsEl = document.getElementById('im-price-rows')
		const basisEl = document.getElementById('im-price-basis')
		const host = hostEl
		const plot = host.parentElement
		const tooltip = document.getElementById('im-chart-tooltip')
		const descEl = document.getElementById('im-chart-desc')
		const titleEl = document.getElementById('im-chart-title')
		const tableBody = document.querySelector('#im-chart-data tbody')
		const regionTabs = Array.from(document.querySelectorAll('[data-region]'))
		const dateTabs = Array.from(document.querySelectorAll('[data-date]'))
		const thumbEl = document.getElementById('im-chart-thumb')
		const analysisRows = Array.from(document.querySelectorAll('[data-analysis-item]'))
		const analysisEmpty = document.getElementById('im-analysis-empty')
		const searchInput = document.getElementById('im-price-search')

		let region = regionTabs[0].dataset.region
		let date = dateTabs[0].dataset.date
		let query = ''
		let item = data.items[0].id
		let chart = null

		const fmt = (v) => (v == null ? '–' : data.prefix + v.toLocaleString(data.locale) + data.suffix)
		const dot = (iso) => iso.replace(/-/g, '.')
		const nameOf = (list, id) => (list.find((e) => e.id === id) || {}).label || ''
		const pct = (v) =>
			v == null ? '–' : (v > 0 ? '+' : v < 0 ? '−' : '') + Math.abs(v).toFixed(1) + '%'
		const cls = (v) => (v == null ? 'im-flat' : v > 0 ? 'im-up' : v < 0 ? 'im-down' : 'im-flat')
		const mark = (v) => (v > 0 ? '▲ ' : v < 0 ? '▼ ' : '– ')

		function cellFor(itemId, regionId, i) {
			const values = data.series[itemId][regionId]
			const price = values[i]
			const prev = i > 0 ? values[i - 1] : price
			return {
				price,
				delta: price != null && prev ? Math.round(((price - prev) / prev) * 1000) / 10 : null
			}
		}

		function visibleItems() {
			const q = query.trim().toLowerCase()
			if (!q) return data.items
			const terms = q.split(/\s+/).filter(Boolean)
			return data.items.filter((entry) => terms.every((term) => entry.searchText.includes(term)))
		}

		function ensureVisibleItem() {
			const visible = visibleItems()
			if (!visible.some((entry) => entry.id === item) && visible[0]) item = visible[0].id
		}

		function renderThumb() {
			const entry = data.items.find((e) => e.id === item) || {}
			thumbEl.textContent = ''
			if (entry.photo) {
				const img = document.createElement('img')
				img.src = entry.photo
				img.alt = ''
				img.width = 44
				img.height = 44
				thumbEl.appendChild(img)
			} else thumbEl.textContent = (entry.label || '').slice(0, 1)
		}

		function renderAnalysisList() {
			const ids = new Set(visibleItems().map((entry) => entry.id))
			analysisRows.forEach((row) => {
				row.hidden = query && !ids.has(row.dataset.analysisItem)
			})
			if (analysisEmpty) analysisEmpty.hidden = ids.size !== 0
		}

		const EN = data.base === '/en'

		/* ---------- 오늘 많이 움직인 품목 ---------- */
		const moversEl = document.getElementById('im-movers')
		const moversBasis = document.getElementById('im-movers-basis')
		function renderMovers() {
			const i = data.dates.indexOf(date)
			const list = buildMovers(data, region, i, EN).map((m) => ({
				entry: data.items.find((e) => e.id === m.id),
				c: { price: m.price, delta: m.delta },
				reasons: m.reasons
			}))
			moversEl.textContent = ''
			list.forEach(({ entry, c, reasons: why }) => {
				const a = document.createElement('a')
				a.className = 'im-mover'
				a.draggable = false
				a.href = data.base + '/prices/' + entry.id + '/'
				const ph = document.createElement('span')
				ph.className = 'im-mover-photo'
				if (entry.photo) {
					const img = document.createElement('img')
					img.src = entry.photo
					img.alt = ''
					img.width = 64
					img.height = 64
					img.draggable = false
					ph.appendChild(img)
				}
				const name = document.createElement('span')
				name.className = 'im-mover-name'
				name.textContent = entry.label
				const price = document.createElement('span')
				price.className = 'im-mover-price'
				price.textContent = fmt(c.price)
				const ch = document.createElement('span')
				ch.className = 'im-mover-change ' + cls(c.delta)
				ch.textContent = mark(c.delta) + Math.abs(c.delta).toFixed(1) + '%'
				const reasons = document.createElement('span')
				reasons.className = 'im-mover-why'
				why.forEach((text) => {
					const line = document.createElement('span')
					line.textContent = text
					reasons.appendChild(line)
				})
				a.append(ph, name, price, ch, reasons)
				moversEl.appendChild(a)
			})
			moversBasis.textContent =
				nameOf(data.regions, region) +
				' · ' +
				dot(date) +
				(data.base === '/en' ? ' · vs previous survey' : ' · 직전 조사일 대비')
			document.getElementById('im-movers-section').hidden = list.length === 0
			moversEl.scrollLeft = 0
			requestAnimationFrame(updateArrows)
		}

		/* 마우스로 잡고 끌어 넘기기 (터치는 브라우저 기본 스크롤 그대로) */
		let dragStartX = 0
		let dragStartLeft = 0
		let dragging = false
		let dragged = false
		moversEl.addEventListener('pointerdown', (e) => {
			if (e.pointerType !== 'mouse' || e.button !== 0) return
			dragging = true
			dragged = false
			dragStartX = e.clientX
			dragStartLeft = moversEl.scrollLeft
		})
		window.addEventListener('pointermove', (e) => {
			if (!dragging) return
			const dx = e.clientX - dragStartX
			if (!dragged && Math.abs(dx) > 4) {
				dragged = true
				moversEl.classList.add('is-dragging')
			}
			if (dragged) moversEl.scrollLeft = dragStartLeft - dx
		})
		window.addEventListener('pointerup', () => {
			if (!dragging) return
			dragging = false
			moversEl.classList.remove('is-dragging')
			updateArrows()
		})
		// 끌고 난 직후의 클릭은 링크 이동으로 치지 않는다
		moversEl.addEventListener(
			'click',
			(e) => {
				if (dragged) {
					e.preventDefault()
					e.stopPropagation()
					dragged = false
				}
			},
			true
		)

		const arrows = Array.from(document.querySelectorAll('[data-movers-dir]'))
		function updateArrows() {
			const max = moversEl.scrollWidth - moversEl.clientWidth
			arrows.forEach((b) => {
				b.disabled =
					b.dataset.moversDir === '-1' ? moversEl.scrollLeft <= 2 : moversEl.scrollLeft >= max - 2
			})
			document.querySelector('.im-movers-nav').hidden = max <= 2
		}
		arrows.forEach((b) =>
			b.addEventListener('click', () => {
				moversEl.scrollBy({
					left: Number(b.dataset.moversDir) * moversEl.clientWidth * 0.8,
					behavior: 'smooth'
				})
			})
		)
		moversEl.addEventListener('scroll', () => updateArrows(), { passive: true })

		/* ---------- 내 품목 (이 브라우저에만 저장) ---------- */
		const FAV_KEY = 'imunfarm:fav-items'
		const validIds = new Set(data.items.map((e) => e.id))
		// ?my=peanut,cabbage 로 들어오면 그 목록을 내 품목으로 쓴다 (즐겨찾기·다른 기기용)
		try {
			const fromUrl = new URLSearchParams(location.search).get('my')
			if (fromUrl != null) {
				const ids = fromUrl.split(',').filter((id) => validIds.has(id))
				localStorage.setItem(FAV_KEY, JSON.stringify(ids))
			}
		} catch {}
		function getFavs() {
			try {
				return JSON.parse(localStorage.getItem(FAV_KEY) || '[]')
			} catch {
				return []
			}
		}
		function setFavs(list) {
			try {
				localStorage.setItem(FAV_KEY, JSON.stringify(list))
			} catch {}
		}
		/* 별을 누르면: 누른 줄은 제자리에 두고 화면이 튀지 않게 맞춘 뒤, 별이 톡 튀고 알림이 뜬다 */
		function toggleFav(id, starEl) {
			const favs = getFavs()
			const adding = !favs.includes(id)
			setFavs(adding ? [...favs, id] : favs.filter((x) => x !== id))
			const row = starEl && starEl.closest('a')
			const section = row ? row.dataset.section : 'all'
			const before = row ? row.getBoundingClientRect().top : null
			renderTable()
			const again = rowsEl.querySelector(
				`a[data-id="${id}"][data-section="${section === 'mine' && !adding ? 'all' : section}"]`
			)
			if (again && before != null) window.scrollBy(0, again.getBoundingClientRect().top - before)
			const newStar = again && again.querySelector('.im-fav')
			if (newStar) {
				newStar.classList.remove('is-pop')
				void newStar.offsetWidth
				newStar.classList.add('is-pop')
			}
			showToast(
				adding
					? EN
						? 'Added to My crops'
						: '내 품목에 추가하였습니다'
					: EN
						? 'Removed from My crops'
						: '내 품목에서 삭제하였습니다',
				adding
			)
		}

		let toastEl = null
		let toastTimer = 0
		function showToast(text, withView) {
			if (!toastEl) {
				toastEl = document.createElement('div')
				toastEl.className = 'im-toast'
				toastEl.setAttribute('role', 'status')
				document.body.appendChild(toastEl)
			}
			toastEl.textContent = ''
			const t = document.createElement('span')
			t.textContent = text
			toastEl.appendChild(t)
			if (withView) {
				const b = document.createElement('button')
				b.type = 'button'
				b.textContent = EN ? 'View' : '보기'
				b.addEventListener('click', () => {
					const head = rowsEl.querySelector('.im-price-group')
					if (head)
						window.scrollTo({
							top: head.getBoundingClientRect().top + window.scrollY - 96,
							behavior: 'smooth'
						})
					toastEl.classList.remove('is-on')
				})
				toastEl.appendChild(b)
			}
			toastEl.classList.add('is-on')
			clearTimeout(toastTimer)
			toastTimer = setTimeout(() => toastEl.classList.remove('is-on'), 2600)
		}

		function myLink() {
			const url = new URL(location.origin + location.pathname)
			url.searchParams.set('my', getFavs().join(','))
			return url.toString().replace(/%2C/g, ',')
		}

		async function shareMine(button) {
			const link = myLink()
			const en = data.base === '/en'
			try {
				if (navigator.share && window.matchMedia('(pointer: coarse)').matches) {
					await navigator.share({ title: en ? 'My crop prices' : '내 품목 시세', url: link })
					return
				}
				await navigator.clipboard.writeText(link)
				button.textContent = en ? 'Link copied' : '링크를 복사하였습니다'
			} catch {
				window.prompt(en ? 'Copy this link' : '아래 링크를 복사해 주세요', link)
			}
			setTimeout(() => (button.textContent = en ? 'Copy my link' : '내 품목 링크'), 2000)
		}

		/* ---------- 표 ---------- */
		const whenEl = document.getElementById('im-prices-when')
		const countEls = Array.from(document.querySelectorAll('[data-count]'))
		const num = (v) => v.toLocaleString(data.locale)
		// 최근 조사일 최저–최고 사이에서 오늘 값의 위치
		function rangeEl(itemId, i) {
			const wrap = document.createElement('span')
			wrap.className = 'im-price-range'
			const values = data.series[itemId][region]
			const cur = values[i]
			const known = values.slice(0, i + 1).filter((v) => v != null)
			if (cur == null || known.length < 5) return wrap
			const lo = Math.min(...known)
			const hi = Math.max(...known)
			if (hi === lo) {
				const same = document.createElement('span')
				same.className = 'im-range-same'
				same.textContent = EN ? 'Same price on every recent survey' : '최근 조사일 내내 같은 값'
				wrap.appendChild(same)
				return wrap
			}
			const pos = (cur - lo) / (hi - lo)
			const a = document.createElement('span')
			a.textContent = num(lo)
			const bar = document.createElement('span')
			bar.className = 'im-range-bar'
			const dotEl = document.createElement('i')
			if (pos >= 0.8) dotEl.className = 'is-hi'
			else if (pos <= 0.2) dotEl.className = 'is-lo'
			dotEl.style.left = (pos * 100).toFixed(1) + '%'
			bar.appendChild(dotEl)
			const b = document.createElement('span')
			b.textContent = num(hi)
			wrap.append(a, bar, b)
			return wrap
		}
		function renderTable() {
			const i = data.dates.indexOf(date)
			const favs = getFavs()
			const all = visibleItems()
			const mine = all.filter((e) => favs.includes(e.id))
			// 전체 목록에는 즐겨찾기한 품목도 제자리에 그대로 둔다 (별만 채워진다)
			const visible = mine.length ? [...mine, ...all] : all
			rowsEl.textContent = ''
			const groupHead = (text, withLink) => {
				const h = document.createElement('div')
				h.className = 'im-price-group'
				const t = document.createElement('span')
				t.className = 'im-label'
				t.textContent = text
				h.appendChild(t)
				if (withLink) {
					const b = document.createElement('button')
					b.type = 'button'
					b.className = 'im-price-share im-meta'
					b.textContent = data.base === '/en' ? 'Copy my link' : '내 품목 링크'
					b.addEventListener('click', () => shareMine(b))
					h.appendChild(b)
				}
				rowsEl.appendChild(h)
			}
			const catTotals = {}
			all.forEach((e) => (catTotals[e.cat] = (catTotals[e.cat] || 0) + 1))
			let lastCat = null
			const catHead = (cat) => {
				const h = document.createElement('div')
				h.className = 'im-price-cat'
				const name = document.createElement('h2')
				name.textContent = data.catLabels[cat]
				const n = document.createElement('span')
				n.textContent = catTotals[cat] + (EN ? ' crops' : '개 품목')
				h.append(name, n)
				rowsEl.appendChild(h)
			}
			visible.forEach((entry, k) => {
				if (mine.length && k === 0) groupHead(data.base === '/en' ? 'My crops' : '내 품목', true)
				if (mine.length && k === mine.length)
					groupHead(data.base === '/en' ? 'All crops' : '전체 품목')
				const c = cellFor(entry.id, region, i)
				const row = document.createElement('a')
				row.className = 'im-price-row'
				row.href = data.base + '/prices/' + entry.id + '/'
				row.dataset.id = entry.id
				row.dataset.section = mine.length && k < mine.length ? 'mine' : 'all'
				const name = document.createElement('span')
				name.className = 'im-price-item'
				const th = document.createElement('span')
				th.className = 'im-price-thumb'
				if (entry.photo) {
					const img = document.createElement('img')
					img.src = entry.photo
					img.alt = ''
					img.width = 32
					img.height = 32
					img.loading = 'lazy'
					th.appendChild(img)
				} else th.textContent = entry.label.slice(0, 1)
				const label = document.createElement('span')
				label.className = 'im-price-name'
				const labelText = document.createElement('span')
				labelText.textContent = entry.label
				const labelSub = document.createElement('small')
				labelSub.textContent = entry.grade + ' · ' + entry.unit
				label.append(labelText, labelSub)
				const star = document.createElement('button')
				star.type = 'button'
				star.className = 'im-fav'
				const on = favs.includes(entry.id)
				star.setAttribute('aria-pressed', String(on))
				star.setAttribute(
					'aria-label',
					(on ? '내 품목에서 빼기: ' : '내 품목에 추가: ') + entry.label
				)
				star.textContent = on ? '★' : '☆'
				star.title = on
					? EN
						? 'Remove from my crops'
						: '내 품목에서 빼기'
					: EN
						? 'Add to my crops'
						: '내 품목에 추가'
				star.addEventListener('click', (e) => {
					e.preventDefault()
					e.stopPropagation()
					toggleFav(entry.id, star)
				})
				name.append(star, th, label)
				row.appendChild(name)
				const cells = [
					['im-num im-price-value', fmt(c.price)],
					[
						'im-num im-price-delta ' + cls(c.delta),
						!c.delta ? '–' : mark(c.delta) + Math.abs(c.delta).toFixed(1) + '%'
					]
				]
				cells.forEach(([className, value]) => {
					const span = document.createElement('span')
					span.className = className
					span.textContent = value
					row.appendChild(span)
				})
				row.appendChild(rangeEl(entry.id, i))
				if (row.dataset.section === 'all' && entry.cat !== lastCat) {
					lastCat = entry.cat
					if (data.catLabels[entry.cat]) catHead(entry.cat)
				}
				rowsEl.appendChild(row)
			})
			if (visible.length === 0) {
				const row = document.createElement('div')
				row.className = 'im-price-row im-price-empty'
				row.textContent = data.labels.noResults || 'No matching crops.'
				rowsEl.appendChild(row)
			}
			basisEl.textContent = nameOf(data.regions, region) + ' · ' + dot(date)
			whenEl.textContent = nameOf(data.regions, region) + ' ' + dot(date)
			const counts = { down: 0, up: 0, flat: 0 }
			data.items.forEach((e) => {
				const c = cellFor(e.id, region, i)
				if (c.price == null) return
				counts[c.delta > 0 ? 'up' : c.delta < 0 ? 'down' : 'flat']++
			})
			countEls.forEach((el) => (el.textContent = counts[el.dataset.count]))
			renderMovers()
		}

		/* ---------- 차트 (uPlot) ---------- */
		const css = (name) => getComputedStyle(document.documentElement).getPropertyValue(name).trim()
		const toTs = (iso) => Date.UTC(+iso.slice(0, 4), +iso.slice(5, 7) - 1, +iso.slice(8, 10)) / 1000

		function setStats(known) {
			const ids = ['im-stat-high', 'im-stat-low', 'im-stat-avg', 'im-stat-change']
			if (!known.length) {
				ids.forEach((id) => (document.getElementById(id).textContent = '–'))
				return
			}
			const avg = Math.round(known.reduce((a, b) => a + b, 0) / known.length)
			const change = Math.round(((known[known.length - 1] - known[0]) / known[0]) * 1000) / 10
			document.getElementById('im-stat-high').textContent = fmt(Math.max(...known))
			document.getElementById('im-stat-low').textContent = fmt(Math.min(...known))
			document.getElementById('im-stat-avg').textContent = fmt(avg)
			const changeEl = document.getElementById('im-stat-change')
			changeEl.textContent = pct(change)
			changeEl.className = cls(change)
		}

		function showTip(i) {
			if (!chart || i == null) {
				tooltip.hidden = true
				return
			}
			const values = data.series[item][region]
			if (values[i] == null) {
				tooltip.hidden = true
				return
			}
			const c = cellFor(item, region, i)
			tooltip.textContent = ''
			const value = document.createElement('strong')
			value.textContent = fmt(c.price)
			const when = document.createElement('span')
			when.textContent = dot(data.dates[i])
			const change = document.createElement('span')
			change.className = cls(c.delta)
			change.textContent = pct(c.delta)
			tooltip.append(value, when, change)
			tooltip.hidden = false
			const plotRect = plot.getBoundingClientRect()
			const overRect = chart.over.getBoundingClientRect()
			const px = overRect.left - plotRect.left + chart.valToPos(chart.data[0][i], 'x')
			const py = overRect.top - plotRect.top + chart.valToPos(values[i], 'y')
			const w = plotRect.width
			tooltip.style.left = Math.min(Math.max(px, 8), w - 8) + 'px'
			tooltip.style.transform =
				px > w - 130 ? 'translate(-100%, 0)' : px < 130 ? 'translate(0, 0)' : 'translate(-50%, 0)'
			const th = tooltip.offsetHeight
			const above = py - th - 14
			tooltip.style.top = Math.max(0, above < 0 ? py + 16 : above) + 'px'
		}

		function hideCursor() {
			tooltip.hidden = true
			if (chart) chart.setCursor({ left: -10, top: -10 })
		}

		function renderChart() {
			const values = data.series[item][region]
			const known = values.filter((v) => v != null)
			const label0 = nameOf(data.items, item)
			const meta0 = data.items.find((e) => e.id === item) || {}
			titleEl.textContent =
				label0 + (meta0.unit ? ' · ' + meta0.unit : '') + ' · ' + nameOf(data.regions, region)
			setStats(known)
			chart?.destroy()
			chart = null
			tooltip.hidden = true
			if (known.length < 2) {
				host.textContent = ''
				const p = document.createElement('p')
				p.className = 'im-meta im-chart-empty'
				p.textContent = data.labels.noSurvey
				host.appendChild(p)
				descEl.textContent = data.labels.noSurvey
				renderDataTable()
				return
			}
			host.textContent = ''
			const ink = css('--ink') || '#1d1d1b'
			const muted = css('--muted') || '#8a8a86'
			const line = css('--line') || '#e5e2dd'
			const width = host.clientWidth || 360
			const height = width < 560 ? 240 : 300
			const axisFont = `${width < 560 ? 10 : 11}px ${getComputedStyle(document.body).fontFamily || 'sans-serif'}`
			const firstKnown = known[0]
			chart = new uPlot(
				{
					width,
					height,
					padding: [12, 4, 0, 0],
					legend: { show: false },
					cursor: {
						x: true,
						y: false,
						drag: { x: false, y: false },
						points: { size: 9, width: 2, stroke: ink, fill: css('--bg') || '#faf8f6' }
					},
					select: { show: false, left: 0, top: 0, width: 0, height: 0 },
					scales: { x: { time: true } },
					axes: [
						{
							stroke: muted,
							grid: { show: false },
							ticks: { show: false },
							font: axisFont,
							size: 28,
							space: width < 560 ? 64 : 84,
							values: (_u, splits) =>
								splits.map((v) => {
									const d = new Date(v * 1000)
									return `${String(d.getUTCMonth() + 1).padStart(2, '0')}.${String(d.getUTCDate()).padStart(2, '0')}`
								})
						},
						{
							stroke: muted,
							grid: { stroke: line, width: 1 },
							ticks: { show: false },
							font: axisFont,
							size: (_u, vals) =>
								Math.max(40, ...(vals || []).map((v) => String(v).length * 6.6 + 10)),
							space: 44,
							values: (_u, splits) => splits.map((v) => Math.round(v).toLocaleString(data.locale))
						}
					],
					series: [
						{},
						{
							stroke: ink,
							width: 1.75,
							fill: (u) => {
								const g = u.ctx.createLinearGradient(0, u.bbox.top, 0, u.bbox.top + u.bbox.height)
								g.addColorStop(0, ink + '1f')
								g.addColorStop(1, ink + '00')
								return g
							},
							points: { show: false },
							spanGaps: true
						}
					],
					hooks: {
						draw: [
							(u) => {
								const y = u.valToPos(firstKnown, 'y', true)
								const ctx = u.ctx
								ctx.save()
								ctx.strokeStyle = muted
								ctx.lineWidth = 1
								ctx.setLineDash([3, 4])
								ctx.beginPath()
								ctx.moveTo(u.bbox.left, y)
								ctx.lineTo(u.bbox.left + u.bbox.width, y)
								ctx.stroke()
								ctx.restore()
							}
						],
						setCursor: [(u) => showTip(u.cursor.idx)]
					}
				},
				[data.dates.map(toTs), values],
				host
			)
			bindTouch(chart)
			chart.over.addEventListener('mouseleave', () => (tooltip.hidden = true))

			svgLabel(label0, known)
			renderDataTable()
		}

		function svgLabel(label, known) {
			const lastI = data.dates.length - 1
			host.setAttribute(
				'aria-label',
				label +
					' ' +
					dot(data.dates[0]) +
					' – ' +
					dot(data.dates[lastI]) +
					', ' +
					fmt(Math.min(...known)) +
					' – ' +
					fmt(Math.max(...known))
			)
			descEl.textContent =
				dot(data.dates[0]) +
				' – ' +
				dot(data.dates[lastI]) +
				' · ' +
				data.labels.range +
				' ' +
				fmt(Math.min(...known)) +
				' – ' +
				fmt(Math.max(...known)) +
				' · ' +
				data.labels.latest +
				' ' +
				fmt(known[known.length - 1])
		}

		/** 손가락으로 누르고 끌면 그 지점 값을 보여 준다. 세로 스크롤은 그대로 둔다. */
		function bindTouch(u) {
			const over = u.over
			over.style.touchAction = 'pan-y'
			let active = false
			const move = (e) => {
				const rect = over.getBoundingClientRect()
				u.setCursor({ left: Math.min(Math.max(e.clientX - rect.left, 0), rect.width), top: 10 })
			}
			over.addEventListener('pointerdown', (e) => {
				if (e.pointerType === 'mouse') return
				active = true
				move(e)
			})
			over.addEventListener('pointermove', (e) => active && move(e))
			const end = () => {
				if (!active) return
				active = false
				hideCursor()
			}
			over.addEventListener('pointerup', end)
			over.addEventListener('pointercancel', end)
		}

		function renderDataTable() {
			const values = data.series[item][region]
			tableBody.textContent = ''
			for (let i = values.length - 1; i >= 0; i--) {
				const c = cellFor(item, region, i)
				const tr = document.createElement('tr')
				const cells = [
					['', dot(data.dates[i])],
					['im-num', fmt(c.price)],
					['im-num ' + cls(c.delta), pct(c.delta)]
				]
				cells.forEach(([className, value]) => {
					const td = document.createElement('td')
					td.className = className
					td.textContent = value
					tr.appendChild(td)
				})
				tableBody.appendChild(tr)
			}
		}

		/* ---------- 탭 ---------- */
		function pick(tabs, tab) {
			tabs.forEach((entry) => entry.setAttribute('aria-current', String(entry === tab)))
		}
		regionTabs.forEach((tab) =>
			tab.addEventListener('click', () => {
				region = tab.dataset.region
				pick(regionTabs, tab)
				renderTable()
				renderChart()
			})
		)
		dateTabs.forEach((tab) =>
			tab.addEventListener('click', () => {
				date = tab.dataset.date
				pick(dateTabs, tab)
				renderTable()
			})
		)
		window.addEventListener('im-switch-select', (e) => {
			item = e.detail
			hideCursor()
			renderThumb()
			renderChart()
		})
		if (searchInput) {
			searchInput.addEventListener('input', () => {
				query = searchInput.value || ''
				ensureVisibleItem()
				renderTable()
				renderAnalysisList()
				hideCursor()
				if (visibleItems().length > 0) {
					renderThumb()
					renderChart()
				}
			})
		}

		ensureVisibleItem()
		renderTable()
		renderAnalysisList()
		renderThumb()
		renderChart()
		if (window.ResizeObserver) {
			let last = host.clientWidth
			new ResizeObserver(() => {
				if (Math.abs(host.clientWidth - last) < 2) return
				last = host.clientWidth
				renderChart()
			}).observe(host)
		}
		new MutationObserver(() => renderChart()).observe(document.documentElement, {
			attributes: true,
			attributeFilter: ['class']
		})
	}

	if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initPrices)
	else initPrices()
	document.addEventListener('astro:page-load', initPrices)
</script>

