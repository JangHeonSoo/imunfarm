---
import {
	DEFAULT_LOCALE,
	getCategories,
	getCategorySlug,
	getCategoryTitleFromSlug,
	getLocalePrefix
} from '@/utils'

const { locale = DEFAULT_LOCALE, active = '' } = Astro.props
const prefix = getLocalePrefix(locale)
const categories = await getCategories(locale)
// 글마다 분류를 한글 이름('태양광')이나 주소 이름('solar')으로 적어 같은 분류가 둘로 잡힌다. 주소 기준으로 하나만 남긴다.
const slugs = [...new Set(categories.map((category: string) => getCategorySlug(category)))]
const items = slugs
	.map((slug) => ({ slug, label: getCategoryTitleFromSlug(slug, locale) }))
	.sort((a, b) => a.label.localeCompare(b.label))
---

<nav class='im-category-tabs'>
	<a class='im-tab' href={`${prefix}/blog/`} aria-current={active ? 'false' : 'true'}>
		{locale === 'en' ? 'All' : '전체'}
	</a>
	{
		items.map((item) => (
			<a
				class='im-tab'
				href={`${prefix}/${item.slug}/1`}
				aria-current={active === item.slug ? 'true' : 'false'}
			>
				{item.label}
			</a>
		))
	}
</nav>

<style>
	.im-category-tabs {
		display: flex;
		flex-wrap: wrap;
		gap: clamp(14px, 2vw, 32px);
		margin-bottom: clamp(28px, 4vh, 54px);
		font-size: 13px;
		font-weight: 500;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}
</style>
