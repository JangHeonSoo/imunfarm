---
// 코드 블록: 우측 상단 복사 버튼
---

<pre
	class='im-code'>
	<button type='button' class='im-copy im-label' aria-label='copy'>Copy</button>
	<slot />
</pre>

<script>
	const initCopy = () => {
		document.querySelectorAll('pre.im-code').forEach((block) => {
			const button = block.querySelector('.im-copy') as HTMLButtonElement | null
			if (!button || button.dataset.bound === 'true') return
			button.dataset.bound = 'true'
			button.addEventListener('click', () => {
				const code = block.querySelector('code')
				navigator.clipboard.writeText(code?.textContent?.trim() || '')
				button.textContent = 'Copied'
				setTimeout(() => (button.textContent = 'Copy'), 1600)
			})
		})
	}
	initCopy()
	document.addEventListener('astro:after-swap', initCopy)
</script>

<style>
	.im-code {
		position: relative;
	}

	.im-copy {
		position: absolute;
		top: 8px;
		right: 8px;
		border: 1px solid var(--line);
		background: var(--bg);
		padding: 4px 8px;
		color: var(--muted);
	}

	.im-copy:hover {
		color: var(--ink);
		border-color: var(--ink);
	}
</style>
