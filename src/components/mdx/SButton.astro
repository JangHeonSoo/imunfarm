---
const props = Astro.props
---

<button {...props} class='im-sbutton'><slot /></button>

<style>
	.im-sbutton {
		border: 1px solid var(--ink);
		background: none;
		padding: 10px 16px;
		color: var(--ink);
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.im-sbutton:hover {
		background: var(--ink);
		color: var(--bg);
	}
</style>
