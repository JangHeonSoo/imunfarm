---
type AffiliateItem = {
	name: string
	reason: string
	url: string
	image?: string
	imageAlt?: string
	imageWidth?: number
	imageHeight?: number
	banner?: boolean
}

type Props = {
	title?: string
	items: AffiliateItem[]
	note?: string
}

const {
	title = '함께 보면 좋은 작업 도구',
	items = [],
	note = '이 포스팅은 쿠팡 파트너스 활동의 일환으로, 이에 따른 일정액의 수수료를 제공받습니다.'
} = Astro.props
---

{
	items.length > 0 && (
		<aside class='im-aff' aria-label={title}>
			<header class='im-aff-head'>
				<span class='im-aff-label'>Recommended</span>
				<span class='im-aff-title'>{title}</span>
			</header>
			<ul class='im-aff-list'>
				{items.map((item) => (
					<li>
						<a
							class='im-aff-item'
							href={item.url}
							target='_blank'
							rel='nofollow sponsored noopener'
							referrerpolicy='unsafe-url'
						>
							{item.image && (
								<span class:list={['im-aff-media', { 'is-banner': item.banner }]}>
									<img
										src={item.image}
										alt={item.imageAlt ?? item.name}
										width={item.imageWidth}
										height={item.imageHeight}
										loading='lazy'
									/>
								</span>
							)}
							<span class='im-aff-body'>
								<span class='im-aff-name'>{item.name}</span>
								<span class='im-aff-reason'>{item.reason}</span>
								<span class='im-aff-cta'>
									쿠팡에서 보기 <span aria-hidden='true'>→</span>
								</span>
							</span>
						</a>
					</li>
				))}
			</ul>
			<p class='im-aff-note'>{note}</p>
		</aside>
	)
}

<style>
	.im-aff {
		margin: clamp(48px, 7vw, 80px) 0;
		border-top: 1px solid var(--ink);
		border-bottom: 1px solid var(--line);
		color: var(--ink);
	}

	.im-aff-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 16px;
		padding: 14px 0;
		border-bottom: 1px solid var(--line);
	}

	.im-aff-label {
		color: var(--muted);
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.12em;
		line-height: 1;
		text-transform: uppercase;
	}

	.im-aff-title {
		font-size: 15px;
		font-weight: 700;
		line-height: 1.4;
		text-align: right;
	}

	.im-aff-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.im-aff-list li {
		margin: 0;
		padding: 0;
	}

	.im-aff-list li + li {
		border-top: 1px solid var(--line);
	}

	.im-aff-item {
		display: grid;
		grid-template-columns: 112px minmax(0, 1fr);
		gap: clamp(18px, 3vw, 32px);
		align-items: center;
		padding: 22px 0;
		color: inherit;
		text-decoration: none;
	}

	.im-aff-media {
		display: block;
		overflow: hidden;
		background: #fff;
		aspect-ratio: 1;
	}

	.im-aff-media.is-banner {
		aspect-ratio: 1 / 2;
	}

	.im-aff-media img {
		display: block;
		width: 100%;
		height: 100%;
		margin: 0;
		object-fit: contain;
		transition: transform 200ms ease;
	}

	.im-aff-body {
		display: grid;
		gap: 8px;
		align-content: center;
	}

	.im-aff-name {
		font-size: clamp(18px, 1.5vw, 21px);
		font-weight: 800;
		line-height: 1.35;
		letter-spacing: -0.01em;
	}

	.im-aff-reason {
		color: var(--muted);
		font-size: 15px;
		line-height: 1.7;
	}

	.im-aff-cta {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		width: max-content;
		margin-top: 6px;
		border: 1px solid var(--ink);
		padding: 9px 16px;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.06em;
		line-height: 1;
		transition:
			background 160ms ease,
			color 160ms ease;
	}

	.im-aff-item:hover .im-aff-cta,
	.im-aff-item:focus-visible .im-aff-cta {
		background: var(--ink);
		color: var(--bg);
	}

	.im-aff-item:hover .im-aff-media img,
	.im-aff-item:focus-visible .im-aff-media img {
		transform: scale(1.03);
	}

	.im-aff-note {
		margin: 0;
		padding: 12px 0 14px;
		color: var(--muted);
		font-size: 12px;
		line-height: 1.6;
	}

	@media (max-width: 560px) {
		.im-aff-head {
			flex-direction: column;
			gap: 8px;
		}

		.im-aff-title {
			text-align: left;
		}

		.im-aff-item {
			grid-template-columns: 88px minmax(0, 1fr);
			gap: 16px;
		}
	}
</style>
