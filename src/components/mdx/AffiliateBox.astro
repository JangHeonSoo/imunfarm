---
type AffiliateItem = {
	name: string
	reason: string
	url: string
	image?: string
	imageAlt?: string
}

type Props = {
	title?: string
	items: AffiliateItem[]
	note?: string
}

const {
	title = '함께 보면 좋은 작업 도구',
	items = [],
	note = '이 포스팅은 쿠팡 파트너스 활동의 일환으로, 이에 따른 일정액의 수수료를 제공받습니다.'
} = Astro.props
---

{
	items.length > 0 && (
		<aside class='im-affiliate-box' aria-label={title}>
			<div class='im-affiliate-head'>
				<p class='im-affiliate-kicker'>추천 도구</p>
				<h2>{title}</h2>
			</div>
			<ul class='im-affiliate-list'>
				{items.map((item) => (
					<li>
						<a href={item.url} target='_blank' rel='nofollow sponsored noopener noreferrer'>
							{item.image && (
								<span class='im-affiliate-image'>
									<img src={item.image} alt={item.imageAlt ?? item.name} loading='lazy' />
								</span>
							)}
							<span class='im-affiliate-copy'>
								<span class='im-affiliate-name'>{item.name}</span>
								<span class='im-affiliate-reason'>{item.reason}</span>
							</span>
							<span class='im-affiliate-cta'>상품 보기</span>
						</a>
					</li>
				))}
			</ul>
			<p class='im-affiliate-note'>{note}</p>
		</aside>
	)
}

<style>
	.im-affiliate-box {
		width: min(680px, calc(100vw - 32px));
		margin: clamp(36px, 6vw, 64px) 0;
		border: 1px solid #f0c36a;
		background: #fffaf0;
		box-shadow: 0 18px 40px rgb(0 0 0 / 18%);
		color: #17130c;
	}

	.im-affiliate-head {
		display: grid;
		gap: 8px;
		border-bottom: 1px solid #f0c36a;
		background: linear-gradient(135deg, #fff2c6 0%, #fffaf0 70%);
		color: #17130c;
		padding: clamp(16px, 2.6vw, 24px);
	}

	.im-affiliate-kicker {
		width: max-content;
		margin: 0;
		border: 1px solid #d98a00;
		background: #fff;
		padding: 5px 9px;
		color: #9a5200;
		font-size: 12px;
		font-weight: 900;
		letter-spacing: 0.1em;
		line-height: 1;
		text-transform: uppercase;
	}

	.im-affiliate-head h2 {
		margin: 0;
		color: #17130c;
		font-size: clamp(22px, 2.8vw, 32px);
		font-weight: 900;
		line-height: 1.24;
		letter-spacing: -0.04em;
		text-wrap: pretty;
	}

	.im-affiliate-list {
		list-style: none;
		display: grid;
		gap: 0;
		margin: 0;
		padding: 0 clamp(16px, 2.6vw, 24px);
	}

	.im-affiliate-list li {
		margin: 0;
		border-bottom: 1px solid #f4dfb0;
	}

	.im-affiliate-list li:last-child {
		border-bottom: 0;
	}

	.im-affiliate-list a {
		display: grid;
		grid-template-columns: clamp(96px, 14vw, 136px) minmax(0, 1fr) auto;
		gap: clamp(14px, 2.2vw, 22px);
		align-items: center;
		padding: clamp(16px, 2.6vw, 24px) 0;
		color: #17130c;
		text-decoration: none;
	}

	.im-affiliate-image {
		display: grid;
		place-items: center;
		aspect-ratio: 1;
		border: 1px solid #ead8ad;
		background: #fff;
		overflow: hidden;
	}

	.im-affiliate-image img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		padding: 8px;
		transition: transform 180ms ease;
	}

	.im-affiliate-copy {
		display: grid;
		gap: 7px;
	}

	.im-affiliate-list a:hover .im-affiliate-name,
	.im-affiliate-list a:focus-visible .im-affiliate-name {
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	.im-affiliate-list a:hover .im-affiliate-image img,
	.im-affiliate-list a:focus-visible .im-affiliate-image img {
		transform: scale(1.03);
	}

	.im-affiliate-name {
		color: #17130c;
		font-size: clamp(17px, 1.6vw, 20px);
		font-weight: 900;
		line-height: 1.35;
	}

	.im-affiliate-reason {
		color: #5e5340;
		font-size: 14px;
		line-height: 1.6;
	}

	.im-affiliate-cta {
		border: 1px solid #1f62ff;
		background: #1f62ff;
		color: #fff;
		padding: 10px 13px;
		font-size: 12px;
		font-weight: 900;
		white-space: nowrap;
		box-shadow: 0 8px 18px rgb(31 98 255 / 25%);
	}

	.im-affiliate-note {
		margin: 0;
		border-top: 1px solid #f4dfb0;
		padding: 12px clamp(16px, 2.6vw, 24px) 14px;
		color: #6f6147;
		font-size: 12px;
		line-height: 1.6;
	}

	@media (max-width: 720px) {
		.im-affiliate-box {
			width: 100%;
		}

		.im-affiliate-list a {
			grid-template-columns: 92px minmax(0, 1fr);
			gap: 14px;
		}

		.im-affiliate-cta {
			grid-column: 2;
			width: max-content;
		}
	}
</style>
