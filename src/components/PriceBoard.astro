---
/**
 * 많이 찾는 시세 (메인 첫 화면, 전체 시세표, 품목 페이지 아래). 서버에서 그린다.
 * 메인 글 목록과 같은 사진 카드: 품목 사진 · 이름 · 1kg 환산(또는 오늘 도매가) · 1년 전 같은 달보다.
 */
import { ITEMS, REGIONS, buildAnalysis, getItemStatus, getPriceAsOfDate } from '@/data/prices'
import { SEARCH_NAME_KO } from '@/data/prices'
import { KG_FIRST, perKgOf, unitKgOf } from '@/data/price-popular'
import pricePhotos from '@/data/price-photos.json'

type Props = { ids: string[]; isEn?: boolean; prefix?: string; exclude?: string; limit?: number }
const { ids, isEn = false, prefix = '', exclude, limit = 8 } = Astro.props

const today = getPriceAsOfDate()
const fmt = (v: number | null) =>
	v == null ? '–' : isEn ? '₩' + v.toLocaleString('en-US') : v.toLocaleString('ko-KR') + '원'
const pct = (v: number | null) =>
	v == null ? null : (v > 0 ? '+' : v < 0 ? '−' : '') + Math.abs(v).toFixed(1) + '%'

const rows = ids
	.filter((id) => id !== exclude)
	.slice(0, limit)
	.map((id) => ITEMS.find((item) => item.id === id))
	.filter((item): item is (typeof ITEMS)[number] => !!item)
	.map((item) => {
		const a = buildAnalysis(item, REGIONS[0], today)
		const stale = getItemStatus(item, today).stale
		const unitKg = unitKgOf(item.unitKo)
		const yearAgo = a.benchmarks.find((b) => b.yearsAgo === 1)?.diffPct ?? null
		return {
			id: item.id,
			name: isEn ? item.en : (SEARCH_NAME_KO[item.id] ?? item.ko),
			unit: isEn ? item.unitEn : item.unitKo,
			price: stale ? null : a.current,
			kg: !isEn && KG_FIRST.has(item.id) && !stale ? perKgOf(a.current, unitKg) : null,
			yearAgo: stale ? null : yearAgo,
			photo: (pricePhotos as string[]).includes(item.id) ? `/images/prices/${item.id}.webp` : null
		}
	})
---

<ul class='im-pcards' style={`--cols:${rows.length}`}>
	{
		rows.map((r) => (
			<li>
				<a class='im-pcard' href={`${prefix}/prices/${r.id}/`}>
					{r.photo ? (
						<img
							src={r.photo}
							alt={r.name}
							width='480'
							height='480'
							loading='lazy'
							decoding='async'
						/>
					) : (
						<span class='im-pcard-ph' />
					)}
					<span class='im-pcard-name'>{r.name}</span>
					<strong class='im-pcard-price'>
						{r.kg ? (
							<>
								<small>1kg </small>
								{fmt(r.kg)}
							</>
						) : (
							fmt(r.price)
						)}
					</strong>
					<span class='im-pcard-sub'>
						{r.price == null
							? isEn
								? 'No recent survey'
								: '최근 조사 없음'
							: r.kg
								? `${r.unit} ${fmt(r.price)}`
								: r.unit}
					</span>
					{r.yearAgo != null && (
						<span
							class={`im-pcard-yoy ${r.yearAgo > 0 ? 'im-up' : r.yearAgo < 0 ? 'im-down' : ''}`}
						>
							{isEn ? 'vs last year ' : '1년 전보다 '}
							{pct(r.yearAgo)}
						</span>
					)}
				</a>
			</li>
		))
	}
</ul>

<style>
	/* 휴대폰 2칸, 태블릿 4칸, PC는 한 줄에 모두 (카드 한 장 최대 약 190px, 사진이 너무 커지지 않게) */
	.im-pcards {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 28px var(--gap);
		margin: 0 auto;
		padding: 0;
		list-style: none;
	}

	@media (min-width: 761px) {
		.im-pcards {
			grid-template-columns: repeat(4, minmax(0, 1fr));
			max-width: 880px;
		}
	}

	@media (min-width: 1100px) {
		.im-pcards {
			grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
			max-width: calc(var(--cols) * 200px);
			gap: 32px clamp(16px, 1.4vw, 24px);
		}
	}

	.im-pcard {
		display: block;
		color: var(--ink);
		transition: opacity 200ms ease;
	}

	.im-pcard:hover {
		opacity: 0.82;
	}

	.im-pcard img,
	.im-pcard-ph {
		display: block;
		width: 100%;
		aspect-ratio: 1 / 1;
		object-fit: cover;
		background: var(--line);
	}

	:global(html.dark) .im-pcard img {
		filter: brightness(0.92);
	}

	.im-pcard-name {
		display: block;
		padding-top: 10px;
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0.02em;
	}

	.im-pcard-price {
		display: block;
		padding-top: 4px;
		font-size: clamp(19px, 1.5vw, 23px);
		font-weight: 800;
		letter-spacing: -0.01em;
		line-height: 1.2;
		font-variant-numeric: tabular-nums;
	}

	.im-pcard-price small {
		font-size: 0.55em;
		font-weight: 600;
		letter-spacing: 0.02em;
	}

	.im-pcard-sub {
		display: block;
		padding-top: 5px;
		color: var(--muted);
		font-size: 12px;
		font-weight: 500;
		line-height: 1.5;
		font-variant-numeric: tabular-nums;
	}

	.im-pcard-yoy {
		display: block;
		padding-top: 1px;
		font-size: 12px;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}

	.im-pcard-yoy.im-up {
		color: var(--up);
	}

	.im-pcard-yoy.im-down {
		color: var(--down);
	}
</style>
