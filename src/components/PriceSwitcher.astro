---
/**
 * 품목 바꾸기: 버튼을 누르면 검색·분류·목록이 있는 시트가 열린다.
 * 목록은 서버에서 모두 그리고, 검색과 분류는 브라우저에서 거른다.
 */
export type SwitchItem = {
	id: string
	label: string
	category: string
	unit: string
	price: number | null
	delta: number | null
	photo: string | null
	search: string
}

type Props = {
	items: SwitchItem[]
	currentId: string
	prefix: string
	isEn: boolean
	/** link: 품목 페이지로 이동, select: 'im-switch-select' 이벤트만 보낸다 */
	mode?: 'link' | 'select'
}

const { items, currentId, prefix, isEn, mode = 'link' } = Astro.props

const categories = isEn
	? [
			['all', 'All'],
			['200', 'Vegetables'],
			['400', 'Fruit'],
			['100', 'Grains'],
			['300', 'Special crops']
		]
	: [
			['all', '전체'],
			['200', '채소'],
			['400', '과일'],
			['100', '곡물'],
			['300', '특용작물']
		]

const fmt = (v: number | null) =>
	v == null ? '–' : isEn ? '₩' + v.toLocaleString('en-US') : v.toLocaleString('ko-KR') + '원'
const pct = (v: number | null) =>
	v == null || v === 0 ? '–' : (v > 0 ? '▲ ' : '▼ ') + Math.abs(v).toFixed(1) + '%'
const dir = (v: number | null) => (v == null || v === 0 ? 'im-flat' : v > 0 ? 'im-up' : 'im-down')
---

<button type='button' class='im-switch-open im-meta' id='im-switch-open' aria-haspopup='dialog'>
	{isEn ? 'Other crops' : '다른 품목'}
	<span aria-hidden='true'>▾</span>
</button>

<dialog
	class='im-switch'
	id='im-switch'
	data-mode={mode}
	aria-label={isEn ? 'Choose a crop' : '품목 선택'}
>
	<div class='im-switch-head'>
		<p class='im-label'>{isEn ? 'Choose a crop' : '품목 선택'}</p>
		<button
			type='button'
			class='im-switch-close'
			id='im-switch-close'
			aria-label={isEn ? 'Close' : '닫기'}
		>
			×
		</button>
	</div>
	<div class='im-search im-switch-search' role='search'>
		<input
			id='im-switch-q'
			type='search'
			autocomplete='off'
			placeholder={isEn ? 'Search crops' : '품목 검색: 들깨, 사과, 청양…'}
			aria-label={isEn ? 'Search crops' : '품목 검색'}
		/>
	</div>
	<div class='im-tabs im-menu im-switch-cats'>
		{
			categories.map(([id, label], index) => (
				<button
					type='button'
					class='im-tab'
					data-switch-cat={id}
					aria-current={index === 0 ? 'true' : 'false'}
				>
					{label}
				</button>
			))
		}
	</div>
	<ul class='im-switch-list' id='im-switch-list'>
		{
			items.map((entry) => (
				<li data-cat={entry.category} data-q={entry.search}>
					<a
						href={`${prefix}/prices/${entry.id}/`}
						data-switch-item={entry.id}
						aria-current={entry.id === currentId ? 'page' : undefined}
					>
						<span class='im-switch-thumb'>
							{entry.photo ? (
								<img
									src={entry.photo}
									alt=''
									width='40'
									height='40'
									loading='lazy'
									decoding='async'
								/>
							) : (
								<span aria-hidden='true'>{entry.label.slice(0, 1)}</span>
							)}
						</span>
						<span class='im-switch-name'>
							{entry.label}
							<span class='im-switch-unit'>{entry.unit}</span>
						</span>
						<span class='im-switch-price'>
							<span>{fmt(entry.price)}</span>
							<span class={dir(entry.delta)}>{pct(entry.delta)}</span>
						</span>
					</a>
				</li>
			))
		}
	</ul>
	<p class='im-meta im-switch-empty' id='im-switch-empty' hidden>
		{isEn ? 'No matching crops.' : '검색 결과가 없습니다.'}
	</p>
</dialog>

<script>
	function initSwitch() {
		const dialog = document.getElementById('im-switch') as HTMLDialogElement | null
		const open = document.getElementById('im-switch-open')
		if (!dialog || !open || dialog.dataset.ready) return
		dialog.dataset.ready = '1'
		const close = document.getElementById('im-switch-close')
		const q = document.getElementById('im-switch-q') as HTMLInputElement
		const rows = Array.from(dialog.querySelectorAll<HTMLElement>('#im-switch-list li'))
		const cats = Array.from(dialog.querySelectorAll<HTMLElement>('[data-switch-cat]'))
		const empty = document.getElementById('im-switch-empty') as HTMLElement
		let cat = 'all'

		const filter = () => {
			const terms = q.value.trim().toLowerCase().split(/\s+/).filter(Boolean)
			let shown = 0
			rows.forEach((row) => {
				const ok =
					(cat === 'all' || row.dataset.cat === cat) &&
					terms.every((t) => (row.dataset.q || '').includes(t))
				row.hidden = !ok
				if (ok) shown++
			})
			empty.hidden = shown > 0
		}

		open.addEventListener('click', () => {
			dialog.showModal()
			document.documentElement.classList.add('im-switch-lock')
			if (window.matchMedia('(min-width: 641px)').matches) q.focus()
		})
		const shut = () => dialog.close()
		close?.addEventListener('click', shut)
		dialog.addEventListener('close', () =>
			document.documentElement.classList.remove('im-switch-lock')
		)
		dialog.addEventListener('click', (e) => {
			if (e.target === dialog) shut()
		})
		q.addEventListener('input', filter)
		if (dialog.dataset.mode === 'select') {
			dialog.querySelectorAll<HTMLAnchorElement>('[data-switch-item]').forEach((a) =>
				a.addEventListener('click', (e) => {
					e.preventDefault()
					dialog
						.querySelectorAll('[data-switch-item]')
						.forEach((x) => x.removeAttribute('aria-current'))
					a.setAttribute('aria-current', 'page')
					window.dispatchEvent(
						new CustomEvent('im-switch-select', { detail: a.dataset.switchItem })
					)
					shut()
				})
			)
		}
		cats.forEach((tab) =>
			tab.addEventListener('click', () => {
				cat = tab.dataset.switchCat || 'all'
				cats.forEach((t) => t.setAttribute('aria-current', String(t === tab)))
				filter()
			})
		)
	}
	if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initSwitch)
	else initSwitch()
	document.addEventListener('astro:page-load', initSwitch)
</script>

<style>
	.im-switch-open {
		margin-left: auto;
		border: 0;
		border-bottom: 1px solid var(--ink);
		background: none;
		padding: 0 0 2px;
		color: var(--ink);
		cursor: pointer;
	}

	:global(html.im-switch-lock) {
		overflow: hidden;
	}

	.im-switch {
		width: min(520px, 100%);
		max-height: min(720px, 86vh);
		margin: auto;
		border: 1px solid var(--ink);
		padding: 18px clamp(16px, 3vw, 24px) 8px;
		background: var(--bg);
		color: var(--ink);
		overflow: hidden;
		flex-direction: column;
	}

	.im-switch[open] {
		display: flex;
	}

	.im-switch::backdrop {
		background: rgba(12, 12, 11, 0.42);
	}

	.im-switch-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.im-switch-head p {
		margin: 0;
	}

	.im-switch-close {
		border: 0;
		background: none;
		color: var(--ink);
		font-size: 24px;
		line-height: 1;
		padding: 0 2px;
		cursor: pointer;
	}

	.im-switch-search {
		margin-top: 14px;
	}

	.im-switch-search input {
		width: 100%;
		border: 0;
		border-bottom: 1px solid var(--ink);
		border-radius: 0;
		background: none;
		color: var(--ink);
		padding: 8px 0;
		font: inherit;
		font-size: 16px;
	}

	.im-switch-search input:focus-visible {
		outline: none;
	}

	.im-switch-search input::-webkit-search-cancel-button {
		-webkit-appearance: none;
	}

	.im-switch-cats {
		margin-top: 14px;
		font-size: 13px;
	}

	.im-switch-list {
		flex: 1;
		margin: 12px 0 0;
		padding: 0;
		list-style: none;
		overflow-y: auto;
		overscroll-behavior: contain;
		border-top: 1px solid var(--ink);
	}

	.im-switch-list li[hidden] {
		display: none;
	}

	.im-switch-list a {
		display: grid;
		grid-template-columns: 40px minmax(0, 1fr) auto;
		align-items: center;
		gap: 12px;
		padding: 10px 0;
		border-bottom: 1px solid var(--line);
		color: inherit;
		text-decoration: none;
	}

	.im-switch-list a[aria-current='page'] {
		opacity: 0.45;
	}

	.im-switch-thumb {
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		border-radius: 4px;
		background: var(--line);
		font-size: 14px;
		font-weight: 700;
		color: var(--muted);
		overflow: hidden;
	}

	.im-switch-thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		mix-blend-mode: multiply;
	}

	:global(html.dark) .im-switch-thumb img {
		mix-blend-mode: normal;
	}

	.im-switch-name {
		display: grid;
		gap: 2px;
		font-size: 15px;
		font-weight: 600;
		min-width: 0;
	}

	.im-switch-unit {
		font-size: 12px;
		font-weight: 500;
		color: var(--muted);
	}

	.im-switch-price {
		display: grid;
		justify-items: end;
		gap: 2px;
		font-size: 14px;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}

	.im-switch-price span + span {
		font-size: 12px;
		font-weight: 500;
	}

	.im-switch-empty {
		margin: 16px 0;
	}

	@media (max-width: 640px) {
		.im-switch {
			width: 100%;
			max-width: none;
			height: 84vh;
			max-height: 84vh;
			margin: auto 0 0;
			border-width: 1px 0 0;
			padding-bottom: max(8px, env(safe-area-inset-bottom));
		}
	}
</style>
