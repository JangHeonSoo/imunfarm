---
import BaseLayout from '@/layouts/BaseLayout'
import { SUPPORT_CATEGORIES, SUPPORT_PROGRAMS } from '@/data/support'
import '../../styles/tools.css'

const order = { soon: 0, season: 1, always: 2 } as const
const programs = [...SUPPORT_PROGRAMS].sort((a, b) => order[a.status.kind] - order[b.status.kind])
const categories = SUPPORT_CATEGORIES.filter((c) => programs.some((p) => p.category === c.id))
const latest = programs
	.map((p) => p.checkedAt)
	.sort()
	.at(-1)!
const dot = (iso: string) => iso.replace(/-/g, '.')

const title = '농업 지원사업 모음: 저온저장고·농기계·면세유·안전보험·청년농 지원'
const description = `저온저장고 보조, 농업에너지 이용효율화, 신재생 융복합, 농기계 임대, 농업용 면세유, 농업인안전보험, 청년농 영농정착지원까지 농가가 자주 찾는 지원사업의 대상·지원 내용·신청 시기를 공고 원문과 함께 정리했습니다. ${dot(latest)} 확인 기준.`
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	name: '농업 지원사업 모음',
	itemListElement: programs.map((p, k) => ({
		'@type': 'ListItem',
		position: k + 1,
		name: p.title,
		url: new URL(`/support/${p.slug}/`, Astro.site).href
	}))
}
---

<BaseLayout title={title} description={description} locale='ko' active='support' altPath={null}>
	<div class='im-tool im-sup-hub'>
		<p class='im-label' style='margin:0'>지원사업 · {dot(latest)} 확인 기준</p>
		<h1>농업 지원사업 모음</h1>
		<p class='im-tool-lede'>
			저온저장고, 에너지, 농기계, 연료, 보험, 청년농처럼 농가가 자주 찾는 지원사업을 모았습니다.
			사업마다 대상과 지원 내용, 신청 시기와 신청처, 공고 원문을 함께 보여 드립니다.
		</p>

		<nav class='im-chips' aria-label='분야'>
			<button type='button' class='im-chip' data-cat='' aria-pressed='true'>전체</button>
			{
				categories.map((c) => (
					<button type='button' class='im-chip' data-cat={c.id} aria-pressed='false'>
						{c.label}
					</button>
				))
			}
		</nav>

		<ul class='im-sup-list'>
			{
				programs.map((p) => (
					<li data-cat={p.category}>
						<a href={`/support/${p.slug}/`}>
							<div>
								<span class='im-sup-org'>{p.org}</span>
								<h2>{p.title}</h2>
								<p>{p.summary}</p>
								<dl>
									{p.facts.slice(0, 3).map((f) => (
										<div>
											<dt>{f.label}</dt>
											<dd>{f.value}</dd>
										</div>
									))}
								</dl>
							</div>
							<div class='im-sup-side'>
								<span class={`im-sup-badge is-${p.status.kind}`}>{p.status.label}</span>
								<span class='im-sup-more'>자세히 보기 →</span>
							</div>
						</a>
					</li>
				))
			}
		</ul>
		<p class='im-field-help' style='margin-top:14px'>
			지원 금액·자격·기간은 해마다, 지역마다 바뀝니다. 신청 전에는 반드시 올해 공고 원문과 담당
			기관에 확인해 주세요.
		</p>
	</div>
	<script type='application/ld+json' set:html={JSON.stringify(jsonLd)} />
</BaseLayout>

<script>
	const chips = Array.from(
		document.querySelectorAll<HTMLButtonElement>('.im-sup-hub [data-cat]:not(li)')
	)
	const items = Array.from(document.querySelectorAll<HTMLLIElement>('.im-sup-list li'))
	chips.forEach((chip) =>
		chip.addEventListener('click', () => {
			const cat = chip.dataset.cat
			chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)))
			items.forEach((li) => (li.hidden = !!cat && li.dataset.cat !== cat))
		})
	)
</script>

<style>
	.im-sup-hub {
		width: min(calc(1080px + 2 * var(--gutter)), 100%);
	}

	.im-sup-hub .im-tool-lede {
		max-width: 760px;
	}

	.im-sup-list {
		margin: 18px 0 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--ink);
	}

	.im-sup-list li[hidden] {
		display: none;
	}

	.im-sup-list a {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 170px;
		gap: 8px 28px;
		padding: 22px 0;
		border-bottom: 1px solid var(--line);
	}

	.im-sup-list a:hover h2 {
		opacity: 0.6;
	}

	.im-sup-org {
		color: var(--muted);
		font-size: 12px;
		font-weight: 600;
	}

	.im-sup-list h2 {
		margin: 4px 0 6px;
		font-size: 20px;
		font-weight: 700;
	}

	.im-sup-list p {
		margin: 0;
		color: var(--muted);
		font-size: 14px;
		line-height: 1.65;
	}

	.im-sup-list dl {
		margin: 10px 0 0;
	}

	.im-sup-list dl > div {
		display: grid;
		grid-template-columns: 72px minmax(0, 1fr);
		gap: 12px;
		padding: 3px 0;
		font-size: 13px;
		line-height: 1.55;
	}

	.im-sup-list dt {
		color: var(--muted);
	}

	.im-sup-list dd {
		margin: 0;
	}

	.im-sup-side {
		display: grid;
		align-content: start;
		justify-items: end;
		gap: 10px;
	}

	.im-sup-badge {
		padding: 4px 10px;
		border: 1px solid var(--ink);
		border-radius: 999px;
		font-size: 12px;
		font-weight: 700;
		text-align: center;
	}

	.im-sup-badge.is-soon {
		background: var(--ink);
		color: var(--bg);
	}

	.im-sup-more {
		font-size: 12px;
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	@media (max-width: 700px) {
		.im-sup-list a {
			grid-template-columns: minmax(0, 1fr);
		}

		.im-sup-side {
			justify-items: start;
			grid-auto-flow: column;
			justify-content: start;
			align-items: center;
		}

		.im-sup-list dl > div {
			grid-template-columns: minmax(0, 1fr);
			gap: 0;
		}
	}
</style>
