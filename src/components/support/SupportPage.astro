---
import BaseLayout from '@/layouts/BaseLayout'
import {
	SUPPORT_CATEGORIES,
	SUPPORT_PROGRAMS,
	currentMonthKST,
	sortByNext,
	type SupportProgram
} from '@/data/support'
import '../../styles/tools.css'
import '../../styles/support.css'

const { program } = Astro.props as { program: SupportProgram }
const dot = (iso: string) => iso.replace(/-/g, '.')
const category = SUPPORT_CATEGORIES.find((c) => c.id === program.category)!
const others = sortByNext(
	SUPPORT_PROGRAMS.filter((p) => p.slug !== program.slug),
	currentMonthKST()
).slice(0, 4)
const url = new URL(`/support/${program.slug}/`, Astro.site).href
const title = `${program.title}: ${program.seoSuffix}`
const description = `${program.summary} ${dot(program.checkedAt)} 확인 기준으로 대상, 지원 내용, 신청 시기와 신청처, 공고 원문을 정리했습니다.`
const KEY = [
	['amount', '얼마'],
	['who', '누가'],
	['when', '언제']
] as const

const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'GovernmentService',
		name: program.title,
		description: program.summary,
		provider: { '@type': 'GovernmentOrganization', name: program.org },
		areaServed: { '@type': 'Country', name: '대한민국' },
		url
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'IMUN.FARM', item: new URL('/', Astro.site).href },
			{
				'@type': 'ListItem',
				position: 2,
				name: '지원사업',
				item: new URL('/support/', Astro.site).href
			},
			{ '@type': 'ListItem', position: 3, name: program.title, item: url }
		]
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: program.faq.map((f) => ({
			'@type': 'Question',
			name: f.q,
			acceptedAnswer: { '@type': 'Answer', text: f.a }
		}))
	}
]
---

<BaseLayout title={title} description={description} locale='ko' active='support' altPath={null}>
	<article class='im-sup im-sup-page'>
		<nav class='im-sup-crumb im-label' aria-label='경로'>
			<a href='/support/'>지원사업</a>
			<span>{category.label}</span>
			<span>{dot(program.checkedAt)} 확인</span>
		</nav>
		<h1>{program.title}</h1>
		<div class='im-sup-lede'>{program.summary}</div>

		<dl class='im-sup-key'>
			{
				KEY.map(([k, label]) => (
					<div>
						<dt>{label}</dt>
						<dd>
							<span class='im-sup-key-v'>{program.key[k].v}</span>
							<span class='im-sup-key-s'>{program.key[k].s}</span>
						</dd>
					</div>
				))
			}
		</dl>

		<div class='im-sup-body'>
			<aside class='im-sup-rail is-apply'>
				<section>
					<h2>신청하는 곳</h2>
					{
						program.apply.url ? (
							<a class='im-sup-apply' href={program.apply.url} target='_blank' rel='noopener'>
								{program.apply.label} →<small>{program.apply.note}</small>
							</a>
						) : (
							<div class='im-sup-apply'>
								{program.apply.label}
								<small>{program.apply.note}</small>
							</div>
						)
					}
					<dl>
						<div>
							<dt>주관</dt>
							<dd>{program.org}</dd>
						</div>
						<div>
							<dt>확인일</dt>
							<dd>{dot(program.checkedAt)}</dd>
						</div>
					</dl>
				</section>
			</aside>

			<div class='im-sup-main'>
				{
					program.checks && program.checks.length > 0 && (
						<section class='im-sup-sec im-sup-check' data-pass={program.checkPass}>
							<h2>나도 대상인지 확인해 보세요</h2>
							<p class='im-sup-sub'>
								{program.checks.length}가지에 답하시면 신청 가능성을 바로 알려 드립니다.
							</p>
							{program.checks.map((c, i) => (
								<fieldset data-tag={c.tag}>
									<legend>
										{c.q}
										{c.hint && <small>{c.hint}</small>}
									</legend>
									<span class='im-sup-seg'>
										<label>
											<input type='radio' name={`q${i}`} value='y' />예
										</label>
										<label>
											<input type='radio' name={`q${i}`} value='n' />
											아니요
										</label>
									</span>
								</fieldset>
							))}
							<p class='im-sup-verdict' aria-live='polite'>
								{program.checks.length}가지에 모두 답해 주세요.
							</p>
						</section>
					)
				}

				<section class='im-sup-sec'>
					<h2>신청 순서</h2>
					<ol class='im-sup-steps'>
						{
							program.steps.map((s, i) => (
								<li>
									<span class='im-sup-step-t'>{program.stepWhen?.[i] ?? `${i + 1}단계`}</span>
									<span>{s}</span>
								</li>
							))
						}
					</ol>
				</section>

				<section class='im-sup-sec'>
					<h2>자세한 내용</h2>
					<dl class='im-sup-facts'>
						{
							program.facts.map((f) => (
								<div>
									<dt>{f.label}</dt>
									<dd>{f.value}</dd>
								</div>
							))
						}
					</dl>
				</section>

				<section class='im-sup-sec'>
					<h2>미리 알아 둘 점</h2>
					<ul class='im-sup-lines'>{program.tips.map((s) => <li>{s}</li>)}</ul>
				</section>

				<section class='im-sup-sec im-sup-faq'>
					<h2>자주 묻는 질문</h2>
					{
						program.faq.map((f, i) => (
							<details open={i === 0}>
								<summary>{f.q}</summary>
								<p>{f.a}</p>
							</details>
						))
					}
				</section>

				<section class='im-sup-sec'>
					<h2>공고 원문·출처</h2>
					<ul class='im-sup-src'>
						{
							program.sources.map((s) => (
								<li>
									{s.url ? (
										<a href={s.url} target='_blank' rel='noopener'>
											{s.title}
										</a>
									) : (
										<span>{s.title}</span>
									)}
									<span class='im-sup-date'>{s.date}</span>
								</li>
							))
						}
					</ul>
					<p class='im-sup-sub'>
						지원 금액·자격·기간은 해마다, 지역마다 바뀝니다. 신청 전에는 반드시 올해 공고 원문과
						담당 기관에 확인해 주세요.
					</p>
				</section>
			</div>

			<aside class='im-sup-rail is-more'>
				{
					program.related.length > 0 && (
						<section>
							<h2>함께 보면 좋은 계산기·글</h2>
							<ul>
								{program.related.map((r) => (
									<li>
										<a href={r.href}>{r.title}</a>
									</li>
								))}
							</ul>
						</section>
					)
				}
				<section>
					<h2>다른 지원사업</h2>
					<ul>
						{
							others.map((p) => (
								<li>
									<a href={`/support/${p.slug}/`}>
										{p.title}
										<span>{p.key.when.hub}</span>
									</a>
								</li>
							))
						}
						<li>
							<a href='/support/'>지원사업 전체 보기 →</a>
						</li>
					</ul>
				</section>
			</aside>
		</div>
	</article>
	<script type='application/ld+json' set:html={JSON.stringify(jsonLd)} />
</BaseLayout>

<script>
	document.querySelectorAll<HTMLElement>('.im-sup-check').forEach((box) => {
		const sets = Array.from(box.querySelectorAll<HTMLFieldSetElement>('fieldset'))
		const out = box.querySelector<HTMLElement>('.im-sup-verdict')!
		box.addEventListener('change', () => {
			const answers = sets.map(
				(f) => f.querySelector<HTMLInputElement>('input:checked')?.value as 'y' | 'n' | undefined
			)
			const done = answers.filter(Boolean).length
			out.replaceChildren()
			if (done < sets.length) {
				out.textContent = `${done}개 답했습니다. 남은 질문에 답해 주세요.`
				return
			}
			const no = sets.filter((_, i) => answers[i] === 'n').map((f) => f.dataset.tag)
			const sub = document.createElement('span')
			if (no.length === 0) {
				out.append('신청 대상에 해당할 가능성이 높습니다.')
				sub.textContent = box.dataset.pass ?? ''
			} else {
				out.append(`${no.join(', ')} 조건 때문에 이 사업은 어렵습니다.`)
				sub.textContent = '조건이 다른 사업이 있는지 시·군 농업기술센터에 문의해 주세요.'
			}
			out.append(sub)
		})
	})
</script>
