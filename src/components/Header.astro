---
import { DEFAULT_LOCALE, getLocalePrefix } from '@/utils'

const { locale = DEFAULT_LOCALE, active = '' } = Astro.props
const prefix = getLocalePrefix(locale)
---

<header class='im-header'>
	<span></span>
	<a class='im-wordmark' href={`${prefix}/`} aria-label='IMUN.FARM'>IMUN.FARM</a>
	<a
		class='im-header-prices'
		href={`${prefix}/prices/`}
		aria-current={active === 'prices' ? 'page' : undefined}
	>
		시세 <span>Prices</span>
	</a>
</header>

<style>
	.im-header {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: clamp(12px, 2vw, 28px);
		padding: clamp(10px, 1.1vw, 16px) var(--gutter) 0;
	}

	.im-wordmark {
		color: var(--ink);
		font-size: clamp(22px, 4.8vw, 62px);
		font-weight: 800;
		letter-spacing: 0.05em;
		line-height: 1;
	}

	.im-wordmark:hover {
		opacity: 0.5;
	}

	.im-header-prices {
		justify-self: end;
		align-self: end;
		padding-bottom: 3px;
		color: var(--ink);
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		white-space: nowrap;
		border-bottom: 1px solid transparent;
	}

	.im-header-prices[aria-current='page'] {
		border-bottom-color: var(--ink);
	}

	.im-header-prices span {
		font-weight: 500;
		color: var(--muted);
	}
</style>
