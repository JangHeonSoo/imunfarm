---
import { DEFAULT_LOCALE, getLocalePrefix } from '@/utils'

const { locale = DEFAULT_LOCALE, active = '' } = Astro.props
const prefix = getLocalePrefix(locale)
const isEn = locale === 'en'
---

<header class='im-header'>
	<nav class='im-header-left'>
		<a
			class='im-header-link'
			href={`${prefix}/prices/`}
			aria-current={active === 'prices' ? 'page' : undefined}
		>
			시세 <span>Prices</span>
		</a>
		<a
			class='im-header-link'
			href={`${prefix}/tools/farmland-crop-finder/`}
			aria-current={active === 'land' ? 'page' : undefined}
		>
			농지 분석 <span>Farmland</span>
		</a>
	</nav>
	<a class='im-wordmark' href={`${prefix}/`} aria-label='IMUN.FARM'>IMUN.FARM</a>
	<nav class='im-header-right'>
		<a
			class='im-header-link'
			href={`${prefix}/tools/`}
			aria-current={active === 'tools' || active === 'support' ? 'page' : undefined}
		>
			도구 <span>Tools</span>
		</a>
		<a
			class='im-header-link'
			href={`${prefix}/blog/`}
			aria-current={active === 'blog' ? 'page' : undefined}
		>
			기록 <span>Notes</span>
		</a>
		<button type='button' class='im-header-link im-install-pc' data-install-open>
			{isEn ? 'Install app' : '앱 설치'}
			<span>{isEn ? '' : 'App'}</span>
		</button>
	</nav>
	<!-- 휴대폰: 메뉴 줄에 자리가 없어서 글자 로고 아래 가운데에 둔다 -->
	<button type='button' class='im-install-mobile' data-install-open>
		<img src='/icons/icon-192.png' alt='' width='20' height='20' />
		{isEn ? 'Add app to home screen' : '홈 화면에 앱 설치'}
	</button>
</header>

<style>
	.im-header {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: clamp(12px, 2vw, 28px);
		padding: clamp(10px, 1.1vw, 16px) var(--gutter) 0;
	}

	.im-wordmark {
		color: var(--ink);
		font-size: clamp(22px, 4.8vw, 62px);
		font-weight: 800;
		letter-spacing: 0.05em;
		line-height: 1;
	}

	.im-wordmark:hover {
		opacity: 0.5;
	}

	.im-header-left {
		display: flex;
		justify-self: start;
		align-self: end;
		gap: clamp(12px, 1.6vw, 22px);
	}

	.im-header-right {
		display: flex;
		justify-self: end;
		align-self: end;
		gap: clamp(12px, 1.6vw, 22px);
	}

	.im-header-link {
		align-self: end;
		padding-bottom: 3px;
		color: var(--ink);
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		white-space: nowrap;
		border-bottom: 1px solid transparent;
	}

	.im-header-link[aria-current='page'] {
		border-bottom-color: var(--ink);
	}

	.im-header-link span {
		font-weight: 500;
		color: var(--muted);
	}

	/* 앱 설치 단추: 설치할 수 있을 때만 InstallButton 이 html 에 im-can-install 을 붙인다 */
	.im-install-pc,
	.im-install-mobile {
		display: none;
		font-family: inherit;
		background: none;
		cursor: pointer;
	}

	.im-install-pc {
		border-top: 0;
		border-right: 0;
		border-left: 0;
	}

	:global(html.im-can-install) .im-install-pc {
		display: block;
	}

	.im-install-mobile {
		grid-column: 1 / -1;
		justify-self: center;
		align-items: center;
		gap: 7px;
		margin-top: 2px;
		padding: 6px 4px;
		color: var(--ink);
		font-size: 15px;
		font-weight: 700;
		border: 0;
		border-bottom: 1px solid var(--ink);
	}

	.im-install-mobile img {
		border-radius: 5px;
	}

	@media (max-width: 600px) {
		.im-header-link span {
			display: none;
		}

		:global(html.im-can-install) .im-install-pc {
			display: none;
		}

		:global(html.im-can-install) .im-install-mobile {
			display: flex;
		}
	}

	/* 아주 좁은 화면에서는 간격과 글자를 줄여 가로 넘침을 막는다 */
	@media (max-width: 380px) {
		.im-header,
		.im-header-left,
		.im-header-right {
			gap: 8px;
		}

		.im-header-link {
			font-size: 12px;
			letter-spacing: 0;
		}
	}
</style>
