---
import { DEFAULT_LOCALE, getLocalePrefix } from '@/utils'

const { locale = DEFAULT_LOCALE, active = '' } = Astro.props
const prefix = getLocalePrefix(locale)
---

<header class='im-header'>
	<nav class='im-header-left'>
		<a
			class='im-header-link'
			href={`${prefix}/tools/`}
			aria-current={active === 'tools' ? 'page' : undefined}
		>
			계산기 <span>Tools</span>
		</a>
		{
			locale === DEFAULT_LOCALE && (
				<a
					class='im-header-link'
					href='/support/'
					aria-current={active === 'support' ? 'page' : undefined}
				>
					지원 <span>Support</span>
				</a>
			)
		}
	</nav>
	<a class='im-wordmark' href={`${prefix}/`} aria-label='IMUN.FARM'>IMUN.FARM</a>
	<nav class='im-header-right'>
		{
			locale === DEFAULT_LOCALE && (
				<a
					class='im-header-link'
					href='/picks/'
					aria-current={active === 'picks' ? 'page' : undefined}
				>
					장비 <span>Picks</span>
				</a>
			)
		}
		<a
			class='im-header-link'
			href={`${prefix}/prices/`}
			aria-current={active === 'prices' ? 'page' : undefined}
		>
			시세 <span>Prices</span>
		</a>
	</nav>
</header>

<style>
	.im-header {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: clamp(12px, 2vw, 28px);
		padding: clamp(10px, 1.1vw, 16px) var(--gutter) 0;
	}

	.im-wordmark {
		color: var(--ink);
		font-size: clamp(22px, 4.8vw, 62px);
		font-weight: 800;
		letter-spacing: 0.05em;
		line-height: 1;
	}

	.im-wordmark:hover {
		opacity: 0.5;
	}

	.im-header-left {
		display: flex;
		justify-self: start;
		align-self: end;
		gap: clamp(12px, 1.6vw, 22px);
	}

	.im-header-right {
		display: flex;
		justify-self: end;
		align-self: end;
		gap: clamp(12px, 1.6vw, 22px);
	}

	.im-header-link {
		align-self: end;
		padding-bottom: 3px;
		color: var(--ink);
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		white-space: nowrap;
		border-bottom: 1px solid transparent;
	}

	.im-header-link[aria-current='page'] {
		border-bottom-color: var(--ink);
	}

	.im-header-link span {
		font-weight: 500;
		color: var(--muted);
	}

	@media (max-width: 600px) {
		.im-header-link span {
			display: none;
		}
	}
</style>
