---
import BaseLayout from '@/layouts/BaseLayout'
import { DEFAULT_LOCALE, getPostUrl, getPosts } from '@/utils'

const locale = DEFAULT_LOCALE
const posts = await getPosts(undefined, locale)
---

<BaseLayout title='Posts Index' locale={locale} altPath={null}>
	<div class='im-pad im-bottom'>
		<div class='im-top'></div>
		<div class='im-index-list'>
			{
				posts.map((post, index) => (
					<a class='im-row' href={getPostUrl(post.slug, locale, post.data.category)}>
						<span class='im-index-title'>{post.data.title}</span>
						<span class='im-meta'>{String(index + 1).padStart(3, '0')}</span>
					</a>
				))
			}
		</div>
	</div>
</BaseLayout>

<style>
	.im-index-list {
		max-width: 760px;
		border-top: 1px solid var(--ink);
	}

	.im-index-title {
		font-size: 14px;
		font-weight: 600;
		line-height: 1.4;
	}
</style>
