---
import { type CollectionEntry } from 'astro:content'
import BlogPost from '@/layouts/BlogPost'
import Code from '@/components/mdx/Code'
import SButton from '@/components/mdx/SButton'
import ListRelatedPosts from '@/components/ListRelatedPosts'
import ArticleAds from '@/components/ArticleAds'
import Disqus from '@/components/Disqus'
import { disqusConfig } from '@/data/disqus.config'
import {
	DEFAULT_LOCALE,
	SUPPORTED_LOCALES,
	getCounterpartUrl,
	getPosts,
	stripLocaleFromSlug
} from '@/utils'
import { components } from '../../../components/mixins/AutoImportComponents'

export async function getStaticPaths() {
	const localized = await Promise.all(
		SUPPORTED_LOCALES.filter((loc) => loc !== DEFAULT_LOCALE).map(async (locale) => {
			const posts = await getPosts(undefined, locale)
			return posts.map((post) => ({
				params: { lang: locale, slug: stripLocaleFromSlug(post.slug, locale) },
				props: post
			}))
		})
	)
	return localized.flat()
}

type Props = CollectionEntry<'blog'>

const post = Astro.props
const locale = Astro.params.lang ?? DEFAULT_LOCALE
const posts = await getPosts(undefined, locale)
const lowercaseTags = post.data.tags?.map((tag: string) => tag.toLowerCase()) ?? []
const relatedPosts = posts
	.filter(
		(p) =>
			p.slug !== post.slug &&
			p.data.tags?.some((t: string) => lowercaseTags.includes(t.toLowerCase()))
	)
	.slice(0, 3)

const altPath = await getCounterpartUrl(post.slug, locale, DEFAULT_LOCALE)

const { Content, headings, remarkPluginFrontmatter } = await post.render()
---

<BlogPost
	id={post.id}
	data={post.data}
	headings={headings}
	readTime={remarkPluginFrontmatter.minutesRead}
	locale={locale}
	altPath={altPath}
>
	<div class='im-prose'>
		<Content components={{ ...components, pre: Code, SButton }} />
	</div>
	<Fragment slot='after'>
		<ListRelatedPosts posts={relatedPosts} locale={locale} />
		{disqusConfig.enabled && <Disqus />}
	</Fragment>
</BlogPost>

<ArticleAds />
