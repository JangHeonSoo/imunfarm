---
import type { GetStaticPathsOptions, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout'
import PostGrid from '@/components/PostGrid'
import Pagination from '@/components/Pagination'
import { DEFAULT_LOCALE, SUPPORTED_LOCALES, getPosts } from '@/utils'

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
	const pages = await Promise.all(
		SUPPORTED_LOCALES.filter((loc) => loc !== DEFAULT_LOCALE).map(async (locale) => {
			const posts = await getPosts(undefined, locale)
			return paginate(posts, { pageSize: 24, params: { lang: locale } })
		})
	)
	return pages.flat()
}

const { page } = Astro.props as { page: Page<CollectionEntry<'blog'>> }
const locale = Astro.params.lang ?? DEFAULT_LOCALE
---

<BaseLayout title={locale === 'en' ? 'Posts' : '기록'} locale={locale} active='blog'>
	<div class='im-top'></div>
	<div class='im-pad im-bottom'>
		<PostGrid posts={page.data} locale={locale} />
		{page.lastPage > 1 && <Pagination page={page} />}
	</div>
</BaseLayout>
