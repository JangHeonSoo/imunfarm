---
import type { CollectionEntry } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout'
import PostGrid from '@/components/PostGrid'
import { DEFAULT_LOCALE, SUPPORTED_LOCALES, getPostByTag, getTags } from '@/utils'

export async function getStaticPaths() {
	const all = new Set<string>()
	await Promise.all(
		SUPPORTED_LOCALES.map(async (locale) => {
			const tags = await getTags(locale)
			tags.forEach((tag) => all.add(tag as string))
		})
	)
	return Array.from(all).map((tag) => ({ params: { tag }, props: { tag } }))
}

const { tag } = Astro.props
const locale = DEFAULT_LOCALE
const posts = (await getPostByTag(tag, locale)) as CollectionEntry<'blog'>[]
---

<BaseLayout title={`#${tag}`} locale={locale} active='tags' altPath='/en/tags/'>
	<div class='im-pad im-bottom' style='min-height:50vh'>
		<div class='im-top'></div>
		<div class='im-tag-head'>
			<h1 class='im-menu'>{tag}</h1>
			<span class='im-meta'>{String(posts.length).padStart(2, '0')}</span>
		</div>
		<PostGrid posts={posts} locale={locale} />
	</div>
</BaseLayout>

<style>
	.im-tag-head {
		display: flex;
		align-items: baseline;
		gap: 12px;
		margin-bottom: clamp(28px, 4vh, 54px);
	}

	.im-tag-head h1 {
		margin: 0;
	}
</style>
