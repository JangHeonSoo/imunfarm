---
import BaseLayout from '@/layouts/BaseLayout'
import TagCloud from '@/components/TagCloud'
import { DEFAULT_LOCALE, getPosts } from '@/utils'

const locale = DEFAULT_LOCALE
const posts = await getPosts(undefined, locale)
const counts = new Map<string, number>()
posts.forEach((post) =>
	post.data.tags?.forEach((tag: string) => counts.set(tag, (counts.get(tag) ?? 0) + 1))
)
const tags = Array.from(counts.entries()).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
---

<BaseLayout title='태그' locale={locale} active='tags'>
	<div class='im-pad im-bottom' style='min-height:50vh'>
		<div class='im-top'></div>
		<TagCloud tags={tags} locale={locale} />
	</div>
</BaseLayout>
