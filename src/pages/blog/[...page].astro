---
import type { GetStaticPathsOptions, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout'
import PostGrid from '@/components/PostGrid'
import Pagination from '@/components/Pagination'
import { DEFAULT_LOCALE, getPosts } from '@/utils'

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
	const posts = await getPosts(undefined, DEFAULT_LOCALE)
	return paginate(posts, { pageSize: 24 })
}

const { page } = Astro.props as { page: Page<CollectionEntry<'blog'>> }
---

<BaseLayout title='기록' locale={DEFAULT_LOCALE} active='blog'>
	<div class='im-top'></div>
	<div class='im-pad im-bottom'>
		<PostGrid posts={page.data} locale={DEFAULT_LOCALE} />
		{page.lastPage > 1 && <Pagination page={page} />}
	</div>
</BaseLayout>
