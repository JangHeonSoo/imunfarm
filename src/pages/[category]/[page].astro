---
import BaseLayout from '@/layouts/BaseLayout'
import PostGrid from '@/components/PostGrid'
import Pagination from '@/components/Pagination'
import CategoryTabs from '@/components/CategoryTabs'
import {
	DEFAULT_LOCALE,
	SUPPORTED_LOCALES,
	getCategories,
	getCategorySlug,
	getCategoryTitleFromSlug,
	getPosts
} from '@/utils'

export async function getStaticPaths({ paginate }: any) {
	const set = new Set<string>()
	await Promise.all(
		SUPPORTED_LOCALES.map(async (locale) => {
			const cats = await getCategories(locale)
			cats.forEach((c) => set.add(c))
		})
	)
	const allPosts = await getPosts(undefined, DEFAULT_LOCALE)

	return Array.from(set).flatMap((category: string) => {
		const slug = getCategorySlug(category)
		const filtered = allPosts.filter((post) => getCategorySlug(post.data.category) === slug)
		return paginate(filtered, { params: { category: slug }, pageSize: 24 })
	})
}

const { page } = Astro.props
const locale = DEFAULT_LOCALE
const categorySlug = Astro.params.category!.toLowerCase()
const title = getCategoryTitleFromSlug(categorySlug, locale)
---

<BaseLayout title={title} locale={locale} active='blog'>
	<div class='im-top'></div>
	<div class='im-pad im-bottom'>
		<CategoryTabs locale={locale} active={categorySlug} />
		<PostGrid posts={page.data} locale={locale} />
		{page.lastPage > 1 && <Pagination page={page} />}
	</div>
</BaseLayout>
