---
import type { CollectionEntry } from 'astro:content'
import type { MarkdownHeading } from 'astro'
import BaseLayout from '@/layouts/BaseLayout'
import Tag from '@/components/Tag'
import { siteConfig } from '@/site-config'
import {
	DEFAULT_LOCALE,
	formatPostDate,
	getCategorySlug,
	getCategoryTitleFromSlug,
	getLocalePrefix
} from '@/utils'

type Props = {
	id: CollectionEntry<'blog'>['id']
	data: CollectionEntry<'blog'>['data']
	headings: MarkdownHeading[]
	readTime: string
	locale?: string
	altPath?: string | null
}

const {
	data,
	readTime,
	headings,
	id,
	locale = Astro.currentLocale ?? DEFAULT_LOCALE,
	altPath
} = Astro.props
const { title, description, heroImage, tags, category } = data
const pubDate = data.pubDate ?? new Date()
const isEn = locale === 'en'
const prefix = getLocalePrefix(locale)

const articleDate = pubDate.toISOString()
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href
const heroImageSrc = typeof heroImage === 'string' ? heroImage : heroImage?.src
const heroImageURL = heroImageSrc ? new URL(heroImageSrc, Astro.site).href : undefined
const categoryLabel = getCategoryTitleFromSlug(getCategorySlug(category), locale)
const dateLabel = formatPostDate(pubDate)

const postSlug = id
	.split('/')
	.pop()
	?.replace(/\.(mdx|md)$/, '')

const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3)

const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description,
	image: heroImageURL,
	datePublished: articleDate,
	dateModified: articleDate,
	author: { '@type': 'Organization', name: siteConfig.author.name, url: siteConfig.siteUrl },
	publisher: { '@type': 'Organization', name: siteConfig.author.name, url: siteConfig.siteUrl },
	mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL },
	keywords: tags.join(', ')
}

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.siteUrl },
		{ '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteConfig.siteUrl}blog/` },
		{ '@type': 'ListItem', position: 3, name: title }
	]
}
---

<BaseLayout
	title={title}
	description={description}
	image={heroImageSrc}
	articleDate={articleDate}
	postSlug={postSlug}
	postCategory={category}
	locale={locale}
	active='blog'
	altPath={altPath}
>
	<script type='application/ld+json' set:html={JSON.stringify(articleSchema)} />
	<script type='application/ld+json' set:html={JSON.stringify(breadcrumbSchema)} />

	<header class='im-article-head im-pad'>
		<div class='im-top'></div>
		<h1 class='im-article-title'>{title}</h1>
		<div class='im-article-meta im-meta'>
			<a href={`${prefix}/${getCategorySlug(category)}/1`}>{categoryLabel}</a>
			<span>{dateLabel}</span>
			<span>{readTime}</span>
		</div>
	</header>

	{
		heroImageSrc && (
			<figure class='im-article-hero'>
				<img src={heroImageSrc} alt={title} loading='eager' />
			</figure>
		)
	}

	<article class='im-article im-pad im-bottom'>
		<div class='im-article-body'>
			<aside class='im-article-aside'>
				{
					toc.length > 0 && (
						<nav class='im-toc im-meta' aria-label={isEn ? 'Contents' : '목차'}>
							{toc.map((heading) => (
								<a href={`#${heading.slug}`} data-toc={heading.slug}>
									{heading.text}
								</a>
							))}
						</nav>
					)
				}
			</aside>

			<div class='im-article-main'>
				{description && <p class='im-article-lead'>{description}</p>}
				<slot />
			</div>

			<div class='im-article-rail' aria-hidden='true'></div>
		</div>

		<div class='im-article-foot'>
			{
				tags.length > 0 && (
					<div class='im-article-tags'>
						<p class='im-label'>{isEn ? 'Tags' : '태그'}</p>
						<div class='im-tag-list'>
							{tags.map((tag: string) => (
								<Tag tag={tag} locale={locale} />
							))}
						</div>
					</div>
				)
			}

			<slot name='after' />
		</div>
	</article>

	<script is:inline>
		;(function () {
			const heading = document.querySelector('.im-prose > h1:first-child')
			const title = document.querySelector('.im-article-title')
			if (heading && title && heading.textContent.trim() === title.textContent.trim())
				heading.remove()
		})()
	</script>
</BaseLayout>

<script>
	function initTocObserver() {
		const links = document.querySelectorAll('[data-toc]')
		if (!links.length) return
		const headings = document.querySelectorAll('.im-prose h2, .im-prose h3')
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					const link = document.querySelector(`[data-toc="${entry.target.id}"]`)
					link?.classList.toggle('is-active', entry.isIntersecting)
				})
			},
			{ rootMargin: '0px 0px -70% 0px', threshold: 1 }
		)
		headings.forEach((heading) => observer.observe(heading))
	}
	initTocObserver()
	document.addEventListener('astro:after-swap', initTocObserver)
</script>

<style>
	.im-article {
		width: min(1400px, 100%);
		margin-inline: auto;
	}

	.im-article-foot {
		max-width: var(--measure);
		margin-inline: auto;
	}

	.im-article-meta {
		display: flex;
		flex-wrap: wrap;
		gap: clamp(14px, 2vw, 32px);
		margin-top: clamp(18px, 2.4vw, 32px);
		font-size: 12px;
	}

	/* 대표 이미지는 화면 폭 꽉 차게 */
	.im-article-hero {
		margin: clamp(28px, 4vw, 56px) 0 0;
	}

	.im-article-hero img {
		display: block;
		width: 100%;
		height: clamp(220px, min(56vh, 42vw), 640px);
		object-fit: cover;
	}

	.im-article-aside {
		align-content: start;
	}

	.im-toc {
		position: sticky;
		top: 28px;
		display: grid;
		gap: 14px;
		align-content: start;
		font-size: 14px;
		font-weight: 500;
		letter-spacing: 0;
		line-height: 1.45;
		text-transform: none;
		color: var(--muted);
	}

	.im-toc a {
		text-wrap: pretty;
	}

	.im-toc a.is-active {
		color: var(--ink);
		font-weight: 600;
	}

	.im-article-lead {
		margin: 0 0 clamp(28px, 3.4vw, 46px);
		font-size: clamp(19px, 1.55vw, 24px);
		font-weight: 400;
		line-height: 1.75;
		text-wrap: pretty;
	}

	.im-article-tags {
		display: grid;
		gap: 12px;
		margin-top: clamp(48px, 8vh, 96px);
		border-top: 1px solid var(--line);
		padding-top: 20px;
	}

	.im-tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	@media (max-width: 1240px) {
		.im-article-aside,
		.im-article-rail {
			display: none;
		}
	}
</style>
