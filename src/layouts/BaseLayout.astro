---
import BaseHead from '@/components/BaseHead'
import Header from '@/components/Header'
import Footer from '@/components/Footer'
import ProviderTheme from '@/components/ProviderTheme'
import {
	DEFAULT_LOCALE,
	SUPPORTED_LOCALES,
	getLocaleLanguageTag,
	getPostUrl,
	swapLocaleInPath
} from '@/utils'

type Props = {
	title: string
	description?: string
	image?: string
	articleDate?: string
	postSlug?: string
	postCategory?: any
	locale?: string
	active?: string
	/** 다른 언어 경로. null 이면 언어 전환 링크를 숨긴다. */
	altPath?: string | null
}

const {
	title,
	description,
	image,
	articleDate,
	postSlug,
	postCategory,
	locale = Astro.currentLocale ?? DEFAULT_LOCALE,
	active = '',
	altPath
} = Astro.props

const otherLocale = SUPPORTED_LOCALES.find((l) => l !== locale) ?? DEFAULT_LOCALE
const resolvedAltPath =
	altPath !== undefined
		? altPath
		: postSlug
			? getPostUrl(postSlug, otherLocale, postCategory)
			: swapLocaleInPath(Astro.url.pathname, otherLocale)
---

<html lang={getLocaleLanguageTag(locale)} class='scroll-smooth'>
	<head>
		<BaseHead title={title} description={description} ogImage={image} articleDate={articleDate} />
		<ProviderTheme />
		<script
			async
			src='https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js'
			crossorigin='anonymous'></script>
		<script is:inline>
			// 모바일 앵커 광고가 상단에 붙으면 첫 화면 카드·차트의 터치를 가린다.
			// src에 ?client=를 붙이면 자동 광고 설정이 두 번 들어가 overlays가 무시된다.
			;(window.adsbygoogle = window.adsbygoogle || []).push({
				google_ad_client: 'ca-pub-9192660979184684',
				enable_page_level_ads: true,
				overlays: { bottom: true }
			})
		</script>
		<script async src='https://www.googletagmanager.com/gtag/js?id=G-6ZQ577JL4Q'></script>
		<script is:inline>
			const dataLayer = window['dataLayer'] || []
			window['dataLayer'] = dataLayer
			function gtag(...args) {
				dataLayer.push(args)
			}
			gtag('js', new Date())
			gtag('config', 'G-6ZQ577JL4Q')
		</script>
	</head>

	<body>
		<div class='im-page'>
			<Header locale={locale} active={active} />
			<main class='im-main'>
				<slot />
			</main>
			<Footer locale={locale} otherLocale={otherLocale} altPath={resolvedAltPath} active={active} />
		</div>
		<script>
			// 큰 검색창의 SEARCH 안내를 한국어 페이지에서는 SEARCH ↔ 검색 으로 천천히 번갈아 보여 준다 (2026-10-09)
			if (document.documentElement.lang.startsWith('ko')) {
				const WORDS = ['SEARCH', '검색']
				const hints: HTMLElement[] = []
				document
					.querySelectorAll<HTMLInputElement>('.im-search input[placeholder="SEARCH"]')
					.forEach((input) => {
						const box = input.parentElement
						if (!box) return
						const cs = getComputedStyle(input)
						const hint = document.createElement('span')
						hint.className = 'im-search-hint'
						hint.setAttribute('aria-hidden', 'true')
						for (const prop of ['fontSize', 'fontWeight', 'letterSpacing', 'width'] as const)
							hint.style[prop] = cs[prop]
						hint.innerHTML = WORDS.map(
							(w, i) => `<span${i === 0 ? ' class="is-on"' : ''}>${w}</span>`
						).join('')
						box.classList.add('has-hint')
						box.appendChild(hint)
						hints.push(hint)
					})
				if (hints.length) {
					let i = 0
					setInterval(() => {
						if (document.hidden) return
						i = (i + 1) % WORDS.length
						for (const hint of hints)
							hint
								.querySelectorAll('span')
								.forEach((el, k) => el.classList.toggle('is-on', k === i))
					}, 2800)
				}
			}
		</script>
	</body>
</html>
