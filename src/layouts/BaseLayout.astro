---
import BaseHead from '@/components/BaseHead'
import Header from '@/components/Header'
import Footer from '@/components/Footer'
import ProviderTheme from '@/components/ProviderTheme'
import {
	DEFAULT_LOCALE,
	SUPPORTED_LOCALES,
	getLocaleLanguageTag,
	getPostUrl,
	swapLocaleInPath
} from '@/utils'

type Props = {
	title: string
	description?: string
	image?: string
	articleDate?: string
	postSlug?: string
	postCategory?: any
	locale?: string
	active?: string
	/** 다른 언어 경로. null 이면 언어 전환 링크를 숨긴다. */
	altPath?: string | null
}

const {
	title,
	description,
	image,
	articleDate,
	postSlug,
	postCategory,
	locale = Astro.currentLocale ?? DEFAULT_LOCALE,
	active = '',
	altPath
} = Astro.props

const otherLocale = SUPPORTED_LOCALES.find((l) => l !== locale) ?? DEFAULT_LOCALE
const resolvedAltPath =
	altPath !== undefined
		? altPath
		: postSlug
			? getPostUrl(postSlug, otherLocale, postCategory)
			: swapLocaleInPath(Astro.url.pathname, otherLocale)
---

<html lang={getLocaleLanguageTag(locale)} class='scroll-smooth'>
	<head>
		<BaseHead title={title} description={description} ogImage={image} articleDate={articleDate} />
		<ProviderTheme />
		<script
			async
			src='https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9192660979184684'
			crossorigin='anonymous'></script>
		<script async src='https://www.googletagmanager.com/gtag/js?id=G-6ZQ577JL4Q'></script>
		<script is:inline>
			const dataLayer = window['dataLayer'] || []
			window['dataLayer'] = dataLayer
			function gtag(...args) {
				dataLayer.push(args)
			}
			gtag('js', new Date())
			gtag('config', 'G-6ZQ577JL4Q')
		</script>
	</head>

	<body>
		<div class='im-page'>
			<Header locale={locale} active={active} />
			<main class='im-main'>
				<slot />
			</main>
			<Footer locale={locale} otherLocale={otherLocale} altPath={resolvedAltPath} active={active} />
		</div>
	</body>
</html>
